{
  "name": "guidanceconnect",
  "version": "1.0.0",
  "description": "GuidanceConnect - MinSU Bongabong Campus Good Moral Certificate Online Application System",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env index.js",
    "predev": "node -e \"const{execSync}=require('child_process');try{const p=execSync('netstat -ano | findstr :3000 | findstr LISTENING').toString().trim().split(/\\s+/).pop();if(p)execSync(`taskkill /PID ${p} /F`,{stdio:'ignore'})}catch(e){}\"",
    "dev": "nodemon --env-file=.env index.js",
    "seed": "node --env-file=.env seeders/createStaffAccounts.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.3.1",
    "express": "^4.19.2",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.17.3",
    "hbs": "^4.2.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
