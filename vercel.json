{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "models/**",
          "controllers/**",
          "routes/**",
          "middleware/**",
          "config/**",
          "utils/**",
          "public/**",
          "views/**",
          ".env.example"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/public/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}