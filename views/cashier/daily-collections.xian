{{> head}}
<div class="flex h-screen overflow-hidden">
  {{> sidebar-cashier activePage="collections"}}
  <div class="flex-1 overflow-y-auto bg-slate-100">
    <div class="nav-top">
      <h1 class="text-base font-bold text-slate-800">💰 Daily Collections</h1>
      <div class="flex gap-2">
        <button onclick="window.print()" class="btn-outline btn-sm">🖨 Print</button>
        <span class="text-teal-700 text-sm font-medium">{{user.firstName}} {{user.lastName}}</span>
      </div>
    </div>
    <div class="px-5 py-5">
      {{> flash}}

      <div class="card mb-5" style="background:#0a1f0a;border-color:#166534">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-slate-500 text-sm">Collections for</p>
            <p class="text-slate-800 font-bold text-xl">{{formatDate date}}</p>
          </div>
          <div class="text-right">
            <p class="text-slate-500 text-sm">Total Collected</p>
            <p class="text-green-700 font-bold text-3xl">{{currency total}}</p>
          </div>
        </div>
      </div>

      {{#if payments.length}}
      <div class="card p-0 overflow-hidden">
        <table>
          <thead><tr><th>#</th><th>Student</th><th>Method</th><th>OR No.</th><th>Amount</th></tr></thead>
          <tbody>
            {{#each payments}}
            <tr>
              <td class="text-gray-500 text-xs">{{this.id}}</td>
              <td><div class="text-slate-700 text-sm">{{this.surname}}, {{this.givenName}}</div></td>
              <td><span class="badge badge-submitted text-xs">{{this.paymentMethod}}</span></td>
              <td class="text-slate-600 text-xs font-mono">{{this.orNumber}}</td>
              <td class="text-green-700 font-bold">{{currency this.totalAmount}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="card text-center py-12">
        <p class="text-gray-500">No collections today.</p>
      </div>
      {{/if}}
    </div>
  </div>
</div>
<style>@media print { aside, .nav-top, button { display:none !important; } body { background:#fff; color:#000; } td,th { color:#000; } }</style>
</body></html>
