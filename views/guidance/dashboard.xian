{{> head}}

<div class="app-main">

  {{> sidebar-guidance activePage="home"}}

  <div class="w-full min-h-screen overflow-y-auto bg-slate-100">

    <div class="nav-top" style="margin-left: 50px;">
      <div>
        <h1 class="text-base font-bold text-slate-800">UniGuide Home</h1>
        <p class="text-slate-500 text-xs">MinSU Bongabong Campus — Guidance Office</p>
      </div>
      <span class="text-teal-700 text-sm font-medium">👤 {{user.firstName}} {{user.lastName}}</span>
    </div>

    <div class="px-5 py-5">

      {{> flash}}

      <!-- Stat Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3 mb-6">

        <a href="/guidance/applications?status=payment_verified" class="card flex items-center gap-3 hover:shadow-lg transition-shadow">
          <div class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center shrink-0">💰</div>
          <div>
            <p class="text-xl font-bold text-blue-600">{{verifiedCount}}</p>
            <p class="text-gray-500 text-xs">Payment Verified</p>
          </div>
        </a>

        <a href="/guidance/applications?status=receipt_issued" class="card flex items-center gap-3 hover:shadow-lg transition-shadow">
          <div class="w-10 h-10 rounded-xl bg-purple-100 flex items-center justify-center shrink-0">📑</div>
          <div>
            <p class="text-xl font-bold text-purple-600">{{readyCount}}</p>
            <p class="text-gray-500 text-xs">Ready to Process</p>
          </div>
        </a>

        <a href="/guidance/applications?status=released" class="card flex items-center gap-3 hover:shadow-lg transition-shadow">
          <div class="w-10 h-10 rounded-xl bg-green-100 flex items-center justify-center shrink-0">🎓</div>
          <div>
            <p class="text-xl font-bold text-green-700">{{releasedCount}}</p>
            <p class="text-gray-500 text-xs">Released</p>
          </div>
        </a>

        <a href="/guidance/applications" class="card flex items-center gap-3 hover:shadow-lg transition-shadow">
          <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center shrink-0">📊</div>
          <div>
            <p class="text-xl font-bold text-slate-800">{{totalApps}}</p>
            <p class="text-gray-500 text-xs">Total Requests</p>
          </div>
        </a>

      </div>

      <!-- Quick Links -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

        <a href="/guidance/applications" class="card flex items-center gap-4 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-teal-100 flex items-center justify-center text-2xl shrink-0">📋</div>
          <div>
            <p class="font-semibold text-slate-800">Applications</p>
            <p class="text-gray-500 text-xs">View and process all requests</p>
          </div>
        </a>

        <a href="/guidance/appointments" class="card flex items-center gap-4 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center text-2xl shrink-0">📅</div>
          <div>
            <p class="font-semibold text-slate-800">Appointments</p>
            <p class="text-gray-500 text-xs">Manage counseling schedules</p>
          </div>
        </a>

        <a href="/guidance/announcements/new" class="card flex items-center gap-4 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center text-2xl shrink-0">📣</div>
          <div>
            <p class="font-semibold text-slate-800">Announcements</p>
            <p class="text-gray-500 text-xs">Post announcements to students</p>
          </div>
        </a>

        <a href="/guidance/profiling" class="card flex items-center gap-4 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-2xl shrink-0">👥</div>
          <div>
            <p class="font-semibold text-slate-800">Student Profiles</p>
            <p class="text-gray-500 text-xs">View and update student records</p>
          </div>
        </a>

        <a href="/guidance/reports" class="card flex items-center gap-4 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-yellow-100 flex items-center justify-center text-2xl shrink-0">📈</div>
          <div>
            <p class="font-semibold text-slate-800">Reports</p>
            <p class="text-gray-500 text-xs">Monthly and yearly statistics</p>
          </div>
        </a>

        <a href="/guidance/notifications" class="card flex items-center gap-4 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-orange-100 flex items-center justify-center text-2xl shrink-0">🔔</div>
          <div>
            <p class="font-semibold text-slate-800">Notifications</p>
            <p class="text-gray-500 text-xs">{{#if (gt unreadNotifCount 0)}}{{unreadNotifCount}} unread{{else}}All caught up{{/if}}</p>
          </div>
        </a>

      </div>

    </div>
  </div>
</div>

{{> pwa-install-banner}}
</body>
</html>
