{{> head}}

<div class="app-main">

  {{> sidebar-guidance activePage="home"}}

  <div class="w-full min-h-screen overflow-y-auto bg-slate-100">

    <div class="nav-top" style="margin-left: 50px;">
      <div>
        <h1 class="text-base font-bold text-slate-800">UniGuide Home</h1>
        <p class="text-slate-500 text-xs">MinSU Bongabong Campus — Guidance Office</p>
      </div>
      <span class="text-teal-700 text-sm font-medium">👤 {{user.firstName}} {{user.lastName}}</span>
    </div>

    <div class="px-5 py-5">

      {{> flash}}

      <!-- Welcome Banner -->
      <div class="card flex items-center gap-5" style="background:linear-gradient(135deg,#0c1f0e,#1b5e38);border-color:#166534;">
        <div class="w-16 h-16 rounded-full bg-green-800 flex items-center justify-center text-3xl shrink-0">🎓</div>
        <div>
          <h2 class="text-white font-bold text-xl">Welcome, {{user.firstName}}!</h2>
          <p class="text-green-300 text-sm mt-1">Guidance Office — MinSU Bongabong Campus</p>
          <p class="text-green-400 text-xs mt-1">Use the sidebar to navigate Applications, Appointments, Reports, and more.</p>
        </div>
      </div>

      <!-- Summary Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-5">

        <div class="card flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center shrink-0">💰</div>
          <div>
            <p class="text-xl font-bold text-blue-600">{{verifiedCount}}</p>
            <p class="text-gray-500 text-xs">Payment Verified</p>
          </div>
        </div>

        <div class="card flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-purple-100 flex items-center justify-center shrink-0">📑</div>
          <div>
            <p class="text-xl font-bold text-purple-600">{{readyCount}}</p>
            <p class="text-gray-500 text-xs">Ready to Process</p>
          </div>
        </div>

        <div class="card flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-green-100 flex items-center justify-center shrink-0">🎓</div>
          <div>
            <p class="text-xl font-bold text-green-700">{{releasedCount}}</p>
            <p class="text-gray-500 text-xs">Released</p>
          </div>
        </div>

        <div class="card flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center shrink-0">📊</div>
          <div>
            <p class="text-xl font-bold text-slate-800">{{totalApps}}</p>
            <p class="text-gray-500 text-xs">Total Requests</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>

{{> pwa-install-banner}}
</body>
</html>
