{{> head}}
<div class="flex h-screen overflow-hidden">
  {{> sidebar-guidance activePage="users"}}
  <div class="flex-1 overflow-y-auto bg-slate-100">
    <div class="nav-top">
      <h1 class="text-base font-bold text-slate-800">👥 Manage Users</h1>
      <span class="text-teal-700 text-sm font-medium">{{user.firstName}} {{user.lastName}}</span>
    </div>
    <div class="px-5 py-5">
      {{> flash}}
      <div class="grid grid-cols-5 gap-5">
        <!-- User List -->
        <div class="col-span-3">
          <h2 class="text-sm font-semibold text-green-700 mb-3">All Accounts ({{users.length}})</h2>
          <div class="card p-0 overflow-hidden">
            <table>
              <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Student ID</th><th>Joined</th></tr></thead>
              <tbody>
                {{#each users}}
                <tr>
                  <td class="text-slate-800 text-sm font-medium">{{this.firstName}} {{this.lastName}}</td>
                  <td class="text-slate-500 text-xs">{{this.email}}</td>
                  <td>
                    <span class="badge text-xs
                      {{#if (eq this.role 'guidance')}}badge-approved
                      {{else if (eq this.role 'cashier')}}badge-receipted
                      {{else}}badge-verified{{/if}}">
                      {{this.role}}
                    </span>
                  </td>
                  <td class="text-gray-500 text-xs">{{this.studentId}}</td>
                  <td class="text-gray-600 text-xs">{{formatDate this.createdAt}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
        <!-- Create Account -->
        <div class="col-span-2">
          <h2 class="text-sm font-semibold text-green-700 mb-3">Create Staff Account</h2>
          <form action="/guidance/users" method="POST" class="card space-y-4">
            <div>
              <label class="label">First Name *</label>
              <input type="text" name="firstName" class="input" required>
            </div>
            <div>
              <label class="label">Last Name *</label>
              <input type="text" name="lastName" class="input" required>
            </div>
            <div>
              <label class="label">Email *</label>
              <input type="email" name="email" class="input" placeholder="staff@minsu.edu.ph" required>
            </div>
            <div>
              <label class="label">Role *</label>
              <select name="role" class="input" required>
                <option value="cashier">Cashier</option>
                <option value="guidance">Guidance Administrator</option>
              </select>
            </div>
            <div>
              <label class="label">Password *</label>
              <input type="password" name="password" class="input" placeholder="Min. 8 characters" required minlength="8">
            </div>
            <button type="submit" class="btn-green w-full py-2.5">➕ Create Account</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
</body></html>
