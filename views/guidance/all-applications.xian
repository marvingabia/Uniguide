{{> head}}

<div class="app-shell">

  {{> sidebar-guidance activePage="applications"}}

  <main class="main-content">

    <!-- Top Navigation -->
    <div class="nav-top" id="guidance-top-nav">
      <div class="nav-title">
        <h1 class="text-base font-bold text-slate-800">
          📋 All Student Request Form
        </h1>
      </div>

      <span class="text-teal-700 text-sm font-medium">
        {{user.firstName}} {{user.lastName}}
      </span>
    </div>

    <div class="page-content">

      {{> flash}}

      <!-- Filters -->
      <form
        method="GET"
        action="/guidance/applications"
        class="application-filters"
      >

        <input
          type="text"
          name="search"
          value="{{search}}"
          placeholder="Search student name or course..."
          class="input filter-search"
        >

        <select
          name="status"
          class="input filter-status"
        >
          <option value="">
            All Statuses
          </option>

          <option
            value="pending"
            {{#if (eq filterStatus 'pending')}}selected{{/if}}
          >
            Pending
          </option>

          <option
            value="payment_submitted"
            {{#if (eq filterStatus 'payment_submitted')}}selected{{/if}}
          >
            Payment Submitted
          </option>

          <option
            value="payment_verified"
            {{#if (eq filterStatus 'payment_verified')}}selected{{/if}}
          >
            Payment Verified
          </option>

          <option
            value="receipt_issued"
            {{#if (eq filterStatus 'receipt_issued')}}selected{{/if}}
          >
            Receipt Issued
          </option>

          <option
            value="approved"
            {{#if (eq filterStatus 'approved')}}selected{{/if}}
          >
            Approved
          </option>

          <option
            value="released"
            {{#if (eq filterStatus 'released')}}selected{{/if}}
          >
            Released
          </option>

          <option
            value="rejected"
            {{#if (eq filterStatus 'rejected')}}selected{{/if}}
          >
            Rejected
          </option>
        </select>

        <button
          type="submit"
          class="btn-green btn-sm filter-button"
        >
          Filter
        </button>

        <a
          href="/guidance/applications"
          class="btn-outline btn-sm clear-button"
        >
          Clear
        </a>

      </form>


      {{#if applications.length}}

        <!-- TABLE CARD -->
        <div class="card applications-card">

          <!--
            IMPORTANT:
            Horizontal scrolling is intentional on small screens.
            The table will NEVER squeeze all columns into a tiny phone.
          -->
          <div class="applications-table-scroll">

            <table class="applications-table">

              <thead>
                <tr>
                  <th>#</th>
                  <th>Student</th>
                  <th>Course</th>
                  <th>Documents</th>
                  <th>Amount</th>
                  <th>Status</th>
                  <th>Submitted</th>
                  <th>Action</th>
                </tr>
              </thead>

              <tbody>

                {{#each applications}}

                  <tr>

                    <!-- ID -->
                    <td class="text-gray-500 text-xs">
                      {{this.id}}
                    </td>

                    <!-- STUDENT -->
                    <td>

                      <div class="student-name">
                        {{this.surname}}, {{this.givenName}}
                      </div>

                      <div class="student-email">
                        {{this.student.email}}
                      </div>

                    </td>

                    <!-- COURSE -->
                    <td class="course-cell">
                      {{this.course}}
                    </td>

                    <!-- DOCUMENTS -->
                    <td class="documents-cell">

                      <div class="document-list">

                        {{#if (gt this.qtyGoodMoral 0)}}
                          <div>
                            Good Moral:
                            {{this.qtyGoodMoral}}
                            copies
                          </div>
                        {{/if}}

                        {{#if (gt this.qtyCTC 0)}}
                          <div>
                            CTC/Auth:
                            {{this.qtyCTC}}
                            copies
                          </div>
                        {{/if}}

                      </div>

                    </td>

                    <!-- AMOUNT -->
                    <td class="amount-cell">

                      {{#if this.totalAmount}}
                        {{currency this.totalAmount}}
                      {{else}}
                        —
                      {{/if}}

                    </td>

                    <!-- STATUS -->
                    <td>

                      <span class="badge {{statusClass this.status}}">
                        {{statusLabel this.status}}
                      </span>

                    </td>

                    <!-- DATE -->
                    <td class="date-cell">
                      {{formatDate this.createdAt}}
                    </td>

                    <!-- ACTION -->
                    <td>

                      <a
                        href="/guidance/application/{{this.id}}"
                        class="view-link"
                      >
                        View →
                      </a>

                    </td>

                  </tr>

                {{/each}}

              </tbody>

            </table>

          </div>

          <!-- Mobile scroll hint -->
          <div class="mobile-scroll-hint">
            ← Swipe left/right to view the table →
          </div>

        </div>

      {{else}}

        <!-- EMPTY STATE -->
        <div class="card empty-applications">

          <div class="empty-icon">
            📋
          </div>

          <p class="text-gray-500">
            No applications found.
          </p>

        </div>

      {{/if}}

    </div>

  </main>

</div>

<script>
(function () {

  const nav = document.getElementById('guidance-top-nav');

  if (!nav) return;

  let lastScrollTop = 0;
  let ticking = false;

  function handleScroll() {

    const currentScroll =
      window.pageYOffset ||
      document.documentElement.scrollTop;

    /*
     * Always show when near the top.
     */
    if (currentScroll <= 20) {
      nav.classList.remove('nav-hidden');
      lastScrollTop = currentScroll;
      ticking = false;
      return;
    }

    /*
     * Scrolling DOWN:
     * hide the top navigation.
     */
    if (currentScroll > lastScrollTop) {
      nav.classList.add('nav-hidden');
    }

    /*
     * Scrolling UP:
     * show the top navigation again.
     */
    else if (currentScroll < lastScrollTop) {
      nav.classList.remove('nav-hidden');
    }

    lastScrollTop = currentScroll <= 0
      ? 0
      : currentScroll;

    ticking = false;
  }

  window.addEventListener(
    'scroll',
    function () {

      if (!ticking) {

        window.requestAnimationFrame(
          handleScroll
        );

        ticking = true;
      }

    },
    {
      passive: true
    }
  );

})();
</script>

</body>
</html>