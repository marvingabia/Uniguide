{{> head}}
<div class="flex h-screen overflow-hidden">
  {{> sidebar-guidance activePage="profiling"}}

  <div class="flex-1 overflow-y-auto bg-slate-100">
    <div class="nav-top">
      <div>
        <h1 class="text-base font-bold text-slate-800">👥 Student Profiling</h1>
        <p class="text-slate-500 text-xs">MinSU Bongabong Campus — Guidance Office</p>
      </div>
      <span class="text-teal-700 text-sm font-medium">👤 {{user.firstName}} {{user.lastName}}</span>
    </div>

    <div class="px-5 py-5">
      {{> flash}}

      <!-- Filters -->
      <div class="card mb-5">
        <form method="GET" action="/guidance/profiling" class="flex gap-3 items-end">
          <div class="flex-1">
            <label class="block text-xs font-medium text-gray-700 mb-1">Search Student</label>
            <input type="text" name="search" value="{{searchQuery}}" placeholder="Name, Student ID, or Course" class="input">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Case Type</label>
            <select name="caseType" class="input">
              <option value="">All Cases</option>
              <option value="academic" {{#if (eq filterCase 'academic')}}selected{{/if}}>Academic</option>
              <option value="behavioral" {{#if (eq filterCase 'behavioral')}}selected{{/if}}>Behavioral</option>
              <option value="personal" {{#if (eq filterCase 'personal')}}selected{{/if}}>Personal</option>
              <option value="family" {{#if (eq filterCase 'family')}}selected{{/if}}>Family</option>
              <option value="health" {{#if (eq filterCase 'health')}}selected{{/if}}>Health</option>
              <option value="other" {{#if (eq filterCase 'other')}}selected{{/if}}>Other</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Risk Level</label>
            <select name="riskLevel" class="input">
              <option value="">All Levels</option>
              <option value="low" {{#if (eq filterRisk 'low')}}selected{{/if}}>Low</option>
              <option value="moderate" {{#if (eq filterRisk 'moderate')}}selected{{/if}}>Moderate</option>
              <option value="high" {{#if (eq filterRisk 'high')}}selected{{/if}}>High</option>
            </select>
          </div>
          <button type="submit" class="btn-green">🔍 Filter</button>
          <a href="/guidance/profiling" class="btn-outline">Clear</a>
        </form>
      </div>

      <!-- Students Table -->
      <div class="card p-0 overflow-hidden">
        <table>
          <thead>
            <tr>
              <th>Student ID</th>
              <th>Name</th>
              <th>Course & Year</th>
              <th>Case Type</th>
              <th>Risk</th>
              <th>Sessions</th>
              <th>Last Session</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            {{#if students.length}}
              {{#each students}}
              <tr>
                <td class="text-gray-600 text-xs font-mono">{{this.studentId}}</td>
                <td>
                  <div class="text-slate-800 text-sm font-medium">{{this.lastName}}, {{this.firstName}}</div>
                  <div class="text-gray-500 text-xs">{{this.email}}</div>
                </td>
                <td class="text-slate-600 text-sm">{{this.course}} {{this.yearLevel}}</td>
                <td>
                  {{#if this.profile}}
                    {{#if (eq this.profile.caseType 'none')}}
                      <span class="text-xs text-gray-400">—</span>
                    {{else}}
                      <span class="text-xs px-2 py-1 rounded-full 
                        {{#if (eq this.profile.caseType 'academic')}}bg-blue-100 text-blue-700
                        {{else if (eq this.profile.caseType 'behavioral')}}bg-orange-100 text-orange-700
                        {{else if (eq this.profile.caseType 'personal')}}bg-purple-100 text-purple-700
                        {{else if (eq this.profile.caseType 'family')}}bg-pink-100 text-pink-700
                        {{else if (eq this.profile.caseType 'health')}}bg-red-100 text-red-700
                        {{else}}bg-gray-100 text-gray-700{{/if}}">
                        {{this.profile.caseType}}
                      </span>
                    {{/if}}
                  {{else}}
                    <span class="text-xs text-gray-400">—</span>
                  {{/if}}
                </td>
                <td>
                  {{#if this.profile}}
                    <span class="text-xs font-semibold
                      {{#if (eq this.profile.riskLevel 'low')}}text-green-600
                      {{else if (eq this.profile.riskLevel 'moderate')}}text-yellow-600
                      {{else}}text-red-600{{/if}}">
                      {{this.profile.riskLevel}}
                    </span>
                  {{else}}
                    <span class="text-xs text-gray-400">—</span>
                  {{/if}}
                </td>
                <td class="text-gray-600 text-sm">
                  {{#if this.profile}}{{this.profile.totalSessions}}{{else}}0{{/if}}
                </td>
                <td class="text-gray-500 text-xs">
                  {{#if this.profile.lastSessionDate}}{{formatDate this.profile.lastSessionDate}}{{else}}—{{/if}}
                </td>
                <td>
                  <a href="/guidance/profiling/student/{{this.id}}" class="btn-green btn-sm">View Profile</a>
                </td>
              </tr>
              {{/each}}
            {{else}}
              <tr><td colspan="8" class="text-center text-gray-500 py-8">No students found</td></tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
</body></html>
