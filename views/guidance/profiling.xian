{{> head}}

<div class="flex h-screen overflow-hidden">

  {{> sidebar-guidance activePage="profiling"}}


  <div class="flex-1 overflow-y-auto bg-slate-100">

    <div class="nav-top" style="margin-left: 50px;">

      <div>

        <h1 class="text-base font-bold text-slate-800">
          👥 Student Profiling — Uniguide
        </h1>

        <p class="text-slate-500 text-xs">
          MinSU Bongabong Campus — Guidance Office
        </p>

      </div>


      <span class="text-teal-700 text-sm font-medium">
        👤 {{user.firstName}} {{user.lastName}}
      </span>

    </div>


    <div class="px-5 py-5">

      {{> flash}}


      <!-- Filters -->

      <div class="card mb-5">

        <form
          method="GET"
          action="/guidance/profiling"
          class="grid grid-cols-1 md:grid-cols-4 gap-3 items-end"
        >

          <div class="md:col-span-2">

            <label
              class="block text-xs font-medium text-gray-700 mb-1"
            >
              Search Student
            </label>

            <input
              type="text"
              name="search"
              value="{{searchQuery}}"
              placeholder="Name, Student ID, or Course"
              class="input"
            >

          </div>


          <div>

            <label
              class="block text-xs font-medium text-gray-700 mb-1"
            >
              Application Status
            </label>

            <select
              name="status"
              class="input"
            >

              <option value="">
                All Statuses
              </option>

              <option
                value="pending"
                {{#if (eq filterStatus 'pending')}}selected{{/if}}
              >
                Pending
              </option>

              <option
                value="payment_submitted"
                {{#if (eq filterStatus 'payment_submitted')}}selected{{/if}}
              >
                Payment Submitted
              </option>

              <option
                value="payment_verified"
                {{#if (eq filterStatus 'payment_verified')}}selected{{/if}}
              >
                Payment Verified
              </option>

              <option
                value="receipt_issued"
                {{#if (eq filterStatus 'receipt_issued')}}selected{{/if}}
              >
                Receipt Issued
              </option>

              <option
                value="approved"
                {{#if (eq filterStatus 'approved')}}selected{{/if}}
              >
                Approved
              </option>

              <option
                value="released"
                {{#if (eq filterStatus 'released')}}selected{{/if}}
              >
                Released
              </option>

            </select>

          </div>


          <div class="flex gap-2">

            <button
              type="submit"
              class="btn-green"
            >
              🔍 Filter
            </button>

            <a
              href="/guidance/profiling"
              class="btn-outline"
            >
              Clear
            </a>

          </div>

        </form>

      </div>


      <!-- Students Table -->

      <div class="card p-0 overflow-x-auto">

        <table>

          <thead>

            <tr>

              <th>Student ID</th>
              <th>Name</th>
              <th>Course & Year</th>
              <th>Status</th>
              <th>Contact</th>
              <th>Action</th>

            </tr>

          </thead>


          <tbody>

            {{#if students.length}}

              {{#each students}}

                <tr>

                  <td class="text-gray-600 text-xs font-mono">
                    {{this.studentId}}
                  </td>


                  <td>

                    <div class="text-slate-800 text-sm font-medium">
                      {{this.lastName}}, {{this.firstName}}
                    </div>

                    <div class="text-gray-500 text-xs">
                      {{this.email}}
                    </div>

                  </td>


                  <td class="text-slate-600 text-sm">
                    {{this.course}} {{this.yearLevel}}
                  </td>

                  <td>
                    <span class="text-xs px-2 py-1 rounded-full
                      {{#if (eq this.status 'pending')}}
                        bg-yellow-100 text-yellow-700
                      {{else if (eq this.status 'payment_submitted')}}
                        bg-blue-100 text-blue-700
                      {{else if (eq this.status 'payment_verified')}}
                        bg-green-100 text-green-700
                      {{else if (eq this.status 'receipt_issued')}}
                        bg-green-100 text-green-700
                      {{else if (eq this.status 'approved')}}
                        bg-emerald-100 text-emerald-700
                      {{else if (eq this.status 'released')}}
                        bg-purple-100 text-purple-700
                      {{else}}
                        bg-gray-100 text-gray-700
                      {{/if}}">
                      {{this.status}}
                    </span>
                  </td>

                  <td class="text-gray-600 text-xs">
                    {{this.contactNo}}
                  </td>

                  <td>

                    <a
                      href="/guidance/profiling/student/{{this.id}}"
                      class="btn-green btn-sm"
                    >
                      View Profile
                    </a>

                  </td>

                </tr>

              {{/each}}

            {{else}}

              <tr>

                <td
                  colspan="6"
                  class="text-center text-gray-500 py-8"
                >
                  No students found
                </td>

              </tr>

            {{/if}}

          </tbody>

        </table>

      </div>

    </div>

  </div>

</div>

</body>
</html>