<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{material.title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .pdf-viewer {
      width: 100%;
      height: calc(100vh - 120px);
      border: none;
      pointer-events: auto;
    }
    /* Disable right-click on PDF viewer */
    iframe {
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
    }
    .library-sidebar {
      width: 300px;
      height: calc(100vh - 60px);
      overflow-y: auto;
      transition: transform 0.3s ease;
    }
    .library-sidebar.hidden-sidebar {
      transform: translateX(-100%);
    }
    .main-content {
      transition: margin-left 0.3s ease;
    }
    .main-content.expanded {
      margin-left: 0;
    }
    .book-item {
      transition: all 0.2s ease;
    }
    .book-item:hover {
      transform: translateX(5px);
      background-color: #f3f4f6;
    }
    .book-item.active {
      background-color: #dbeafe;
      border-left: 4px solid #3b82f6;
    }
  </style>
</head>
<body class="bg-gray-100 min-h-screen">
  <!-- Top Navigation -->
  <nav class="bg-white shadow-md p-4 border-b border-gray-200 fixed top-0 left-0 right-0 z-50">
    <div class="flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <button onclick="toggleLibrary()" class="text-gray-600 hover:text-gray-800 flex items-center space-x-2 px-3 py-2 rounded-lg hover:bg-gray-100">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <span>Library</span>
        </button>
        <a href="/reading" class="text-gray-600 hover:text-gray-800 flex items-center space-x-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Back to Materials</span>
        </a>
      </div>
      <div class="flex items-center space-x-4">
        <span class="text-sm text-gray-500">📖 Reading Mode</span>
      </div>
    </div>
  </nav>

  <div class="flex pt-16">
    <!-- Library Sidebar -->
    <div id="librarySidebar" class="library-sidebar bg-white shadow-lg border-r border-gray-200 fixed left-0 z-40">
      <div class="p-4 border-b border-gray-200 bg-gradient-to-r from-purple-500 to-blue-500">
        <h2 class="text-xl font-bold text-white flex items-center">
          <span class="text-2xl mr-2">📚</span>
          Library
        </h2>
        <p class="text-sm text-white opacity-90 mt-1">Choose a book to read</p>
      </div>
      
      <div class="p-4">
        <div id="libraryBooks" class="space-y-2">
          <!-- Books will be loaded here -->
          <div class="text-center py-8 text-gray-500">
            <div class="text-4xl mb-2">📖</div>
            <p class="text-sm">Loading library...</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div id="mainContent" class="main-content flex-1" style="margin-left: 300px;">
      <!-- Material Info -->
      <div class="bg-white border-b border-gray-200 p-4">
        <div class="container mx-auto">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <h1 class="text-2xl font-bold text-gray-900 mb-2">{{material.title}}</h1>
              <div class="flex items-center gap-4 text-sm text-gray-600">
                <span class="bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full font-semibold">{{material.category}}</span>
                <span>⏱️ {{material.readingTime}} min read</span>
                <span>👁️ {{material.views}} views</span>
                {{#if material.counselor}}
                <span>👨‍💼 By {{material.counselor.name}}</span>
                {{/if}}
              </div>
              {{#if material.excerpt}}
              <p class="text-gray-600 mt-2">{{material.excerpt}}</p>
              {{/if}}
            </div>
            <div class="ml-4">
              {{#if (eq material.fileType 'pdf')}}
              <span class="text-5xl">📕</span>
              {{else}}
              <span class="text-5xl">📘</span>
              {{/if}}
            </div>
          </div>
        </div>
      </div>

      <!-- PDF/Document Viewer -->
      <div class="container mx-auto p-4">
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
          {{#if (eq material.fileType 'pdf')}}
          <!-- PDF Viewer - Use route that sets inline headers -->
          <iframe 
            src="/reading/file/{{material.id}}#toolbar=0&navpanes=0&scrollbar=1" 
            class="pdf-viewer"
            oncontextmenu="return false;"
            type="application/pdf">
            <p class="p-8 text-center">
              <span class="text-4xl mb-4 block">📕</span>
              <span class="text-gray-600">Your browser doesn't support PDF viewing.</span><br>
              <span class="text-sm text-gray-500 mt-2 block">Please try using Chrome, Firefox, or Edge browser.</span>
            </p>
          </iframe>
          {{else}}
          <!-- Document Viewer (for DOC/DOCX) using Microsoft Office Online Viewer -->
          <div class="bg-gray-50 p-4 text-center border-b">
            <p class="text-sm text-gray-600">📘 Loading document...</p>
            <p class="text-xs text-gray-500 mt-1">Please wait while the document loads (this may take a few seconds)</p>
          </div>
          <iframe 
            id="docViewer"
            src="" 
            class="pdf-viewer"
            frameborder="0">
            <div class="p-8 text-center">
              <div class="text-6xl mb-4">📘</div>
              <h3 class="text-xl font-bold text-gray-800 mb-2">{{material.fileName}}</h3>
              <p class="text-gray-600 mb-6">Unable to display document in your browser.</p>
              <p class="text-sm text-gray-500">Please try refreshing the page or use a different browser.</p>
            </div>
          </iframe>
          <script>
            // Use Microsoft Office Online Viewer (no download, pure viewing)
            const docViewer = document.getElementById('docViewer');
            const fileUrl = encodeURIComponent(window.location.origin + '/reading/file/{{material.id}}');
            
            // Microsoft Office Online Viewer - READ ONLY, NO DOWNLOAD
            docViewer.src = `https://view.officeapps.live.com/op/embed.aspx?src=${fileUrl}`;
            console.log('Loading document with Office Online Viewer:', fileUrl);
            
            docViewer.addEventListener('load', function() {
              console.log('Document loaded successfully - READ ONLY MODE');
            });
          </script>
          {{/if}}
        </div>
      </div>
    </div>
  </div>

  <!-- Script for handling viewer and library -->
  <script>
    const currentMaterialId = {{material.id}};
    let libraryOpen = true;

    // Disable right-click and keyboard shortcuts for download
    document.addEventListener('contextmenu', function(e) {
      e.preventDefault();
      return false;
    });

    // Disable Ctrl+S (Save) and Ctrl+P (Print)
    document.addEventListener('keydown', function(e) {
      if ((e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'p')) {
        e.preventDefault();
        alert('⚠️ Downloading and printing are disabled. This material is for reading only.');
        return false;
      }
    });

    // Track reading session
    let readingStartTime = Date.now();
    let readingDuration = 0;
    
    // Update reading duration every 30 seconds
    setInterval(() => {
      readingDuration = Math.floor((Date.now() - readingStartTime) / 1000);
      if (readingDuration % 30 === 0 && readingDuration > 0) {
        trackReadingActivity();
      }
    }, 30000);

    // Track when user leaves the page
    window.addEventListener('beforeunload', function() {
      trackReadingActivity();
    });

    async function trackReadingActivity() {
      try {
        const duration = Math.floor((Date.now() - readingStartTime) / 1000);
        await fetch('/api/reading/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            materialId: currentMaterialId,
            duration: duration
          })
        });
        console.log('📊 Reading activity tracked:', duration, 'seconds');
      } catch (error) {
        console.error('Failed to track reading:', error);
      }
    }

    // Toggle library sidebar
    function toggleLibrary() {
      libraryOpen = !libraryOpen;
      const sidebar = document.getElementById('librarySidebar');
      const mainContent = document.getElementById('mainContent');
      
      if (libraryOpen) {
        sidebar.classList.remove('hidden-sidebar');
        mainContent.classList.remove('expanded');
        mainContent.style.marginLeft = '300px';
      } else {
        sidebar.classList.add('hidden-sidebar');
        mainContent.classList.add('expanded');
        mainContent.style.marginLeft = '0';
      }
    }

    // Load library books
    async function loadLibrary() {
      try {
        const response = await fetch('/api/reading/materials');
        const materials = await response.json();
        
        const libraryBooks = document.getElementById('libraryBooks');
        
        if (materials.length === 0) {
          libraryBooks.innerHTML = `
            <div class="text-center py-8 text-gray-500">
              <div class="text-4xl mb-2">📚</div>
              <p class="text-sm">No materials available</p>
            </div>
          `;
          return;
        }
        
        libraryBooks.innerHTML = materials.map(material => `
          <a href="/reading/view/${material.id}" 
             class="book-item block p-3 rounded-lg border border-gray-200 ${material.id === currentMaterialId ? 'active' : ''}"
             title="${material.title}">
            <div class="flex items-start space-x-3">
              <div class="text-2xl flex-shrink-0">
                ${material.fileType === 'pdf' ? '📕' : '📘'}
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-sm text-gray-900 truncate">${material.title}</h3>
                <p class="text-xs text-gray-500 mt-1">${material.category}</p>
                <div class="flex items-center gap-2 mt-1 text-xs text-gray-400">
                  <span>⏱️ ${material.readingTime}min</span>
                  <span>👁️ ${material.views}</span>
                </div>
              </div>
            </div>
          </a>
        `).join('');
        
        console.log('Library loaded:', materials.length, 'materials');
      } catch (error) {
        console.error('Failed to load library:', error);
        document.getElementById('libraryBooks').innerHTML = `
          <div class="text-center py-8 text-gray-500">
            <div class="text-4xl mb-2">⚠️</div>
            <p class="text-sm">Failed to load library</p>
          </div>
        `;
      }
    }

    // Load library on page load
    loadLibrary();

    // Check if PDF loaded successfully
    const iframe = document.querySelector('iframe');
    if (iframe && iframe.src.includes('/reading/file/')) {
      iframe.onerror = function() {
        console.log('PDF failed to load, trying Office Online Viewer...');
        const fileUrl = encodeURIComponent(window.location.origin + '/reading/file/{{material.id}}');
        iframe.src = `https://view.officeapps.live.com/op/embed.aspx?src=${fileUrl}`;
      };
    }
  </script>
</body>
</html>
