{{#each success}}
<div class="mb-4 px-4 py-3 bg-green-100 border border-green-600 text-green-800 font-semibold rounded-lg text-sm">
  ✅ {{this}}
</div>
{{/each}}
{{#each error}}
<div class="mb-4 px-4 py-3 bg-red-100 border border-red-400 text-red-800 rounded-lg text-sm">
  ❌ {{this}}
</div>
{{/each}}
