<style>
  /* =========================================================
     STUDENT SIDEBAR
     ========================================================= */

  .student-sidebar {
    width: 240px;
    background: linear-gradient(
      180deg,
      #1b5e38 0%,
      #154d2f 100%
    );
    flex-shrink: 0;
    height: 100vh;
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    padding: 0;
    transition:
      width .25s ease,
      transform .25s ease;
    z-index: 1000;
  }


  /* Toggle button */

  .student-sidebar-toggle {
    position: fixed;
    left: 0;
    top: 14px;

    width: 28px;
    height: 36px;

    border: none;
    border-radius: 0 8px 8px 0;

    background: #15803d;
    color: white;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 18px;
    font-weight: bold;

    cursor: pointer;

    z-index: 1100;

    box-shadow: 0 3px 10px rgba(0,0,0,.20);

    transition:
      left .25s ease,
      background .2s ease;
  }


  .student-sidebar-toggle:hover {
    background: #166534;
  }


  /* When sidebar is open */

  body.student-sidebar-open
  .student-sidebar-toggle {
    left: 240px;
  }


  /* Sidebar links */

  .student-sidebar .sidebar-link {
    display: flex;
    align-items: center;

    width: 100%;

    box-sizing: border-box;

    padding: 10px 12px;
    margin-bottom: 3px;

    border-radius: 8px;

    color: #d1fae5;

    text-decoration: none;

    font-size: .82rem;

    transition:
      background .15s ease,
      color .15s ease;
  }


  .student-sidebar .sidebar-link:hover {
    background: rgba(255,255,255,.10);
    color: white;
  }


  .student-sidebar .sidebar-link.active {
    background: white;
    color: #14532d;
    font-weight: 700;
  }


  /* =========================================================
     MOBILE
     ========================================================= */

  @media (max-width: 767px) {

    .student-sidebar {
      position: fixed;

      left: 0;
      top: 0;

      width: 240px;

      transform: translateX(-100%);

      box-shadow:
        8px 0 25px rgba(0,0,0,.25);
    }


    body.student-sidebar-open
    .student-sidebar {
      transform: translateX(0);
    }


    body.student-sidebar-open
    .student-sidebar-toggle {
      left: 240px;
    }


    .student-sidebar-toggle {
      top: 12px;
      left: 0;
      width: 30px;
      height: 38px;
    }


    /* Dark overlay */

    .student-sidebar-overlay {
      display: none;

      position: fixed;

      inset: 0;

      background: rgba(0,0,0,.35);

      z-index: 900;
    }


    body.student-sidebar-open
    .student-sidebar-overlay {
      display: block;
    }

  }


  /* =========================================================
     DESKTOP
     ========================================================= */

  @media (min-width: 768px) {

    .student-sidebar {
      transform: translateX(-100%);
      position: fixed;
      left: 0;
      top: 0;
    }


    body.student-sidebar-open
    .student-sidebar {
      transform: translateX(0);
    }


    body.student-sidebar-open
    .student-sidebar-toggle {
      left: 240px;
    }

  }
</style>


<!-- =========================================================
     TOGGLE BUTTON
     ========================================================= -->

<button
  type="button"
  id="studentSidebarToggle"
  class="student-sidebar-toggle"
  aria-label="Show sidebar"
  aria-expanded="false"
  onclick="toggleStudentSidebar()">
  &gt;
</button>


<!-- Overlay -->
<div
  class="student-sidebar-overlay"
  onclick="closeStudentSidebar()">
</div>


<!-- =========================================================
     SIDEBAR
     ========================================================= -->

<aside class="student-sidebar">

  <!-- LOGO + BRANDING -->

  <div
    style="
      padding:20px 16px 16px;
      border-bottom:1px solid rgba(255,255,255,.1);
    ">

    <div
      style="
        display:flex;
        align-items:center;
        gap:12px;
      ">

      <img
        src="/uploads/minsulogo.png"
        alt="MinSU Logo"
        style="
          width:48px;
          height:48px;
          object-fit:contain;
          border-radius:50%;
          background:#fff;
          padding:3px;
          flex-shrink:0;
        ">

      <div>

        <p
          style="
            color:#fff;
            font-weight:700;
            font-size:.95rem;
            line-height:1.2;
            margin:0;
          ">
          UniGuide
        </p>

        <p
          style="
            color:#a7d4b8;
            font-size:.72rem;
            margin:2px 0 0;
          ">
          MinSU — Bongabong Campus
        </p>

      </div>

    </div>

  </div>


  <!-- =======================================================
       NAVIGATION
       ======================================================= -->

  <div
    style="
      flex:1;
      padding:12px 10px;
      overflow-y:auto;
    ">

    <a
      href="/student/home"
      class="sidebar-link {{#if (eq activePage 'home')}}active{{/if}}">
      🏠 Home
    </a>


    <a
      href="/student/apply"
      class="sidebar-link {{#if (eq activePage 'apply')}}active{{/if}}">
      📝 Request for Good Moral & CTC/Authentication
    </a>


    <a
      href="/student/history"
      class="sidebar-link {{#if (eq activePage 'history')}}active{{/if}}">
      📋 Track My Request
    </a>


    <a
      href="/student/appointments"
      class="sidebar-link {{#if (eq activePage 'appointments')}}active{{/if}}">
      📅 Request For Counselling
    </a>


    <a
      href="/student/notifications"
      class="sidebar-link {{#if (eq activePage 'notifications')}}active{{/if}}">

      🔔 Notifications

      {{#if unreadNotifCount}}

        <span
          class="badge badge-submitted"
          style="margin-left:auto;">
          {{unreadNotifCount}}
        </span>

      {{/if}}

    </a>


    <a
      href="/student/announcements"
      class="sidebar-link {{#if (eq activePage 'announcements')}}active{{/if}}">
      📢 Announcements
    </a>


    <a
      href="/student/profile"
      class="sidebar-link {{#if (eq activePage 'profile')}}active{{/if}}">
      👤 My Profile
    </a>

  </div>


  <!-- =======================================================
       USER + LOGOUT
       ======================================================= -->

  <div
    style="
      padding:14px 10px;
      border-top:1px solid rgba(255,255,255,.1);
    ">

    <a
      href="/student/profile"
      style="
        display:flex;
        align-items:center;
        gap:10px;
        padding:6px;
        border-radius:8px;
        text-decoration:none;
        margin-bottom:8px;
        transition:background .15s;
      "
      onmouseover="this.style.background='rgba(255,255,255,.08)'"
      onmouseout="this.style.background='transparent'">


      {{#if user.profileImage}}

        <img
          src="{{user.profileImage}}"
          style="
            width:36px;
            height:36px;
            border-radius:50%;
            object-fit:cover;
            border:2px solid rgba(255,255,255,.3);
            flex-shrink:0;
          "
          alt="avatar">

      {{else if user.avatar}}

        <img
          src="{{user.avatar}}"
          style="
            width:36px;
            height:36px;
            border-radius:50%;
            object-fit:cover;
            border:2px solid rgba(255,255,255,.3);
            flex-shrink:0;
          "
          alt="avatar">

      {{else}}

        <div
          style="
            width:36px;
            height:36px;
            border-radius:50%;
            background:#2d7a52;
            display:flex;
            align-items:center;
            justify-content:center;
            color:#fff;
            font-weight:700;
            font-size:.9rem;
            flex-shrink:0;
            border:2px solid rgba(255,255,255,.3);
          ">
          {{user.firstName.[0]}}
        </div>

      {{/if}}


      <div style="min-width:0;">

        <p
          style="
            color:#fff;
            font-size:.82rem;
            font-weight:600;
            margin:0;
            white-space:nowrap;
            overflow:hidden;
            text-overflow:ellipsis;
          ">
          {{user.firstName}} {{user.lastName}}
        </p>

        <p
          style="
            color:#a7d4b8;
            font-size:.7rem;
            margin:1px 0 0;
          ">
          Student · Edit profile
        </p>

      </div>

    </a>


    <form action="/logout" method="POST">

      <button
        class="sidebar-link"
        style="
          width:100%;
          text-align:left;
          border:none;
          background:transparent;
          cursor:pointer;
          color:#fca5a5;
        "
        onmouseover="this.style.background='rgba(239,68,68,.15)'"
        onmouseout="this.style.background='transparent'">

        🚪 Logout

      </button>

    </form>

  </div>

</aside>


<script>

function toggleStudentSidebar() {

  document.body.classList.toggle(
    'student-sidebar-open'
  );

  updateStudentSidebarButton();

}


function closeStudentSidebar() {

  document.body.classList.remove(
    'student-sidebar-open'
  );

  updateStudentSidebarButton();

}


function updateStudentSidebarButton() {

  const button =
    document.getElementById(
      'studentSidebarToggle'
    );

  if (!button) return;


  const isOpen =
    document.body.classList.contains(
      'student-sidebar-open'
    );


  button.innerHTML =
    isOpen ? '&lt;' : '&gt;';


  button.setAttribute(
    'aria-expanded',
    isOpen ? 'true' : 'false'
  );


  button.setAttribute(
    'aria-label',
    isOpen
      ? 'Hide sidebar'
      : 'Show sidebar'
  );

}


/*
 * Automatically close sidebar
 * after selecting a menu item
 * on mobile.
 */

document.addEventListener(
  'DOMContentLoaded',
  function() {

    updateStudentSidebarButton();


    const sidebar =
      document.querySelector(
        '.student-sidebar'
      );


    if (!sidebar) return;


    const links =
      sidebar.querySelectorAll(
        'a.sidebar-link'
      );


    links.forEach(link => {

      link.addEventListener(
        'click',
        function() {

          if (
            window.innerWidth <= 767
          ) {

            closeStudentSidebar();

          }

        }
      );

    });

  }
);

</script>