<!-- Sidebar Toggle -->
<button
  type="button"
  class="sidebar-toggle"
  onclick="toggleSidebar()"
  aria-label="Toggle sidebar"
  title="Open navigation"
  style="margin: 8px; margin-left: 12px;"
>
  <div class="hamburger">
    <span></span>
    <span></span>
    <span></span>
  </div>
</button>

<!-- Dark Overlay -->
<div
  class="sidebar-overlay"
  onclick="closeSidebar()"
></div>

<!-- Cashier Sidebar -->
<aside class="app-sidebar">

  <!-- Logo -->
  <div
    style="
      padding:20px 16px 16px;
      border-bottom:1px solid rgba(255,255,255,.1);
    "
  >
    <div
      style="
        display:flex;
        align-items:center;
        gap:12px;
      "
    >
      <img
        src="/api/file/ug-logo.png"
        alt="MinSU Logo"
        style="
          width:48px;
          height:48px;
          object-fit:contain;
          border-radius:50%;
          background:#fff;
          padding:3px;
          flex-shrink:0;
        "
      >

      <div>
        <p
          style="
            color:#fff;
            font-weight:700;
            font-size:.95rem;
            line-height:1.2;
            margin:0;
          "
        >
          UniGuide
        </p>

        <p
          style="
            color:#a7d4b8;
            font-size:.72rem;
            margin:2px 0 0;
          "
        >
          MinSU — Bongabong Campus
        </p>
      </div>
    </div>
  </div>

  <!-- Navigation -->
  <nav
    style="
      flex:1;
      padding:16px 12px;
      overflow-y:auto;
    "
  >

    <!-- HOME -->
    <a
      href="/cashier/home"
      class="sidebar-link {{#if (eq activePage 'home')}}active{{/if}}"
    >
      <span>🏠</span>
      <span>Dashboard</span>
    </a>

    <!-- PAYMENT LIST -->
    <a
      href="/cashier/history"
      class="sidebar-link {{#if (eq activePage 'history')}}active{{/if}}"
    >
      <span>💰</span>
      <span>Payment History</span>
    </a>

    <!-- NOTIFICATIONS -->
    <a
      href="/cashier/notifications"
      class="sidebar-link {{#if (eq activePage 'notifications')}}active{{/if}}"
    >
      <span>🔔</span>
      <span>Notifications</span>
      {{#if (gt unreadNotifCount 0)}}
        <span class="notif-badge">{{unreadNotifCount}}</span>
      {{/if}}
    </a>

  </nav>

  <!-- User -->
  <div
    style="
      padding:14px 10px;
      border-top:1px solid rgba(255,255,255,.1);
    "
  >

    <div
      style="
        padding:0 6px;
        margin-bottom:8px;
      "
    >

      <p
        style="
          color:#fff;
          font-size:.85rem;
          font-weight:600;
          margin:0;
          white-space:nowrap;
          overflow:hidden;
          text-overflow:ellipsis;
        "
      >
        {{user.firstName}} {{user.lastName}}
      </p>

      <p
        style="
          color:#a7d4b8;
          font-size:.72rem;
          margin:2px 0 0;
        "
      >
        Cashier
      </p>

    </div>

    <form action="/logout" method="POST">

      <button
        type="submit"
        class="sidebar-link"
        style="
          width:100%;
          text-align:left;
          border:none;
          background:transparent;
          cursor:pointer;
          color:#fca5a5;
        "
        onmouseover="this.style.background='rgba(239,68,68,.15)'"
        onmouseout="this.style.background='transparent'"
      >
        🚪 Logout
      </button>

    </form>

  </div>

</aside>