<!-- Sidebar Toggle -->
<button
  type="button"
  class="sidebar-toggle"
  onclick="toggleSidebar()"
  aria-label="Toggle sidebar"
  title="Open navigation"
  style="margin: 8px; margin-left: 12px;"
>
  <div class="hamburger">
    <span></span>
    <span></span>
    <span></span>
  </div>
</button>

<!-- Dark Overlay -->
<div
  class="sidebar-overlay"
  onclick="closeSidebar()"
></div>

<!-- Guidance Sidebar -->
<aside class="app-sidebar">

  <!-- Logo + Branding -->
  <div
    style="
      padding:20px 16px 16px;
      border-bottom:1px solid rgba(255,255,255,.1);
    "
  >
    <div
      style="
        display:flex;
        align-items:center;
        gap:12px;
      "
    >

      <img
        src="/uploads/UG Education App Icon.png"
        alt="MinSU Logo"
        style="
          width:48px;
          height:48px;
          object-fit:contain;
          border-radius:50%;
          background:#fff;
          padding:3px;
          flex-shrink:0;
        "
      >

      <div>

        <p
          style="
            color:#fff;
            font-weight:700;
            font-size:.95rem;
            line-height:1.2;
            margin:0;
          "
        >
          UniGuide
        </p>

        <p
          style="
            color:#a7d4b8;
            font-size:.72rem;
            margin:2px 0 0;
          "
        >
          MinSU — Bongabong Campus
        </p>

      </div>

    </div>
  </div>

  <!-- Navigation -->
  <nav
    style="
      flex:1;
      padding:16px 12px;
      overflow-y:auto;
    "
  >

    <!-- HOME -->
    <a
      href="/guidance/home"
      class="sidebar-link {{#if (eq activePage 'home')}}active{{/if}}"
    >
      <span>🏠</span>
      <span>Dashboard</span>
    </a>

    <!-- APPLICATIONS -->
    <a
      href="/guidance/applications"
      class="sidebar-link {{#if (eq activePage 'applications')}}active{{/if}}"
    >
      <span>📋</span>
      <span>Applications</span>
    </a>

    <!-- APPOINTMENTS -->
    <a
      href="/guidance/appointments"
      class="sidebar-link {{#if (eq activePage 'appointments')}}active{{/if}}"
    >
      <span>📅</span>
      <span>Appointments</span>
    </a>

    <!-- STUDENT PROFILES -->
    <a
      href="/guidance/profiling"
      class="sidebar-link {{#if (eq activePage 'profiling')}}active{{/if}}"
    >
      <span>👥</span>
      <span>Student Profiles</span>
    </a>

    <!-- ANNOUNCEMENTS -->
    <a
      href="/guidance/announcements/new"
      class="sidebar-link {{#if (eq activePage 'announcements')}}active{{/if}}"
    >
      <span>📢</span>
      <span>Announcements</span>
    </a>

    <!-- REPORTS -->
    <a
      href="/guidance/reports"
      class="sidebar-link {{#if (eq activePage 'reports')}}active{{/if}}"
    >
      <span>📊</span>
      <span>Reports</span>
    </a>

    <!-- MANAGE USERS -->
    <a
      href="/guidance/users"
      class="sidebar-link {{#if (eq activePage 'users')}}active{{/if}}"
    >
      <span>🔐</span>
      <span>Manage Users</span>
    </a>

    <!-- NOTIFICATIONS -->
    <a
      href="/guidance/notifications"
      class="sidebar-link {{#if (eq activePage 'notifications')}}active{{/if}}"
    >
      <span>🔔</span>
      <span>Notifications</span>
      {{#if (gt unreadNotifCount 0)}}
        <span class="notif-badge">{{unreadNotifCount}}</span>
      {{/if}}
    </a>

  </nav>

  <!-- User + Logout -->
  <div
    style="
      padding:14px 10px;
      border-top:1px solid rgba(255,255,255,.1);
    "
  >

    <div
      style="
        padding:0 6px;
        margin-bottom:8px;
      "
    >

      <p
        style="
          color:#fff;
          font-size:.85rem;
          font-weight:600;
          margin:0;
          white-space:nowrap;
          overflow:hidden;
          text-overflow:ellipsis;
        "
      >
        {{user.firstName}} {{user.lastName}}
      </p>

      <p
        style="
          color:#a7d4b8;
          font-size:.72rem;
          margin:2px 0 0;
        "
      >
        Guidance Administrator
      </p>

    </div>

    <form action="/logout" method="POST">

      <button
        type="submit"
        class="sidebar-link"
        style="
          width:100%;
          text-align:left;
          border:none;
          background:transparent;
          cursor:pointer;
          color:#fca5a5;
        "
        onmouseover="this.style.background='rgba(239,68,68,.15)'"
        onmouseout="this.style.background='transparent'"
      >
        🚪 Logout
      </button>

    </form>

  </div>

</aside>