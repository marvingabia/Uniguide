<nav class="bg-white shadow-md p-4">
  <div class="container mx-auto flex justify-between items-center">
    <div class="flex items-center space-x-4">
      <!-- Hamburger Menu Button -->
      <button onclick="openSidebar()" class="text-gray-700 hover:text-purple-600 focus:outline-none">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
      <h1 class="text-2xl font-bold text-purple-600">🌱 Tellngrow</h1>
    </div>
    <div class="text-gray-700">
      {{#if user}}
      <a href="/user/profile" class="flex items-center space-x-2 hover:text-purple-600 transition">
        <div class="w-8 h-8 rounded-full overflow-hidden border-2 border-purple-200 bg-white flex items-center justify-center flex-shrink-0">
          {{#if user.profilePicture}}
            {{#if (eq (substring user.profilePicture 0 1) "/")}}
              <img src="{{user.profilePicture}}" alt="Profile" class="w-full h-full object-cover" />
            {{else}}
              <span class="text-xl">{{user.profilePicture}}</span>
            {{/if}}
          {{else}}
            <span class="text-xl text-gray-400">👤</span>
          {{/if}}
        </div>
        <span class="hidden md:inline font-medium">{{user.name}}</span>
      </a>
      {{else}}
      <span class="font-medium">Welcome!</span>
      {{/if}}
    </div>
  </div>
</nav>
