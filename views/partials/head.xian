<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes"
  >

  <meta
    name="mobile-web-app-capable"
    content="yes"
  >

  <meta
    name="apple-mobile-web-app-capable"
    content="yes"
  >

  <meta
    name="apple-mobile-web-app-status-bar-style"
    content="default"
  >

  <meta
    name="theme-color"
    content="#1b5e38"
  >

  <meta
    name="description"
    content="MinSU Bongabong Campus Good Moral Certificate Online Application System"
  >

  <!-- PWA -->
  <link
    rel="manifest"
    href="/manifest.json"
  >

  <link
    rel="icon"
    type="image/png"
    href="/uploads/minsulogo.png"
  >

  <link
    rel="apple-touch-icon"
    href="/uploads/minsulogo.png"
  >

  <title>{{title}}</title>

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>


  <style>

    /* =========================================================
       GLOBAL
    ========================================================= */

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      width: 100%;
      min-height: 100%;
      overflow-x: hidden;
    }

    body {
      width: 100%;
      min-height: 100vh;
      margin: 0;
      padding: 0;

      background: #f0f4f8;
      color: #1e293b;

      font-family:
        'Segoe UI',
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        sans-serif;

      overflow-x: hidden;
    }


    /* =========================================================
       APP SHELL
    ========================================================= */

    .app-shell {
      display: flex;
      width: 100%;
      min-height: 100vh;
      align-items: stretch;
    }

    .main-content {
      flex: 1 1 auto;
      min-width: 0;
      width: 100%;
      min-height: 100vh;

      background: #f0f4f8;

      overflow-x: hidden;
    }


    /* =========================================================
       PAGE CONTENT
    ========================================================= */

    .page-content {
      width: 100%;
      padding: 20px;
      min-width: 0;
    }


    /* =========================================================
       NAV TOP
    ========================================================= */

    .nav-top {
      width: 100%;

      background: #fff;
      border-bottom: 1px solid #e2e8f0;

      padding: 12px 24px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      min-height: 58px;

      box-shadow:
        0 1px 3px rgba(0, 0, 0, .05);

      position: relative;

      z-index: 50;

      transition:
        transform .25s ease,
        opacity .25s ease,
        box-shadow .25s ease;
    }

    /*
     * Used by the All Applications page.
     * It disappears while scrolling down
     * and comes back when scrolling up.
     */
    .nav-top.nav-hidden {
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
    }

    .nav-title {
      min-width: 0;
    }


    /* =========================================================
       BADGES
    ========================================================= */

    .badge {
      display: inline-block;

      padding: 3px 12px;

      border-radius: 9999px;

      font-size: .72rem;
      font-weight: 700;

      white-space: nowrap;
    }

    .badge-pending {
      background: #fef9c3;
      color: #854d0e;
    }

    .badge-submitted {
      background: #dbeafe;
      color: #1e40af;
    }

    .badge-verified {
      background: #dcfce7;
      color: #166534;
    }

    .badge-receipted {
      background: #e0e7ff;
      color: #3730a3;
    }

    .badge-approved {
      background: #f3e8ff;
      color: #6b21a8;
    }

    .badge-released {
      background: #d1fae5;
      color: #065f46;
    }

    .badge-rejected {
      background: #fee2e2;
      color: #991b1b;
    }


    /* =========================================================
       BUTTONS
    ========================================================= */

    .btn-green {
      background: #1b5e38;
      color: #fff;

      padding: 8px 20px;

      border-radius: 8px;
      border: none;

      cursor: pointer;

      font-weight: 600;
      font-size: .88rem;

      transition:
        background .2s,
        transform .1s;

      text-decoration: none;

      display: inline-block;

      text-align: center;

      touch-action: manipulation;
    }

    .btn-green:hover {
      background: #154d2f;
    }

    .btn-green:active {
      transform: scale(.98);
    }


    .btn-blue {
      background: #1d4ed8;
      color: #fff;

      padding: 8px 20px;

      border-radius: 8px;
      border: none;

      cursor: pointer;

      font-weight: 600;
      font-size: .88rem;

      transition: background .2s;

      text-decoration: none;

      display: inline-block;

      text-align: center;

      touch-action: manipulation;
    }

    .btn-blue:hover {
      background: #1e40af;
    }


    .btn-red {
      background: #dc2626;
      color: #fff;

      padding: 8px 20px;

      border-radius: 8px;
      border: none;

      cursor: pointer;

      font-weight: 600;
      font-size: .88rem;

      touch-action: manipulation;
    }

    .btn-red:hover {
      background: #b91c1c;
    }


    .btn-outline {
      background: transparent;
      color: #1b5e38;

      border: 1.5px solid #1b5e38;

      padding: 7px 18px;

      border-radius: 8px;

      cursor: pointer;

      font-weight: 600;
      font-size: .88rem;

      text-decoration: none;

      display: inline-block;

      text-align: center;

      touch-action: manipulation;
    }

    .btn-outline:hover {
      background: #1b5e38;
      color: #fff;
    }


    .btn-sm {
      padding: 5px 12px;
      font-size: .78rem;
    }


    /* =========================================================
       CARDS
    ========================================================= */

    .card {
      background: #fff;

      border: 1px solid #e2e8f0;

      border-radius: 12px;

      padding: 20px;

      box-shadow:
        0 1px 4px rgba(0, 0, 0, .07);
    }

    .card-sm {
      background: #fff;

      border: 1px solid #e2e8f0;

      border-radius: 10px;

      padding: 14px;

      box-shadow:
        0 1px 2px rgba(0, 0, 0, .05);
    }


    /* =========================================================
       INPUT
    ========================================================= */

    .input {
      background: #fff;

      border: 1px solid #cbd5e1;

      border-radius: 8px;

      padding: 10px 14px;

      color: #1e293b;

      width: 100%;

      outline: none;

      font-size: .9rem;

      min-height: 44px;

      touch-action: manipulation;
    }

    .input:focus {
      border-color: #1b5e38;

      box-shadow:
        0 0 0 3px rgba(27, 94, 56, .13);
    }


    .label {
      font-size: .82rem;

      color: #1b5e38;

      font-weight: 600;

      margin-bottom: 5px;

      display: block;
    }


    /* =========================================================
       SIDEBAR
    ========================================================= */

    .sidebar-link {
      display: flex;

      align-items: center;

      gap: 10px;

      padding: 9px 14px;

      border-radius: 8px;

      color: #a7d4b8;

      text-decoration: none;

      font-size: .875rem;

      font-weight: 500;

      transition: all .18s;

      touch-action: manipulation;

      min-height: 44px;
    }

    .sidebar-link:hover {
      background: rgba(255,255,255,.13);
      color: #fff;
    }

    .sidebar-link.active {
      background: #fff;

      color: #1b5e38;

      font-weight: 700;

      box-shadow:
        0 2px 8px rgba(0,0,0,.13);
    }

    .sidebar-link .badge {
      font-size: .65rem;
      padding: 2px 6px;
    }


    /* =========================================================
       TABLE — GENERAL
    ========================================================= */

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th {
      background: #f8fafc;

      color: #1b5e38;

      padding: 10px 14px;

      text-align: left;

      font-size: .73rem;

      text-transform: uppercase;

      letter-spacing: .06em;

      white-space: nowrap;

      border-bottom:
        2px solid #e2e8f0;
    }

    td {
      padding: 10px 14px;

      border-bottom:
        1px solid #f1f5f9;

      color: #374151;

      font-size: .875rem;

      vertical-align: middle;
    }

    tr:last-child td {
      border-bottom: none;
    }

    tr:hover td {
      background: #f6fbf8;
    }


    /* =========================================================
       GUIDANCE APPLICATIONS PAGE
    ========================================================= */

    .application-filters {
      width: 100%;

      display: flex;

      align-items: center;

      gap: 12px;

      margin-bottom: 16px;

      min-width: 0;
    }

    .filter-search {
      max-width: 260px;
    }

    .filter-status {
      width: auto;
      min-width: 170px;
    }

    .filter-button,
    .clear-button {
      flex: 0 0 auto;
      white-space: nowrap;
    }


    /* =========================================================
       APPLICATION TABLE
    ========================================================= */

    .applications-card {
      width: 100%;

      padding: 0;

      overflow: hidden;
    }

    .applications-table-scroll {
      width: 100%;

      overflow-x: auto;
      overflow-y: hidden;

      -webkit-overflow-scrolling: touch;

      overscroll-behavior-x: contain;

      scrollbar-width: thin;
    }

    .applications-table {
      width: 100%;

      min-width: 980px;

      table-layout: auto;
    }

    .applications-table th,
    .applications-table td {
      white-space: nowrap;
    }

    .applications-table th:nth-child(1) {
      width: 55px;
    }

    .applications-table th:nth-child(2) {
      min-width: 190px;
    }

    .applications-table th:nth-child(3) {
      min-width: 130px;
    }

    .applications-table th:nth-child(4) {
      min-width: 160px;
    }

    .applications-table th:nth-child(5) {
      min-width: 100px;
    }

    .applications-table th:nth-child(6) {
      min-width: 150px;
    }

    .applications-table th:nth-child(7) {
      min-width: 110px;
    }

    .applications-table th:nth-child(8) {
      min-width: 80px;
    }


    /* =========================================================
       TABLE CONTENT
    ========================================================= */

    .student-name {
      color: #1e293b;

      font-size: .875rem;

      font-weight: 600;

      white-space: nowrap;
    }

    .student-email {
      color: #64748b;

      font-size: .75rem;

      margin-top: 2px;

      white-space: nowrap;
    }

    .course-cell {
      color: #64748b;

      font-size: .875rem;

      white-space: nowrap;
    }

    .documents-cell {
      color: #4b5563;

      font-size: .75rem;
    }

    .document-list {
      display: flex;

      flex-direction: column;

      gap: 4px;
    }

    .amount-cell {
      color: #15803d;

      font-size: .875rem;

      font-weight: 600;

      white-space: nowrap;
    }

    .date-cell {
      color: #64748b;

      font-size: .75rem;

      white-space: nowrap;
    }

    .view-link {
      color: #15803d;

      font-size: .75rem;

      font-weight: 600;

      text-decoration: none;

      white-space: nowrap;
    }

    .view-link:hover {
      text-decoration: underline;
    }

    .mobile-scroll-hint {
      display: none;

      text-align: center;

      color: #64748b;

      font-size: .7rem;

      padding: 7px 10px;

      border-top: 1px solid #e2e8f0;

      background: #f8fafc;
    }


    /* =========================================================
       EMPTY STATE
    ========================================================= */

    .empty-applications {
      text-align: center;

      padding-top: 64px;
      padding-bottom: 64px;
    }

    .empty-icon {
      font-size: 3rem;

      margin-bottom: 12px;
    }


    /* =========================================================
       NOTIFICATIONS
    ========================================================= */

    .notif-info {
      background: #eff6ff;
      border-left: 3px solid #3b82f6;
    }

    .notif-success {
      background: #f0fdf4;
      border-left: 3px solid #22c55e;
    }

    .notif-warning {
      background: #fffbeb;
      border-left: 3px solid #f59e0b;
    }

    .notif-danger {
      background: #fef2f2;
      border-left: 3px solid #ef4444;
    }


    /* =========================================================
       STEPS
    ========================================================= */

    .step-done {
      background: #1b5e38;
      color: #fff;
    }

    .step-active {
      background: #2d7a52;

      color: #fff;

      box-shadow:
        0 0 0 3px rgba(27,94,56,.22);
    }

    .step-pending {
      background: #e2e8f0;
      color: #94a3b8;
    }


    /* =========================================================
       MISC
    ========================================================= */

    .divider {
      border: none;

      border-top:
        1px solid #e2e8f0;

      margin: 16px 0;
    }

    .text-muted {
      color: #94a3b8;
    }

    .truncate {
      overflow: hidden;

      text-overflow: ellipsis;

      white-space: nowrap;
    }

    .line-clamp-2 {
      display: -webkit-box;

      -webkit-line-clamp: 2;

      -webkit-box-orient: vertical;

      overflow: hidden;
    }


    /* =========================================================
       MOBILE MENU
    ========================================================= */

    #mobile-menu-toggle {
      display: none;

      position: fixed;

      top: 12px;
      left: 12px;

      z-index: 100;

      background: #1b5e38;

      color: #fff;

      border: none;

      padding: 10px 14px;

      border-radius: 8px;

      cursor: pointer;

      box-shadow:
        0 2px 8px rgba(0,0,0,.15);

      touch-action: manipulation;
    }

    #mobile-menu-overlay {
      display: none;

      position: fixed;

      inset: 0;

      background: rgba(0,0,0,.5);

      z-index: 98;
    }


    /* =========================================================
       SIDEBAR TRANSITION
    ========================================================= */

    aside {
      transition:
        transform .3s ease;
    }


    /* =========================================================
       MOBILE — 640px DOWN
    ========================================================= */

    @media (max-width: 640px) {

      body {
        font-size: 14px;
      }


      /* Mobile menu */

      #mobile-menu-toggle {
        display: flex;

        align-items: center;
        justify-content: center;
      }


      #mobile-menu-overlay.active {
        display: block;
      }


      aside {
        position: fixed !important;

        left: 0;
        top: 0;

        width: 280px !important;

        height: 100vh !important;

        z-index: 99;

        transform: translateX(-100%);

        box-shadow:
          2px 0 10px rgba(0,0,0,.2);

        overflow-y: auto;

        overflow-x: hidden;
      }

      aside.mobile-active {
        transform: translateX(0);
      }


      /* App shell */

      .app-shell {
        display: block;

        width: 100%;

        min-height: 100vh;
      }


      .main-content {
        width: 100%;

        min-width: 0;

        margin: 0 !important;

        padding: 0 !important;
      }


      /*
       * Do NOT use global flex-wrap here.
       * It was causing layout problems on phones.
       */

      .flex.h-screen {
        display: block !important;
      }


      /* Top nav */

      .nav-top {
        min-height: 58px;

        padding:
          10px 16px
          10px 56px;

        gap: 8px;

        align-items: flex-start;

        justify-content: space-between;

        flex-wrap: nowrap;

        transition:
          transform .25s ease,
          opacity .25s ease;
      }

      .nav-top h1 {
        font-size: .95rem !important;

        line-height: 1.3;

        white-space: nowrap;
      }

      .nav-top span {
        font-size: .72rem;

        white-space: nowrap;

        max-width: 45vw;

        overflow: hidden;

        text-overflow: ellipsis;
      }


      /* Page content */

      .page-content {
        width: 100%;

        padding: 14px;
      }


      /* Filters become stacked */

      .application-filters {
        display: grid;

        grid-template-columns: 1fr;

        gap: 10px;

        margin-bottom: 14px;
      }

      .filter-search,
      .filter-status {
        width: 100% !important;

        max-width: none !important;

        min-width: 0;
      }


      .filter-button,
      .clear-button {
        width: 100%;

        min-height: 46px;
      }


      /* Cards */

      .card {
        padding: 16px;

        border-radius: 10px;
      }


      .applications-card {
        padding: 0;

        border-radius: 10px;
      }


      /*
       * TABLE:
       * Keep it wide and let the user swipe horizontally.
       */

      .applications-table-scroll {
        width: 100%;

        max-width: 100%;

        overflow-x: auto;

        overflow-y: hidden;

        -webkit-overflow-scrolling: touch;
      }

      .applications-table {
        min-width: 980px;
      }


      .applications-table th {
        padding: 9px 10px;

        font-size: .68rem;
      }

      .applications-table td {
        padding: 10px;

        font-size: .78rem;
      }


      .student-name {
        font-size: .78rem;
      }

      .student-email {
        font-size: .68rem;
      }


      .badge {
        font-size: .68rem;

        padding: 4px 9px;
      }


      .mobile-scroll-hint {
        display: block;
      }


      /* Text */

      h1 {
        font-size: 1.3rem !important;
      }

      h2 {
        font-size: 1.15rem !important;
      }

      h3 {
        font-size: 1rem !important;
      }


      /* Buttons */

      .btn-green,
      .btn-blue,
      .btn-red,
      .btn-outline {
        min-height: 46px;

        padding: 11px 16px;

        font-size: .9rem;
      }


      .btn-sm {
        min-height: 46px;

        padding: 10px 14px;
      }


      /* Inputs */

      .input {
        width: 100%;

        min-height: 48px;

        font-size: 16px;

        padding: 12px 14px;
      }

      select.input {
        font-size: 16px;
      }


      /* Grid */

      .grid {
        display: grid !important;
      }

      .grid-cols-2,
      .grid-cols-3,
      .grid-cols-4 {
        grid-template-columns: 1fr !important;
      }


      /* Width */

      .max-w-2xl,
      .max-w-3xl,
      .max-w-4xl,
      .max-w-5xl,
      .max-w-6xl {
        max-width: 100% !important;
      }


      /* Images */

      img {
        max-width: 100%;

        height: auto;
      }


      .hide-mobile {
        display: none !important;
      }


      /* Empty */

      .empty-applications {
        padding-top: 50px;

        padding-bottom: 50px;
      }

    }


    /* =========================================================
       TABLET — 641px TO 768px
    ========================================================= */

    @media
      (min-width: 641px)
      and
      (max-width: 768px) {

      #mobile-menu-toggle {
        display: flex;

        align-items: center;
        justify-content: center;
      }

      #mobile-menu-overlay.active {
        display: block;
      }


      aside {
        position: fixed !important;

        left: 0;
        top: 0;

        width: 280px !important;

        height: 100vh !important;

        z-index: 99;

        transform: translateX(-100%);

        overflow-y: auto;
      }

      aside.mobile-active {
        transform: translateX(0);
      }


      .app-shell {
        display: block;
      }


      .main-content {
        width: 100%;

        margin: 0 !important;
      }


      .page-content {
        padding: 18px;
      }


      .nav-top {
        padding:
          12px 20px
          12px 56px;
      }


      .application-filters {
        flex-wrap: wrap;
      }


      .filter-search {
        max-width: 100%;

        flex: 1 1 100%;
      }


      .applications-table {
        min-width: 980px;
      }


      .mobile-scroll-hint {
        display: block;
      }


      .card {
        padding: 18px;
      }

    }


    /* =========================================================
       TABLET LANDSCAPE — 769px TO 1024px
    ========================================================= */

    @media
      (min-width: 769px)
      and
      (max-width: 1024px) {

      aside {
        width: 200px !important;
      }


      .page-content {
        padding: 18px;
      }


      .nav-top {
        padding: 12px 20px;
      }


      .application-filters {
        flex-wrap: wrap;
      }


      .filter-search {
        max-width: 280px;
      }


      .applications-table {
        min-width: 980px;
      }

    }


    /* =========================================================
       DESKTOP — 1025px UP
    ========================================================= */

    @media (min-width: 1025px) {

      #mobile-menu-toggle,
      #mobile-menu-overlay {
        display: none !important;
      }


      aside {
        position: sticky !important;

        top: 0;

        height: 100vh;

        transform: none !important;
      }


      .mobile-scroll-hint {
        display: none;
      }

    }


    /* =========================================================
       TOUCH DEVICES
    ========================================================= */

    @media (max-width: 1024px) {

      a,
      button,
      input,
      select,
      textarea {
        min-height: 44px;

        touch-action: manipulation;
      }


      button,
      .btn-green,
      .btn-blue,
      .btn-red,
      .btn-outline {
        -webkit-tap-highlight-color:
          rgba(0,0,0,.1);

        user-select: none;
      }


      html {
        scroll-behavior: smooth;
      }


      img {
        max-width: 100%;

        height: auto;
      }


      body.menu-open {
        overflow: hidden;
      }

    }


    /* =========================================================
       LANDSCAPE PHONE
    ========================================================= */

    @media
      (max-height: 500px)
      and
      (orientation: landscape) {

      aside {
        overflow-y: auto;
      }


      .nav-top {
        padding:
          8px 16px
          8px 56px;
      }

    }


    /* =========================================================
       PRINT
    ========================================================= */

    @media print {

      #mobile-menu-toggle,
      #mobile-menu-overlay,
      .sidebar-link,
      .nav-top,
      button {
        display: none !important;
      }


      aside {
        display: none !important;
      }


      .card {
        border: 1px solid #000;

        box-shadow: none;

        page-break-inside: avoid;
      }


      body {
        background: #fff;
      }


      .main-content,
      .flex-1 {
        margin: 0 !important;

        padding: 0 !important;
      }

    }

  </style>

</head>


<body>

  <!-- =======================================================
       MOBILE MENU BUTTON
  ======================================================== -->

  <button
    id="mobile-menu-toggle"
    onclick="toggleMobileMenu()"
    aria-label="Toggle Menu"
    type="button"
  >

    <svg
      width="24"
      height="24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >

      <line
        x1="3"
        y1="12"
        x2="21"
        y2="12"
      ></line>

      <line
        x1="3"
        y1="6"
        x2="21"
        y2="6"
      ></line>

      <line
        x1="3"
        y1="18"
        x2="21"
        y2="18"
      ></line>

    </svg>

  </button>


  <!-- =======================================================
       MOBILE MENU OVERLAY
  ======================================================== -->

  <div
    id="mobile-menu-overlay"
    onclick="closeMobileMenu()"
  ></div>


  <!-- =======================================================
       MOBILE MENU SCRIPT
  ======================================================== -->

  <script>

    function toggleMobileMenu() {

      const sidebar =
        document.querySelector('aside');

      const overlay =
        document.getElementById(
          'mobile-menu-overlay'
        );

      const body =
        document.body;

      if (!sidebar) return;

      sidebar.classList.toggle(
        'mobile-active'
      );

      if (overlay) {
        overlay.classList.toggle(
          'active'
        );
      }

      body.classList.toggle(
        'menu-open'
      );
    }


    function closeMobileMenu() {

      const sidebar =
        document.querySelector('aside');

      const overlay =
        document.getElementById(
          'mobile-menu-overlay'
        );

      const body =
        document.body;

      if (sidebar) {
        sidebar.classList.remove(
          'mobile-active'
        );
      }

      if (overlay) {
        overlay.classList.remove(
          'active'
        );
      }

      body.classList.remove(
        'menu-open'
      );
    }


    document.addEventListener(
      'DOMContentLoaded',
      function () {

        /*
         * Close sidebar after clicking
         * a sidebar link on mobile.
         */

        const sidebarLinks =
          document.querySelectorAll(
            '.sidebar-link'
          );

        sidebarLinks.forEach(
          function (link) {

            link.addEventListener(
              'click',
              function () {

                if (
                  window.innerWidth <= 1024
                ) {
                  closeMobileMenu();
                }

              }
            );

          }
        );


        /*
         * Close mobile sidebar when
         * resizing back to desktop.
         */

        let resizeTimer;

        window.addEventListener(
          'resize',
          function () {

            clearTimeout(
              resizeTimer
            );

            resizeTimer =
              setTimeout(
                function () {

                  if (
                    window.innerWidth > 1024
                  ) {
                    closeMobileMenu();
                  }

                },
                250
              );

          }
        );


        /*
         * Prevent accidental horizontal
         * page movement outside tables.
         */

        document.addEventListener(
          'touchmove',
          function (event) {

            const target =
              event.target.closest(
                '.applications-table-scroll'
              );

            if (target) {
              return;
            }

          },
          {
            passive: true
          }
        );

      }
    );

  </script>