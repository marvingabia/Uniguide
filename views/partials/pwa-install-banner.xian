<!-- PWA Install Button (top-right corner, shows when installable) -->
<button
  id="pwa-install-fab"
  title="Install App"
  onclick="window.installPWA()"
  style="
    display:none;
    position:fixed;
    top:12px;
    right:12px;
    z-index:9999;
    background:#1b5e38;
    color:#fff;
    border:none;
    border-radius:8px;
    padding:8px 14px;
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    box-shadow:0 2px 8px rgba(0,0,0,0.2);
    align-items:center;
    gap:6px;
  ">
  📲 Install App
</button>

<!-- PWA Install Bottom Banner -->
<div id="pwa-install-banner" style="display:none;position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:9998;background:linear-gradient(135deg,#1b5e38,#0f3d23);color:#fff;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,0.25);padding:14px 20px;max-width:420px;width:calc(100% - 32px);">
  <div style="display:flex;align-items:center;gap:12px;">
    <span style="font-size:28px;flex-shrink:0;">📱</span>
    <div style="flex:1;">
      <div style="font-weight:700;font-size:14px;">Install UniGuide</div>
      <div style="font-size:12px;opacity:.9;margin-top:2px;">Access anytime from your home screen</div>
    </div>
    <div style="display:flex;gap:8px;flex-shrink:0;">
      <button onclick="window.installPWA()" style="background:#22c55e;color:#fff;border:none;border-radius:6px;padding:7px 14px;font-size:13px;font-weight:600;cursor:pointer;">Install</button>
      <button onclick="document.getElementById('pwa-install-banner').style.display='none';sessionStorage.setItem('pwa-dismissed','1');" style="background:rgba(255,255,255,.2);color:#fff;border:none;border-radius:6px;padding:7px 10px;font-size:14px;cursor:pointer;">✕</button>
    </div>
  </div>
</div>

<script>
(function() {
  // Show install UI when browser signals PWA is installable
  window.addEventListener('pwaInstallPromptReady', function() {
    if (sessionStorage.getItem('pwa-dismissed') === '1') return;

    // Show floating button
    const fab = document.getElementById('pwa-install-fab');
    if (fab) fab.style.display = 'flex';

    // Show bottom banner (after 2s delay)
    setTimeout(function() {
      const banner = document.getElementById('pwa-install-banner');
      if (banner && sessionStorage.getItem('pwa-dismissed') !== '1') {
        banner.style.display = 'block';
      }
    }, 2000);
  });

  // Hide banner after successful install
  window.addEventListener('pwaAppInstalled', function() {
    const fab = document.getElementById('pwa-install-fab');
    const banner = document.getElementById('pwa-install-banner');
    if (fab) fab.style.display = 'none';
    if (banner) banner.style.display = 'none';
  });

  // Show update notification
  window.addEventListener('pwaUpdateAvailable', function() {
    const n = document.createElement('div');
    n.style.cssText = 'position:fixed;top:16px;left:50%;transform:translateX(-50%);background:#f59e0b;color:#fff;padding:10px 16px;border-radius:8px;font-size:13px;font-weight:600;z-index:9999;box-shadow:0 4px 16px rgba(0,0,0,.2);';
    n.innerHTML = '🔄 New version available! <button onclick="window.location.reload()" style="background:#fff;color:#f59e0b;border:none;border-radius:4px;padding:3px 10px;margin-left:8px;cursor:pointer;font-weight:700;">Update</button>';
    document.body.appendChild(n);
  });
})();
</script>
