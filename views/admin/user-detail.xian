<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white min-h-screen">
  <nav class="bg-white border-b border-gray-200 shadow-sm p-4">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <a href="/admin/dashboard" class="text-gray-600 hover:text-gray-900">← Back to Dashboard</a>
        <h1 class="text-2xl font-bold text-gray-800">User Details</h1>
      </div>
      <div class="space-x-4 flex items-center">
        <span class="text-gray-700">👤 {{user.name}}</span>
        <a href="/logout" class="text-gray-600 hover:text-gray-800 font-medium">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6">
    <!-- User Profile Card -->
    <div class="bg-white border-2 border-gray-200 rounded-lg p-6 mb-6">
      <div class="flex items-start space-x-6">
        <div class="w-24 h-24 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center text-white font-bold text-4xl">
          {{substring targetUser.name 0 1}}
        </div>
        <div class="flex-1">
          <h2 class="text-3xl font-bold text-gray-900">{{targetUser.name}}</h2>
          <p class="text-gray-600 mb-4">{{targetUser.email}}</p>
          
          <div class="flex gap-4 mb-4">
            <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-semibold">
              {{#if (eq targetUser.role 'admin')}}Admin{{else}}User{{/if}}
            </span>
            <span class="bg-purple-100 text-purple-800 px-3 py-1 rounded-full text-sm font-semibold">
              Level: {{#if targetUser.progress}}{{targetUser.progress.level}}{{else}}Beginner{{/if}}
            </span>
            <span class="{{#if (isOnline targetUser.lastActive)}}bg-green-100 text-green-800{{else}}bg-gray-100 text-gray-600{{/if}} px-3 py-1 rounded-full text-sm font-semibold">
              {{#if (isOnline targetUser.lastActive)}}● Online{{else}}○ Offline{{/if}}
            </span>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div>
              <div class="text-sm text-gray-600">Joined</div>
              <div class="font-semibold text-gray-900">{{formatDate targetUser.createdAt}}</div>
            </div>
            <div>
              <div class="text-sm text-gray-600">Last Active</div>
              <div class="font-semibold text-gray-900">
                {{#if targetUser.lastActive}}{{formatDate targetUser.lastActive}}{{else}}Never{{/if}}
              </div>
            </div>
            <div>
              <div class="text-sm text-gray-600">Total Points</div>
              <div class="font-semibold text-gray-900">
                {{#if targetUser.progress}}{{targetUser.progress.totalPoints}}{{else}}0{{/if}}
              </div>
            </div>
            <div>
              <div class="text-sm text-gray-600">Current Streak</div>
              <div class="font-semibold text-gray-900">
                {{#if targetUser.progress}}{{targetUser.progress.currentStreak}} days{{else}}0 days{{/if}}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Statistics -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-white border-2 border-gray-200 rounded-lg p-4">
        <div class="text-3xl mb-2">🎮</div>
        <div class="text-2xl font-bold text-gray-900">
          {{#if targetUser.progress}}{{targetUser.progress.totalGamesPlayed}}{{else}}0{{/if}}
        </div>
        <div class="text-sm text-gray-600">Games Played</div>
      </div>

      <div class="bg-white border-2 border-gray-200 rounded-lg p-4">
        <div class="text-3xl mb-2">📔</div>
        <div class="text-2xl font-bold text-gray-900">
          {{#if targetUser.progress}}{{targetUser.progress.totalJournalEntries}}{{else}}0{{/if}}
        </div>
        <div class="text-sm text-gray-600">Journal Entries</div>
      </div>

      <div class="bg-white border-2 border-gray-200 rounded-lg p-4">
        <div class="text-3xl mb-2">📚</div>
        <div class="text-2xl font-bold text-gray-900">
          {{readingSessions.length}}
        </div>
        <div class="text-sm text-gray-600">Reading Sessions</div>
      </div>

      <div class="bg-white border-2 border-gray-200 rounded-lg p-4">
        <div class="text-3xl mb-2">⭐</div>
        <div class="text-2xl font-bold text-gray-900">
          {{#if targetUser.progress}}{{targetUser.progress.totalPoints}}{{else}}0{{/if}}
        </div>
        <div class="text-sm text-gray-600">Total Points</div>
      </div>
    </div>

    <!-- Tabs -->
    <div class="bg-white border-2 border-gray-200 rounded-lg">
      <div class="border-b border-gray-200">
        <div class="flex">
          <button onclick="showTab('activities')" id="tab-activities" class="px-6 py-3 font-semibold border-b-2 border-purple-600 text-purple-600">
            All Activities
          </button>
          <button onclick="showTab('games')" id="tab-games" class="px-6 py-3 font-semibold text-gray-600 hover:text-gray-900">
            Games
          </button>
          <button onclick="showTab('journals')" id="tab-journals" class="px-6 py-3 font-semibold text-gray-600 hover:text-gray-900">
            Journals
          </button>
          <button onclick="showTab('reading')" id="tab-reading" class="px-6 py-3 font-semibold text-gray-600 hover:text-gray-900">
            Reading
          </button>
        </div>
      </div>

      <div class="p-6">
        <!-- Activities Tab -->
        <div id="content-activities" class="tab-content">
          <h3 class="text-lg font-bold text-gray-900 mb-4">Recent Activities</h3>
          <div class="space-y-2">
            {{#each activities}}
            <div class="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg">
              <span class="text-2xl">
                {{#if (eq this.type 'login')}}🔐
                {{else if (eq this.type 'game')}}🎮
                {{!-- quiz icon removed --}}
                {{else if (eq this.type 'journal')}}📔
                {{else if (eq this.type 'reading')}}📚
                {{else}}✨{{/if}}
              </span>
              <div class="flex-1">
                <div class="text-sm font-medium text-gray-900">{{this.description}}</div>
                <div class="text-xs text-gray-500">{{formatDate this.createdAt}}</div>
              </div>
            </div>
            {{else}}
            <div class="text-center text-gray-500 py-8">No activities yet</div>
            {{/each}}
          </div>
        </div>

        <!-- Games Tab -->
        <div id="content-games" class="tab-content hidden">
          <h3 class="text-lg font-bold text-gray-900 mb-4">Game Sessions</h3>
          <div class="space-y-2">
            {{#each gameSessions}}
            <div class="p-4 {{#if this.isPerfect}}bg-green-50 border-2 border-green-300{{else}}bg-gray-50{{/if}} rounded-lg">
              <div class="flex justify-between items-start">
                <div class="flex-1">
                  <div class="flex items-center gap-2">
                    <div class="font-semibold text-gray-900">{{this.gameType}}</div>
                    {{#if this.isPerfect}}
                    <span class="bg-green-500 text-white text-xs px-2 py-1 rounded-full font-bold">🏆 PERFECT!</span>
                    {{/if}}
                  </div>
                  <div class="text-sm text-gray-600 mt-1">
                    Score: <span class="font-bold">{{this.score}}</span> | Duration: {{this.duration}}s
                  </div>
                </div>
                <div class="flex flex-col items-end gap-2">
                  <div class="text-xs text-gray-500">{{formatDate this.createdAt}}</div>
                </div>
              </div>
            </div>
            {{else}}
            <div class="text-center text-gray-500 py-8">No games played yet</div>
            {{/each}}
          </div>
        </div>


        <!-- Journals Tab -->
        <div id="content-journals" class="tab-content hidden">
          <h3 class="text-lg font-bold text-gray-900 mb-4">Journal Entries</h3>
          <div class="space-y-2">
            {{#each journalEntries}}
            <div class="p-4 bg-gray-50 rounded-lg">
              <div class="flex justify-between items-start mb-2">
                <div class="font-semibold text-gray-900">{{this.title}}</div>
                <div class="text-xs text-gray-500">{{formatDate this.createdAt}}</div>
              </div>
              <div class="text-sm text-gray-600 line-clamp-2">{{this.content}}</div>
              <div class="mt-2 flex gap-2">
                {{#if this.mood}}
                <span class="text-xs bg-purple-100 text-purple-800 px-2 py-1 rounded">{{this.mood}}</span>
                {{/if}}
                <span class="text-xs bg-gray-200 text-gray-700 px-2 py-1 rounded">{{this.wordCount}} words</span>
              </div>
            </div>
            {{else}}
            <div class="text-center text-gray-500 py-8">No journal entries yet</div>
            {{/each}}
          </div>
        </div>

        <!-- Reading Tab -->
        <div id="content-reading" class="tab-content hidden">
          <h3 class="text-lg font-bold text-gray-900 mb-4">Reading Sessions</h3>
          <div class="space-y-2">
            {{#each readingSessions}}
            <div class="p-4 bg-blue-50 rounded-lg border border-blue-200">
              <div class="flex justify-between items-start mb-2">
                <div class="flex items-center gap-2">
                  <span class="text-2xl">📚</span>
                  <div>
                    <div class="font-semibold text-gray-900">{{this.material.title}}</div>
                    <div class="text-xs text-gray-600">{{this.material.category}}</div>
                  </div>
                </div>
                <div class="text-xs text-gray-500">{{formatDate this.startTime}}</div>
              </div>
              <div class="flex gap-4 text-sm">
                <span class="text-gray-600">⏱️ Duration: <span class="font-semibold">{{formatDuration this.duration}}</span></span>
                {{#if this.completed}}
                <span class="text-green-600 font-semibold">✓ Completed</span>
                {{/if}}
              </div>
            </div>
            {{else}}
            <div class="text-center text-gray-500 py-8">No reading sessions yet</div>
            {{/each}}
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    function showTab(tabName) {
      // Hide all tabs
      document.querySelectorAll('.tab-content').forEach(tab => {
        tab.classList.add('hidden');
      });

      // Remove active state from all buttons
      document.querySelectorAll('[id^="tab-"]').forEach(btn => {
        btn.classList.remove('border-b-2', 'border-purple-600', 'text-purple-600');
        btn.classList.add('text-gray-600');
      });

      // Show selected tab
      document.getElementById('content-' + tabName).classList.remove('hidden');

      // Add active state to selected button
      const activeBtn = document.getElementById('tab-' + tabName);
      activeBtn.classList.add('border-b-2', 'border-purple-600', 'text-purple-600');
      activeBtn.classList.remove('text-gray-600');
    }

    async function generateCertificate(userId, type, activityName, sessionId) {
      if (!confirm(`Generate certificate for ${activityName}?`)) return;

      try {
        const response = await fetch('/admin/generate-certificate', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            userId,
            type,
            activityName,
            sessionId
          })
        });

        const result = await response.json();

        if (response.ok) {
          alert('✅ Certificate generated successfully!');
          location.reload(); // Refresh to show new certificate
        } else {
          alert('❌ Error: ' + result.message);
        }
      } catch (error) {
        console.error('Certificate generation error:', error);
        alert('❌ Failed to generate certificate');
      }
    }

    async function sendCertificate(certificateId) {
      if (!confirm('Send this certificate to the user?')) return;

      try {
        const response = await fetch('/admin/certificates/send/' + certificateId, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        });

        const result = await response.json();

        if (response.ok) {
          alert('✅ Certificate sent to user!');
          location.reload();
        } else {
          alert('❌ Error: ' + result.message);
        }
      } catch (error) {
        console.error('Send certificate error:', error);
        alert('❌ Failed to send certificate');
      }
    }
  </script>
</body>
</html>
