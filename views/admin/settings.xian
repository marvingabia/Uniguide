<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings - Tellngrow Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .tab-button.active {
      border-bottom: 3px solid #7c3aed;
      color: #7c3aed;
      font-weight: 600;
    }
    .tab-content {
      display: none;
    }
    .tab-content.active {
      display: block;
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <nav class="bg-white border-b border-gray-200 shadow-sm px-4 py-3 sticky top-0 z-50">
    <div class="flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <a href="/admin/dashboard" class="text-gray-600 hover:text-purple-600 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
        </a>
        <h1 class="text-xl font-bold text-gray-800">Admin Settings</h1>
      </div>
      <div class="flex items-center">
        <a href="/logout" class="text-gray-600 hover:text-red-600 p-2 rounded-lg hover:bg-red-50 transition font-medium">
          Logout
        </a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto p-6">
    <!-- Tabs -->
    <div class="bg-white rounded-xl shadow-sm mb-6">
      <div class="border-b border-gray-200">
        <nav class="flex space-x-8 px-6" aria-label="Tabs">
          <button onclick="switchTab('profile')" class="tab-button active py-4 px-1 text-gray-600 hover:text-purple-600 transition">
            Profile Settings
          </button>
          <button onclick="switchTab('system')" class="tab-button py-4 px-1 text-gray-600 hover:text-purple-600 transition">
            System Configuration
          </button>
          <button onclick="switchTab('security')" class="tab-button py-4 px-1 text-gray-600 hover:text-purple-600 transition">
            Security
          </button>
          <button onclick="switchTab('notifications')" class="tab-button py-4 px-1 text-gray-600 hover:text-purple-600 transition">
            Notifications
          </button>
        </nav>
      </div>

      <!-- Profile Settings Tab -->
      <div id="profile-tab" class="tab-content active p-6">
        <h3 class="text-xl font-bold text-gray-900 mb-4">Profile Settings</h3>
        <form action="/admin/settings/profile" method="POST" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
              <input type="text" name="name" value="{{user.name}}" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent" required>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
              <input type="email" name="email" value="{{user.email}}" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent" required>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Bio</label>
            <textarea name="bio" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">{{user.bio}}</textarea>
          </div>
          <div class="flex justify-end">
            <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg font-medium transition">
              Save Profile Changes
            </button>
          </div>
        </form>
      </div>

      <!-- System Configuration Tab -->
      <div id="system-tab" class="tab-content p-6">
        <h3 class="text-xl font-bold text-gray-900 mb-4">System Configuration</h3>
        <form action="/admin/settings/system" method="POST" class="space-y-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">System Name</label>
            <input type="text" name="systemName" value="Tellngrow Mental Wellness" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">System Description</label>
            <textarea name="systemDescription" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">A comprehensive mental wellness platform for students</textarea>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Max File Upload Size (MB)</label>
              <input type="number" name="maxFileSize" value="10" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Session Timeout (minutes)</label>
              <input type="number" name="sessionTimeout" value="60" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">
            </div>
          </div>
          <div class="space-y-3">
            <label class="flex items-center space-x-3">
              <input type="checkbox" name="allowRegistration" checked class="w-5 h-5 text-purple-600 rounded focus:ring-purple-500">
              <span class="text-gray-700">Allow new user registrations</span>
            </label>
            <label class="flex items-center space-x-3">
              <input type="checkbox" name="requireEmailVerification" class="w-5 h-5 text-purple-600 rounded focus:ring-purple-500">
              <span class="text-gray-700">Require email verification for new accounts</span>
            </label>
            <label class="flex items-center space-x-3">
              <input type="checkbox" name="maintenanceMode" class="w-5 h-5 text-purple-600 rounded focus:ring-purple-500">
              <span class="text-gray-700">Enable maintenance mode</span>
            </label>
          </div>
          <div class="flex justify-end">
            <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg font-medium transition">
              Save System Settings
            </button>
          </div>
        </form>
      </div>

      <!-- Security Tab -->
      <div id="security-tab" class="tab-content p-6">
        <h3 class="text-xl font-bold text-gray-900 mb-4">Security Settings</h3>
        <form action="/admin/settings/security" method="POST" class="space-y-6">
          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
            <div class="flex items-start space-x-3">
              <svg class="w-6 h-6 text-yellow-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
              <div>
                <h4 class="font-semibold text-yellow-800">Change Password</h4>
                <p class="text-sm text-yellow-700">Leave blank if you don't want to change your password</p>
              </div>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Current Password</label>
            <input type="password" name="currentPassword" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">New Password</label>
              <input type="password" name="newPassword" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Confirm New Password</label>
              <input type="password" name="confirmPassword" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">
            </div>
          </div>
          <div class="border-t border-gray-200 pt-6 mt-6">
            <h4 class="font-semibold text-gray-900 mb-4">Security Options</h4>
            <div class="space-y-3">
              <label class="flex items-center space-x-3">
                <input type="checkbox" name="twoFactorAuth" class="w-5 h-5 text-purple-600 rounded focus:ring-purple-500">
                <span class="text-gray-700">Enable two-factor authentication</span>
              </label>
              <label class="flex items-center space-x-3">
                <input type="checkbox" name="loginNotifications" checked class="w-5 h-5 text-purple-600 rounded focus:ring-purple-500">
                <span class="text-gray-700">Send email notifications for new logins</span>
              </label>
            </div>
          </div>
          <div class="flex justify-end">
            <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg font-medium transition">
              Update Security Settings
            </button>
          </div>
        </form>
      </div>

      <!-- Notifications Tab -->
      <div id="notifications-tab" class="tab-content p-6">
        <h3 class="text-xl font-bold text-gray-900 mb-4">Notification Preferences</h3>
        <form action="/admin/settings/notifications" method="POST" class="space-y-6">
          <div>
            <h4 class="font-semibold text-gray-900 mb-3">Email Notifications</h4>
            <div class="space-y-3">
              <label class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-700">New user registrations</span>
                <input type="checkbox" name="notifyNewUsers" checked class="w-5 h-5 text-purple-600 rounded focus:ring-purple-500">
              </label>
              <label class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-700">New counselor applications</span>
                <input type="checkbox" name="notifyNewCounselors" checked class="w-5 h-5 text-purple-600 rounded focus:ring-purple-500">
              </label>
              <label class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-700">New reading materials uploaded</span>
                <input type="checkbox" name="notifyNewMaterials" checked class="w-5 h-5 text-purple-600 rounded focus:ring-purple-500">
              </label>
              <label class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-700">System errors and warnings</span>
                <input type="checkbox" name="notifySystemErrors" checked class="w-5 h-5 text-purple-600 rounded focus:ring-purple-500">
              </label>
              <label class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-700">Daily activity summary</span>
                <input type="checkbox" name="notifyDailySummary" class="w-5 h-5 text-purple-600 rounded focus:ring-purple-500">
              </label>
            </div>
          </div>
          <div>
            <h4 class="font-semibold text-gray-900 mb-3">In-App Notifications</h4>
            <div class="space-y-3">
              <label class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-700">Show notification badge</span>
                <input type="checkbox" name="showNotificationBadge" checked class="w-5 h-5 text-purple-600 rounded focus:ring-purple-500">
              </label>
              <label class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-700">Play notification sound</span>
                <input type="checkbox" name="notificationSound" class="w-5 h-5 text-purple-600 rounded focus:ring-purple-500">
              </label>
            </div>
          </div>
          <div class="flex justify-end">
            <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg font-medium transition">
              Save Notification Settings
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    function switchTab(tabName) {
      // Hide all tab contents
      document.querySelectorAll('.tab-content').forEach(content => {
        content.classList.remove('active');
      });
      
      // Remove active class from all tab buttons
      document.querySelectorAll('.tab-button').forEach(button => {
        button.classList.remove('active');
      });
      
      // Show selected tab content
      document.getElementById(tabName + '-tab').classList.add('active');
      
      // Add active class to clicked button
      event.target.classList.add('active');
    }

    // Form submission handlers
    document.querySelectorAll('form').forEach(form => {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        alert('Settings saved successfully! (Backend implementation needed)');
      });
    });
  </script>
</body>
</html>
