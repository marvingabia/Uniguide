?<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    .progress-circle {
      transform: rotate(-90deg);
    }
    .sidebar-open {
      transform: translateX(0);
    }
    .sidebar-closed {
      transform: translateX(-100%);
    }
    #adminSidebar {
      transition: transform 0.3s ease-in-out, width 0.3s ease-in-out;
    }
    #mainContent {
      margin-left: 16rem;
      transition: margin-left 0.3s ease-in-out;
    }
    #mainContent.sidebar-hidden {
      margin-left: 0;
    }
    /* Hamburger icon animation */
    #hamburgerIcon .bar1, #hamburgerIcon .bar2, #hamburgerIcon .bar3 {
      transition: all 0.3s ease;
      transform-origin: center;
    }
    #hamburgerIcon.is-open .bar1 {
      transform: translateY(8px) rotate(45deg);
    }
    #hamburgerIcon.is-open .bar2 {
      opacity: 0;
      transform: scaleX(0);
    }
    #hamburgerIcon.is-open .bar3 {
      transform: translateY(-8px) rotate(-45deg);
    }
    .card-hover {
      transition: all 0.3s ease;
    }
    .card-hover:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }
    .gradient-purple {
      background: linear-gradient(135deg, #14532d 0%, #166534 100%);
    }
    .gradient-blue {
      background: linear-gradient(135deg, #15803d 0%, #16a34a 100%);
    }
    .gradient-green {
      background: linear-gradient(135deg, #166534 0%, #15803d 100%);
    }
    .gradient-orange {
      background: linear-gradient(135deg, #14532d 0%, #22c55e 100%);
    }
    @media (max-width: 768px) {
      #mainContent {
        margin-left: 0;
      }
      #adminSidebar {
        transform: translateX(-100%);
      }
    }
  </style>
</head>
<body class="bg-gray-950 min-h-screen">
  <!-- Mobile Overlay -->
  <div id="mobileOverlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden md:hidden"></div>

  <!-- Top Navigation -->
  <nav class="bg-black border-b border-green-900 shadow-sm px-4 py-3 sticky top-0 z-30">
    <div class="flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <button onclick="toggleSidebar()" class="text-green-400 hover:text-green-300 transition p-2 rounded-lg hover:bg-green-900">
          <svg id="hamburgerIcon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <line class="bar1" x1="4" y1="6" x2="20" y2="6" stroke-width="2" stroke-linecap="round"/>
            <line class="bar2" x1="4" y1="12" x2="20" y2="12" stroke-width="2" stroke-linecap="round"/>
            <line class="bar3" x1="4" y1="18" x2="20" y2="18" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
        <div class="flex items-center space-x-2">
          <div class="w-8 h-8 bg-green-700 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-sm">A</span>
          </div>
          <h1 class="text-xl font-bold text-white hidden sm:block">Admin Dashboard</h1>
        </div>
      </div>
      
      <div class="flex items-center space-x-3">
        <!-- Notifications -->
        <div class="relative">
          <button onclick="toggleNotifications()" class="relative p-2 text-green-400 hover:text-green-300 transition rounded-lg hover:bg-green-900">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
            </svg>
            {{#if newUsersCount}}
            <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center animate-pulse">{{newUsersCount}}</span>
            {{/if}}
          </button>

          <!-- Notification Dropdown -->
          <div id="notificationDropdown" class="hidden absolute right-0 mt-2 w-96 bg-gray-900 rounded-xl shadow-2xl border border-green-900 z-50 max-h-96 overflow-y-auto">
            <div class="p-4 border-b border-green-900 bg-black">
              <h3 class="font-bold text-white text-lg">Notifications</h3>
              <p class="text-sm text-green-400">Recent activity and updates</p>
            </div>
            
            <div class="divide-y divide-green-900">
              <!-- New Users Notifications -->
              {{#if recentUsers.length}}
              <div class="p-3 bg-green-950">
                <h4 class="font-semibold text-green-300 text-sm mb-2">?? New User Registrations</h4>
              </div>
              {{#each recentUsers}}
              <div class="p-4 hover:bg-green-950 transition cursor-pointer" onclick="window.location.href='/admin/users/{{this.id}}'">
                <div class="flex items-start space-x-3">
                  <div class="w-10 h-10 rounded-full bg-green-800 flex items-center justify-center text-white font-bold flex-shrink-0">
                    {{substring this.name 0 1}}
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-white">{{this.name}}</p>
                    <p class="text-xs text-green-400 truncate">{{this.email}}</p>
                    <p class="text-xs text-gray-500 mt-1">
                      <span class="inline-flex items-center">
                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        {{formatDate this.createdAt}}
                      </span>
                    </p>
                  </div>
                  <span class="text-xs bg-green-900 text-green-300 px-2 py-1 rounded-full">New</span>
                </div>
              </div>
              {{/each}}
              {{else}}
              <div class="p-8 text-center text-gray-500">
                <svg class="w-12 h-12 mx-auto mb-3 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                </svg>
                <p class="text-sm text-gray-400">No new notifications</p>
              </div>
              {{/if}}

              <!-- Pending Counselors -->
              {{#if pendingCounselors.length}}
              <div class="p-3 bg-yellow-950">
                <h4 class="font-semibold text-yellow-300 text-sm mb-2">? Pending Counselor Approvals</h4>
              </div>
              {{#each pendingCounselors}}
              <div class="p-4 hover:bg-green-950 transition cursor-pointer" onclick="window.location.href='/admin/users/{{this.id}}'">
                <div class="flex items-start space-x-3">
                  <div class="w-10 h-10 rounded-full bg-yellow-800 flex items-center justify-center text-white font-bold flex-shrink-0">
                    {{substring this.name 0 1}}
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-white">{{this.name}}</p>
                    <p class="text-xs text-gray-400 truncate">{{this.email}}</p>
                    <p class="text-xs text-gray-500 mt-1">Waiting for approval</p>
                  </div>
                  <span class="text-xs bg-yellow-900 text-yellow-300 px-2 py-1 rounded-full">Pending</span>
                </div>
              </div>
              {{/each}}
              {{/if}}
            </div>

            <div class="p-3 border-t border-green-900 bg-black">
              <button onclick="clearNotifications()" class="w-full text-center text-sm text-green-400 hover:text-green-300 font-medium">
                Mark all as read
              </button>
            </div>
          </div>
        </div>

        <!-- Settings -->
        <a href="/admin/settings" class="p-2 text-green-400 hover:text-green-300 transition rounded-lg hover:bg-green-900">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </a>

        <!-- Profile -->
        <a href="/admin/profile" class="flex items-center space-x-2 hover:bg-green-900 rounded-lg p-2 transition">
          <div class="w-8 h-8 rounded-full overflow-hidden border-2 border-green-600 bg-black flex items-center justify-center flex-shrink-0">
            {{#if user.profilePicture}}
              {{#if (eq (substring user.profilePicture 0 1) "/")}}
                <img src="{{user.profilePicture}}" alt="Profile" class="w-full h-full object-cover" />
              {{else}}
                <span class="text-lg">{{user.profilePicture}}</span>
              {{/if}}
            {{else}}
              <span class="text-lg text-gray-400"></span>
            {{/if}}
          </div>
          <span class="text-white font-medium hidden sm:block">{{user.name}}</span>
        </a>
      </div>
    </div>
  </nav>

  <div class="flex">
    <!-- Sidebar -->
    <aside id="adminSidebar" class="w-64 bg-black border-r border-green-900 min-h-screen fixed top-16 left-0 transition-transform duration-300 ease-in-out z-40">
      <div class="p-4">
        <!-- Navigation Menu -->
        <nav class="space-y-1">
          <a href="#overview" onclick="scrollToSection('overview')" class="nav-item flex items-center space-x-3 px-3 py-2 rounded-lg bg-green-700 text-white transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <span class="font-medium">Dashboard</span>
          </a>
          
          <a href="#users" onclick="scrollToSection('users')" class="nav-item flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-green-900 text-green-300 hover:text-white transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
            </svg>
            <span class="font-medium">Users</span>
          </a>

          <a href="#counselors" onclick="scrollToSection('counselors')" class="nav-item flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-green-900 text-green-300 hover:text-white transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2V8a2 2 0 012-2V6"></path>
            </svg>
            <span class="font-medium">Counselors</span>
            {{#if pendingCounselors.length}}
            <span class="ml-auto bg-yellow-500 text-white text-xs px-2 py-1 rounded-full">{{pendingCounselors.length}}</span>
            {{/if}}
          </a>

          <a href="#materials" onclick="scrollToSection('materials'); return false;" class="nav-item flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-green-900 text-green-300 hover:text-white transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            <span class="font-medium">Materials</span>
          </a>

          <a href="#activity-timeline" onclick="scrollToSection('activity-timeline')" class="nav-item flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-green-900 text-green-300 hover:text-white transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span class="font-medium">Activities</span>
          </a>

          <a href="/admin/analytics" class="nav-item flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-green-900 text-green-300 hover:text-white transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <span class="font-medium">Analytics</span>
          </a>

          <a href="/admin/fitness" class="nav-item flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-green-900 text-green-300 hover:text-white transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span class="font-medium">Fitness Videos</span>
          </a>

          <a href="/admin/messages" class="nav-item flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-green-900 text-green-300 hover:text-white transition relative">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
            <span class="font-medium">Messages</span>
            {{#if stats.unreadAdminMessages}}
            <span class="ml-auto bg-red-500 text-white text-xs px-2 py-1 rounded-full animate-pulse">{{stats.unreadAdminMessages}}</span>
            {{/if}}
          </a>
        </nav>

        <!-- System Status -->
        <button onclick="toggleSystemStatus()" class="mt-8 p-3 bg-green-950 rounded-lg hover:bg-green-900 transition w-full text-left border border-green-800">
          <div class="flex items-center justify-between mb-2">
            <span class="text-sm text-green-300">System Status</span>
            <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          </div>
          <div class="text-xs text-green-600">All systems operational</div>
        </button>
      </div>
    </aside>

    <div id="systemStatusModal" class="hidden fixed inset-0 bg-black bg-opacity-70 z-50 flex items-center justify-center p-4">
      <div class="bg-gray-900 border border-green-800 rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
        <div class="p-6 border-b border-green-900">
          <div class="flex items-center justify-between">
            <h3 class="text-2xl font-bold text-white">System Status</h3>
            <button onclick="toggleSystemStatus()" class="text-green-400 hover:text-white">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>
        
        <div class="p-6 space-y-4">
          <div class="bg-green-950 border-2 border-green-700 rounded-lg p-4">
            <div class="flex items-center space-x-3">
              <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
              <div>
                <div class="font-bold text-green-300">All Systems Operational</div>
                <div class="text-sm text-green-500">Last checked: Just now</div>
              </div>
            </div>
          </div>

          <div class="space-y-3">
            <h4 class="font-bold text-white">System Components</h4>
            
            <div class="flex items-center justify-between p-3 bg-gray-800 rounded-lg">
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                <span class="text-gray-300">Database</span>
              </div>
              <span class="text-sm text-green-400 font-medium">Operational</span>
            </div>

            <div class="flex items-center justify-between p-3 bg-gray-800 rounded-lg">
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                <span class="text-gray-300">API Server</span>
              </div>
              <span class="text-sm text-green-400 font-medium">Operational</span>
            </div>

            <div class="flex items-center justify-between p-3 bg-gray-800 rounded-lg">
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                <span class="text-gray-300">File Storage</span>
              </div>
              <span class="text-sm text-green-400 font-medium">Operational</span>
            </div>

            <div class="flex items-center justify-between p-3 bg-gray-800 rounded-lg">
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                <span class="text-gray-300">Authentication</span>
              </div>
              <span class="text-sm text-green-400 font-medium">Operational</span>
            </div>
          </div>

          <div class="space-y-3">
            <h4 class="font-bold text-white">System Statistics</h4>
            
            <div class="grid grid-cols-2 gap-3">
              <div class="bg-green-950 border border-green-800 rounded-lg p-3">
                <div class="text-2xl font-bold text-green-400">{{stats.totalUsers}}</div>
                <div class="text-xs text-green-600">Total Users</div>
              </div>
              
              <div class="bg-green-950 border border-green-800 rounded-lg p-3">
                <div class="text-2xl font-bold text-green-400">{{stats.activeToday}}</div>
                <div class="text-xs text-green-600">Active Today</div>
              </div>
              
              <div class="bg-green-950 border border-green-800 rounded-lg p-3">
                <div class="text-2xl font-bold text-green-400">{{stats.totalMaterials}}</div>
                <div class="text-xs text-green-600">Total Materials</div>
              </div>
              
              <div class="bg-green-950 border border-green-800 rounded-lg p-3">
                <div class="text-2xl font-bold text-green-400">99.9%</div>
                <div class="text-xs text-green-600">Uptime</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <main id="mainContent" class="flex-1 transition-all duration-300">
      <div class="p-4 md:p-6">
        <!-- Welcome Header (Single, at top) -->
        <div class="mb-8">
          <h1 class="text-3xl font-bold text-white mb-2">Welcome back, {{user.name}}! </h1>
          <p class="text-green-400">Here's what's happening with your platform today.</p>
        </div>

        <!-- Overview Section -->
        <section id="overview">
          <!-- Colorful Statistics Cards - Top Priority -->
          <div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-8">
            <div class="bg-gradient-to-br from-green-800 to-green-900 rounded-xl p-6 text-white shadow-lg card-hover border border-green-700">
              <div class="flex justify-center mb-2">
                <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path>
                </svg>
              </div>
              <div class="text-3xl font-bold">{{stats.totalUsers}}</div>
              <div class="text-sm text-green-200">Total Users</div>
            </div>

            <div class="bg-gradient-to-br from-black to-gray-900 rounded-xl p-6 text-white shadow-lg card-hover border border-green-800">
              <div class="flex justify-center mb-2">
                <svg class="w-12 h-12 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M11 17a1 1 0 001.447.894l4-2A1 1 0 0017 15V9.236a1 1 0 00-1.447-.894l-4 2a1 1 0 00-.553.894V17zM15.211 6.276a1 1 0 000-1.788l-4.764-2.382a1 1 0 00-.894 0L4.789 4.488a1 1 0 000 1.788l4.764 2.382a1 1 0 00.894 0l4.764-2.382zM4.447 8.342A1 1 0 003 9.236V15a1 1 0 00.553.894l4 2A1 1 0 009 17v-5.764a1 1 0 00-.553-.894l-4-2z"></path>
                </svg>
              </div>
              <div class="text-3xl font-bold">{{stats.totalGames}}</div>
              <div class="text-sm text-green-400">Games Played</div>
            </div>

            <div class="bg-gradient-to-br from-green-900 to-black rounded-xl p-6 text-white shadow-lg card-hover border border-green-800">
              <div class="flex justify-center mb-2">
                <svg class="w-12 h-12 text-green-300" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"></path>
                </svg>
              </div>
              <div class="text-3xl font-bold">{{stats.totalJournals}}</div>
              <div class="text-sm text-green-300">Journal Entries</div>
            </div>

            <div class="bg-gradient-to-br from-gray-900 to-green-950 rounded-xl p-6 text-white shadow-lg card-hover border border-green-800">
              <div class="flex justify-center mb-2">
                <svg class="w-12 h-12 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"></path>
                </svg>
              </div>
              <div class="text-3xl font-bold">{{stats.totalReadingSessions}}</div>
              <div class="text-sm text-green-400">Reading Sessions</div>
            </div>

            <div class="bg-gradient-to-br from-green-700 to-green-800 rounded-xl p-6 text-white shadow-lg card-hover border border-green-600">
              <div class="flex justify-center mb-2">
                <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div class="text-3xl font-bold">{{stats.activeToday}}</div>
              <div class="text-sm text-green-100">Active Today</div>
            </div>
          </div>

          <!-- Progress Cards - Show completion rates -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <!-- Daily Active Users -->
            <div class="bg-gray-900 border border-green-900 rounded-xl shadow-sm p-6 card-hover">
              <div class="flex items-center justify-center mb-4">
                <div class="relative w-24 h-24">
                  <svg class="w-24 h-24 progress-circle" viewBox="0 0 36 36">
                    <path class="text-gray-700" stroke="currentColor" stroke-width="3" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                    <path class="text-green-400" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="75, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                  </svg>
                  <div class="absolute inset-0 flex items-center justify-center">
                    <span class="text-2xl font-bold text-white">75%</span>
                  </div>
                </div>
              </div>
              <div class="text-center">
                <h3 class="text-lg font-semibold text-white">Daily Active</h3>
                <p class="text-sm text-green-400">Users online today</p>
              </div>
            </div>

            <!-- Counselor Approval Rate -->
            <div class="bg-gray-900 border border-green-900 rounded-xl shadow-sm p-6 card-hover">
              <div class="flex items-center justify-center mb-4">
                <div class="relative w-24 h-24">
                  <svg class="w-24 h-24 progress-circle" viewBox="0 0 36 36">
                    <path class="text-gray-700" stroke="currentColor" stroke-width="3" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                    <path class="text-green-500" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="85, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                  </svg>
                  <div class="absolute inset-0 flex items-center justify-center">
                    <span class="text-2xl font-bold text-white">85%</span>
                  </div>
                </div>
              </div>
              <div class="text-center">
                <h3 class="text-lg font-semibold text-white">Approval Rate</h3>
                <p class="text-sm text-green-400">Counselor approvals</p>
              </div>
            </div>

            <!-- Content Completion -->
            <div class="bg-gray-900 border border-green-900 rounded-xl shadow-sm p-6 card-hover">
              <div class="flex items-center justify-center mb-4">
                <div class="relative w-24 h-24">
                  <svg class="w-24 h-24 progress-circle" viewBox="0 0 36 36">
                    <path class="text-gray-700" stroke="currentColor" stroke-width="3" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                    <path class="text-green-300" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="60, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                  </svg>
                  <div class="absolute inset-0 flex items-center justify-center">
                    <span class="text-2xl font-bold text-white">60%</span>
                  </div>
                </div>
              </div>
              <div class="text-center">
                <h3 class="text-lg font-semibold text-white">Completion</h3>
                <p class="text-sm text-green-400">Reading finished</p>
              </div>
            </div>

            <!-- System Health -->
            <div class="bg-gray-900 border border-green-900 rounded-xl shadow-sm p-6 card-hover">
              <div class="flex items-center justify-center mb-4">
                <div class="relative w-24 h-24">
                  <svg class="w-24 h-24 progress-circle" viewBox="0 0 36 36">
                    <path class="text-gray-700" stroke="currentColor" stroke-width="3" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                    <path class="text-green-500" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="90, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                  </svg>
                  <div class="absolute inset-0 flex items-center justify-center">
                    <span class="text-2xl font-bold text-white">90%</span>
                  </div>
                </div>
              </div>
              <div class="text-center">
                <h3 class="text-lg font-semibold text-white">System Health</h3>
                <p class="text-sm text-green-400">Platform uptime</p>
              </div>
            </div>
          </div>

          <!-- Growth Metrics -->
            <div class="bg-gray-900 border border-green-900 rounded-xl shadow-sm p-6 card-hover">
              <h3 class="text-lg font-semibold text-white mb-4">Average Growth %</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div>
                  <div class="flex justify-between text-sm mb-1">
                    <span class="text-green-400">Users</span>
                    <span class="font-semibold text-white">25%</span>
                  </div>
                  <div class="w-full bg-gray-700 rounded-full h-2">
                    <div class="bg-green-400 h-2 rounded-full" style="width: 25%"></div>
                  </div>
                </div>
                
                <div>
                  <div class="flex justify-between text-sm mb-1">
                    <span class="text-green-400">Activities</span>
                    <span class="font-semibold text-white">70%</span>
                  </div>
                  <div class="w-full bg-gray-700 rounded-full h-2">
                    <div class="bg-green-500 h-2 rounded-full" style="width: 70%"></div>
                  </div>
                </div>
                
                <div>
                  <div class="flex justify-between text-sm mb-1">
                    <span class="text-green-400">Materials</span>
                    <span class="font-semibold text-white">50%</span>
                  </div>
                  <div class="w-full bg-gray-700 rounded-full h-2">
                    <div class="bg-green-600 h-2 rounded-full" style="width: 50%"></div>
                  </div>
                </div>
                
                <div>
                  <div class="flex justify-between text-sm mb-1">
                    <span class="text-green-400">Engagement</span>
                    <span class="font-semibold text-white">85%</span>
                  </div>
                  <div class="w-full bg-gray-700 rounded-full h-2">
                    <div class="bg-green-400 h-2 rounded-full" style="width: 85%"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <div id="showUsersBtn" class="mb-8">
          <button onclick="toggleSection('users')" class="w-full bg-gray-900 border border-green-900 rounded-xl shadow-sm p-6 hover:shadow-md hover:border-green-600 transition flex items-center justify-between card-hover">
            <div class="flex items-center space-x-3">
              <div class="w-12 h-12 rounded-full bg-green-900 flex items-center justify-center">
                <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                </svg>
              </div>
              <div class="text-left">
                <h3 class="text-xl font-bold text-white">User Management</h3>
                <p class="text-sm text-green-400">View all users and their activities</p>
              </div>
            </div>
            <div class="flex items-center space-x-3">
              <span class="bg-green-900 text-green-300 px-3 py-1 rounded-full text-sm font-semibold">{{stats.totalUsers}} Users</span>
              <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </button>
        </div>

        <!-- Regular Users Activity Monitoring (Hidden by default) -->
    <div id="users" class="bg-gray-900 border border-green-900 rounded-xl shadow-lg p-6 mb-8 hidden">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-bold text-white">Regular Users Activity</h3>
        <button onclick="toggleUserMonitoring()" id="toggleMonitoringBtn" 
                class="bg-green-700 hover:bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition">
          Hide User Activities
        </button>
      </div>
      
      <div id="userMonitoringSection">
      {{#each users}}
      <div class="border-2 border-gray-200 rounded-xl p-6 mb-6 hover:border-purple-300 transition">
        <!-- User Header -->
        <div class="flex items-start justify-between mb-4">
          <div class="flex items-center space-x-4">
            <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center text-white font-bold text-2xl">
              {{substring this.name 0 1}}
            </div>
            <div>
              <h4 class="text-xl font-bold text-white">{{this.name}}</h4>
              <p class="text-sm text-green-400">{{this.email}}</p>
              <div class="flex gap-3 mt-2 text-xs">
                {{#if this.progress}}
                <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded">Level {{this.progress.level}}</span>
                <span class="bg-green-900 text-green-300 px-2 py-1 rounded">?? {{this.progress.totalPoints}} pts</span>
                {{/if}}
                <span class="bg-gray-100 text-gray-800 px-2 py-1 rounded">
                  {{#if this.lastActive}}Last active: {{formatDate this.lastActive}}{{else}}Never{{/if}}
                </span>
              </div>
            </div>
          </div>
          <a href="/admin/users/{{this.id}}" class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 text-sm font-medium">
            View Details
          </a>
        </div>

        <!-- Activity Summary -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
          <div class="bg-purple-50 rounded-lg p-4">
            <div class="text-2xl mb-1"></div>
            <div class="text-2xl font-bold text-purple-600">{{this.gameSessions.length}}</div>
            <div class="text-xs text-gray-400">Games Played</div>
            {{#if this.totalGameTime}}
            <div class="text-xs text-gray-500 mt-1">{{formatDuration this.totalGameTime}}</div>
            {{/if}}
          </div>
          
          <div class="bg-pink-50 rounded-lg p-4">
            <div class="text-2xl mb-1"></div>
            <div class="text-2xl font-bold text-pink-600">{{this.journalEntries.length}}</div>
            <div class="text-xs text-gray-400">Journal Entries</div>
          </div>
          
          <div class="bg-orange-50 rounded-lg p-4">
            <div class="text-2xl mb-1"></div>
            <div class="text-2xl font-bold text-orange-600">{{this.readingSessions.length}}</div>
            <div class="text-xs text-gray-400">Reading Sessions</div>
            {{#if this.totalReadingTime}}
            <div class="text-xs text-gray-500 mt-1">{{formatDuration this.totalReadingTime}}</div>
            {{/if}}
          </div>
        </div>

        <!-- Recent Activities Toggle -->
        <button onclick="toggleUserActivities('user-{{this.id}}')" 
                class="w-full bg-gray-100 hover:bg-gray-200 text-gray-700 py-2 rounded-lg text-sm font-medium transition">
          Show Detailed Activities ?
        </button>

        <!-- Recent Activities (Hidden by default) -->
        <div id="user-{{this.id}}" class="hidden mt-4 space-y-3">
          
          <!-- Recent Games -->
          {{#if this.gameSessions.length}}
          <div class="bg-purple-50 rounded-lg p-4">
            <h5 class="font-bold text-purple-900 mb-3 flex items-center justify-between">
              <span>Recent Games ({{this.gameSessions.length}})</span>
              <span class="text-xs font-normal text-purple-700">Total: {{formatDuration this.totalGameTime}}</span>
            </h5>
            <div class="space-y-2">
              {{#each this.gameSessions}}
              <div class="bg-white rounded p-3 text-sm border-l-4 border-purple-400">
                <div class="flex justify-between items-start mb-1">
                  <div class="flex-1">
                    <div class="font-semibold text-purple-700">{{formatGameName this.gameType}}</div>
                    <div class="text-xs text-gray-600 mt-1 space-x-2">
                      {{#if this.score}}
                      <span class="inline-block bg-purple-100 px-2 py-0.5 rounded">Score: {{this.score}}</span>
                      {{/if}}
                      {{#if this.duration}}
                      <span class="inline-block bg-blue-100 px-2 py-0.5 rounded">{{formatDuration this.duration}}</span>
                      {{/if}}
                      {{#if this.difficulty}}
                      <span class="inline-block bg-yellow-100 px-2 py-0.5 rounded">{{this.difficulty}}</span>
                      {{/if}}
                      {{#if this.completed}}
                      <span class="inline-block bg-green-100 px-2 py-0.5 rounded">? Completed</span>
                      {{else}}
                      <span class="inline-block bg-gray-100 px-2 py-0.5 rounded">Incomplete</span>
                      {{/if}}
                    </div>
                  </div>
                  <span class="text-xs text-gray-500 ml-2">{{formatDate this.createdAt}}</span>
                </div>
              </div>
              {{/each}}
            </div>
          </div>
          {{else}}
          <div class="bg-purple-50 rounded-lg p-4 text-center text-purple-600">
            <div class="text-3xl mb-2"></div>
            <p class="text-sm">No games played yet</p>
          </div>
          {{/if}}

          <!-- Recent Journals -->
          {{#if this.journalEntries.length}}
          <div class="bg-pink-50 rounded-lg p-4">
            <h5 class="font-bold text-pink-900 mb-3 flex items-center justify-between">
              <span>Recent Journal Entries ({{this.journalEntries.length}})</span>
            </h5>
            <div class="space-y-2">
              {{#each this.journalEntries}}
              <div class="bg-white rounded p-3 text-sm border-l-4 border-pink-400">
                <div class="flex justify-between items-start mb-1">
                  <div class="flex-1">
                    <div class="font-semibold text-pink-700">{{this.title}}</div>
                    <div class="text-xs text-gray-600 mt-1 space-x-2">
                      <span class="inline-block bg-pink-100 px-2 py-0.5 rounded">Mood: {{this.mood}}</span>
                      {{#if this.wordCount}}
                      <span class="inline-block bg-blue-100 px-2 py-0.5 rounded">{{this.wordCount}} words</span>
                      {{/if}}
                      {{#if this.isPrivate}}
                      <span class="inline-block bg-gray-100 px-2 py-0.5 rounded">Private</span>
                      {{/if}}
                    </div>
                  </div>
                  <span class="text-xs text-gray-500 ml-2">{{formatDate this.createdAt}}</span>
                </div>
              </div>
              {{/each}}
            </div>
          </div>
          {{else}}
          <div class="bg-pink-50 rounded-lg p-4 text-center text-pink-600">
            <div class="text-3xl mb-2"></div>
            <p class="text-sm">No journal entries yet</p>
          </div>
          {{/if}}

          <!-- Recent Reading -->
          {{#if this.readingSessions.length}}
          <div class="bg-orange-50 rounded-lg p-4">
            <h5 class="font-bold text-orange-900 mb-3 flex items-center justify-between">
              <span>Recent Reading Sessions ({{this.readingSessions.length}})</span>
              <span class="text-xs font-normal text-orange-700">Total: {{formatDuration this.totalReadingTime}}</span>
            </h5>
            <div class="space-y-2">
              {{#each this.readingSessions}}
              <div class="bg-white rounded p-3 text-sm border-l-4 border-orange-400">
                <div class="flex justify-between items-start mb-1">
                  <div class="flex-1">
                    <div class="font-semibold text-orange-700">{{this.material.title}}</div>
                    <div class="text-xs text-gray-600 mt-1 space-x-2">
                      <span class="inline-block bg-orange-100 px-2 py-0.5 rounded">{{this.material.fileType}}</span>
                      {{#if this.duration}}
                      <span class="inline-block bg-blue-100 px-2 py-0.5 rounded">{{formatDuration this.duration}}</span>
                      {{/if}}
                      {{#if this.completed}}
                      <span class="inline-block bg-green-100 px-2 py-0.5 rounded">? Completed</span>
                      {{/if}}
                    </div>
                  </div>
                  <span class="text-xs text-gray-500 ml-2">{{formatDate this.createdAt}}</span>
                </div>
              </div>
              {{/each}}
            </div>
          </div>
          {{else}}
          <div class="bg-orange-50 rounded-lg p-4 text-center text-orange-600">
            <div class="text-3xl mb-2"></div>
            <p class="text-sm">No reading sessions yet</p>
          </div>
          {{/if}}

        </div>
      </div>
      {{else}}
      <div class="text-center text-gray-500 py-12">
        <div class="text-6xl mb-4"></div>
        <p class="text-lg">No users yet</p>
      </div>
      {{/each}}
    </div>
    </div>

    <!-- Show Counselors Button -->
    <div id="showCounselorsBtn" class="mb-8">
      <button onclick="toggleSection('counselors')" class="w-full bg-gray-900 border border-green-900 rounded-xl shadow-sm p-6 hover:shadow-md hover:border-green-600 transition flex items-center justify-between card-hover">
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 rounded-full bg-green-900 flex items-center justify-center">
            <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div class="text-left">
            <h3 class="text-xl font-bold text-white">Counselor Management</h3>
            <p class="text-sm text-green-400">Manage counselor accounts and approvals</p>
          </div>
        </div>
        <div class="flex items-center space-x-3">
          {{#if pendingCounselors.length}}
          <span class="bg-yellow-900 text-yellow-300 px-3 py-1 rounded-full text-sm font-semibold">{{pendingCounselors.length}} Pending</span>
          {{/if}}
          <span class="bg-green-900 text-green-300 px-3 py-1 rounded-full text-sm font-semibold">{{approvedCounselors.length}} Active</span>
          <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </div>
      </button>
    </div>

    <!-- Counselors Activity Monitoring (Hidden by default) -->
    <div id="counselors" class="bg-gray-900 border border-green-900 rounded-xl shadow-lg p-6 mb-8 hidden">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-bold text-white">Counselors Activity</h3>
        <button onclick="toggleCounselorMonitoring()" id="toggleCounselorBtn" 
                class="bg-green-700 hover:bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition">
          Hide Counselor Activities ?
        </button>
      </div>

      <!-- Pending Counselors Approval Section -->
      {{#if pendingCounselors.length}}
      <div class="mb-6">
        <div class="bg-yellow-950 border border-yellow-800 rounded-xl p-4 mb-4">
          <h4 class="font-bold text-yellow-300 text-lg mb-1">? Pending Approval ({{pendingCounselors.length}})</h4>
          <p class="text-sm text-yellow-400">These counselors are waiting for your approval before they can login.</p>
        </div>
        {{#each pendingCounselors}}
        <div class="border-2 border-yellow-700 bg-yellow-950 rounded-xl p-5 mb-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
              <div class="w-14 h-14 bg-yellow-800 rounded-full flex items-center justify-center text-white font-bold text-xl">
                {{substring this.name 0 1}}
              </div>
              <div>
                <h4 class="text-lg font-bold text-gray-900">{{this.name}}</h4>
                <p class="text-sm text-green-400">{{this.email}}</p>
                <div class="flex gap-2 mt-1">
                  <span class="text-xs bg-yellow-900 text-yellow-300 px-2 py-1 rounded-full font-medium">Pending Approval</span>
                  <span class="text-xs text-gray-500">Registered: {{formatDate this.createdAt}}</span>
                </div>
              </div>
            </div>
            <div class="flex items-center space-x-3">
              <button onclick="approveCounselor('{{this.id}}')" class="bg-green-600 hover:bg-green-700 text-white px-5 py-2 rounded-lg text-sm font-medium transition flex items-center space-x-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Approve</span>
              </button>
              <button onclick="rejectCounselor('{{this.id}}')" class="bg-red-600 hover:bg-red-700 text-white px-5 py-2 rounded-lg text-sm font-medium transition flex items-center space-x-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                <span>Reject</span>
              </button>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
      {{/if}}
      
      <div id="counselorMonitoringSection">
      {{#each counselors}}
      <div class="border-2 border-green-900 rounded-xl p-6 mb-6 hover:border-green-600 transition">
        <!-- Counselor Header -->
        <div class="flex items-start justify-between mb-4">
          <div class="flex items-center space-x-4">
            <div class="w-16 h-16 bg-green-800 rounded-full flex items-center justify-center text-white font-bold text-2xl">
              {{substring this.name 0 1}}
            </div>
            <div>
              <h4 class="text-xl font-bold text-white">{{this.name}}</h4>
              <p class="text-sm text-green-400">{{this.email}}</p>
              <div class="flex gap-3 mt-2 text-xs">
                <span class="bg-green-900 text-green-300 px-2 py-1 rounded">Counselor</span>
                <span class="bg-gray-100 text-gray-800 px-2 py-1 rounded">
                  {{#if this.lastActive}}Last active: {{formatDate this.lastActive}}{{else}}Never{{/if}}
                </span>
              </div>
            </div>
          </div>
          <a href="/admin/users/{{this.id}}" class="bg-green-700 text-white px-4 py-2 rounded-lg hover:bg-green-600 text-sm font-medium">
            View Details
          </a>
        </div>

        <!-- Activity Summary -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
          <div class="bg-green-950 border border-green-800 rounded-lg p-4">
            <div class="text-2xl mb-1"></div>
            <div class="text-2xl font-bold text-green-400">{{this.gameSessions.length}}</div>
            <div class="text-xs text-gray-400">Games Played</div>
            {{#if this.totalGameTime}}
            <div class="text-xs text-gray-500 mt-1">{{formatDuration this.totalGameTime}}</div>
            {{/if}}
          </div>
          
          <div class="bg-black border border-green-900 rounded-lg p-4">
            <div class="text-2xl mb-1"></div>
            <div class="text-2xl font-bold text-green-300">{{this.journalEntries.length}}</div>
            <div class="text-xs text-gray-400">Journal Entries</div>
          </div>
          
          <div class="bg-green-950 border border-green-800 rounded-lg p-4">
            <div class="text-2xl mb-1"></div>
            <div class="text-2xl font-bold text-green-400">{{this.readingSessions.length}}</div>
            <div class="text-xs text-gray-400">Reading Sessions</div>
            {{#if this.totalReadingTime}}
            <div class="text-xs text-gray-500 mt-1">{{formatDuration this.totalReadingTime}}</div>
            {{/if}}
          </div>
        </div>
      </div>
      {{else}}
      <div class="text-center text-gray-500 py-12">
        <div class="text-6xl mb-4"></div>
        <p class="text-lg">No counselors yet</p>
      </div>
      {{/each}}
    </div>
    </div>

    <!-- Show Materials Button -->
    <div id="showMaterialsBtn" class="mb-8">
      <button onclick="toggleSection('materials')" class="w-full bg-gray-900 border border-green-900 rounded-xl shadow-sm p-6 hover:shadow-md hover:border-green-600 transition flex items-center justify-between card-hover">
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 rounded-full bg-green-900 flex items-center justify-center">
            <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <div class="text-left">
            <h3 class="text-xl font-bold text-white">Reading Materials</h3>
            <p class="text-sm text-green-400">View all uploaded materials by counselors</p>
          </div>
        </div>
        <div class="flex items-center space-x-3">
          <span class="bg-green-900 text-green-300 px-3 py-1 rounded-full text-sm font-semibold">{{stats.totalMaterials}} Materials</span>
          <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </div>
      </button>
    </div>

    <!-- Materials Section (Hidden by default) -->
    <div id="materials" class="bg-gray-900 border border-green-900 rounded-xl shadow-lg p-6 mb-8 hidden">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-bold text-white">Reading Materials</h3>
        <button onclick="toggleSection('materials')" class="bg-green-700 hover:bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition">
          Hide Materials
        </button>
      </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {{#each materials}}
        <div class="border-2 border-green-900 rounded-xl p-4 hover:border-green-600 transition card-hover bg-gray-800">
          <div class="flex items-start space-x-3">
            <div class="text-4xl">
              {{#if (eq this.fileType 'pdf')}}
              <svg class="w-12 h-12 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"></path>
              </svg>
              {{else if (eq this.fileType 'doc')}}
              <svg class="w-12 h-12 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"></path>
              </svg>
              {{else if (eq this.fileType 'docx')}}
              <svg class="w-12 h-12 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"></path>
              </svg>
              {{else}}
              <svg class="w-12 h-12 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"></path>
              </svg>
              {{/if}}
            </div>
            <div class="flex-1">
              <h4 class="font-semibold text-white line-clamp-2 mb-1">{{this.title}}</h4>
              <p class="text-sm text-green-400 mb-2">By {{this.counselor.name}}</p>
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs bg-green-900 text-green-300 px-2 py-1 rounded">{{this.category}}</span>
                <span class="text-xs text-gray-400">{{this.views}} views</span>
                {{#if this.isPublished}}
                <span class="text-xs bg-green-900 text-green-300 px-2 py-1 rounded">Published</span>
                {{else}}
                <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">Draft</span>
                {{/if}}
              </div>
              <div class="mt-3">
                <a href="/reading/view/{{this.id}}" target="_blank" class="text-xs bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700 inline-block">
                  View Material
                </a>
              </div>
            </div>
          </div>
        </div>
        {{else}}
        <div class="col-span-full text-center text-gray-500 py-12">
          <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          <p class="text-lg">No materials uploaded yet</p>
        </div>
        {{/each}}
      </div>
    </div>

    <!-- System-Wide Activity Timeline -->
    <div id="activity-timeline" class="bg-gray-900 border border-green-900 rounded-xl shadow-lg p-6 mb-8">
      <h3 class="text-xl font-bold text-white mb-6">System-Wide Activity Timeline</h3>
      
      <!-- Activity Tabs -->
      <div class="flex flex-wrap gap-2 mb-6 border-b border-green-900">
        <button onclick="showActivityTab('all')" id="tab-all" class="activity-tab px-4 py-2 font-medium text-green-400 border-b-2 border-green-500">
          All Activities
        </button>
        <button onclick="showActivityTab('games')" id="tab-games" class="activity-tab px-4 py-2 font-medium text-gray-400 hover:text-green-400">
          ?? Games
        </button>
        <button onclick="showActivityTab('journals')" id="tab-journals" class="activity-tab px-4 py-2 font-medium text-gray-400 hover:text-green-400">
          ?? Journals
        </button>
        <button onclick="showActivityTab('reading')" id="tab-reading" class="activity-tab px-4 py-2 font-medium text-gray-400 hover:text-green-400">
          ?? Reading
        </button>
        <button onclick="showActivityTab('fitness')" id="tab-fitness" class="activity-tab px-4 py-2 font-medium text-gray-400 hover:text-green-400">
          ?? Fitness
        </button>
      </div>

      <!-- All Activities -->
      <div id="activity-all" class="activity-content">
        <div class="space-y-3 max-h-96 overflow-y-auto">
          {{#each recentGameSessions}}
          <div class="bg-green-950 rounded-lg p-4 border-l-4 border-green-600">
            <div class="flex items-start justify-between">
              <div class="flex items-start space-x-3">
                <div class="text-2xl">??</div>
                <div>
                  <div class="font-semibold text-white">{{this.User.name}} played {{formatGameName this.gameType}}</div>
                  <div class="text-sm text-green-400 mt-1">
                    {{#if this.score}}Score: {{this.score}} {{/if}}
                    {{#if this.duration}}Duration: {{formatDuration this.duration}} {{/if}}
                    {{#if this.completed}}? Completed{{else}}Incomplete{{/if}}
                  </div>
                </div>
              </div>
              <span class="text-xs text-gray-500 flex-shrink-0 ml-2">{{formatDate this.createdAt}}</span>
            </div>
          </div>
          {{/each}}
          {{#each recentJournals}}
          <div class="bg-gray-800 rounded-lg p-4 border-l-4 border-green-700">
            <div class="flex items-start justify-between">
              <div class="flex items-start space-x-3">
                <div class="text-2xl">??</div>
                <div>
                  <div class="font-semibold text-white">{{this.User.name}} wrote a journal entry</div>
                  <div class="text-sm text-green-400 mt-1">"{{this.title}}" ? Mood: {{this.mood}}</div>
                </div>
              </div>
              <span class="text-xs text-gray-500 flex-shrink-0 ml-2">{{formatDate this.createdAt}}</span>
            </div>
          </div>
          {{/each}}
          {{#each recentReading}}
          <div class="bg-black rounded-lg p-4 border-l-4 border-green-500">
            <div class="flex items-start justify-between">
              <div class="flex items-start space-x-3">
                <div class="text-2xl">??</div>
                <div>
                  <div class="font-semibold text-white">{{this.User.name}} read "{{this.material.title}}"</div>
                  <div class="text-sm text-green-400 mt-1">{{this.material.fileType}}{{#if this.duration}} ? {{formatDuration this.duration}}{{/if}}{{#if this.completed}} ? ? Completed{{/if}}</div>
                </div>
              </div>
              <span class="text-xs text-gray-500 flex-shrink-0 ml-2">{{formatDate this.createdAt}}</span>
            </div>
          </div>
          {{/each}}
          {{#each recentFitness}}
          <div class="bg-green-950 rounded-lg p-4 border-l-4 border-green-400">
            <div class="flex items-start justify-between">
              <div class="flex items-start space-x-3">
                <div class="text-2xl">??</div>
                <div>
                  <div class="font-semibold text-white">{{this.User.name}} watched a fitness video</div>
                  <div class="text-sm text-green-400 mt-1">{{this.description}}</div>
                </div>
              </div>
              <span class="text-xs text-gray-500 flex-shrink-0 ml-2">{{formatDate this.createdAt}}</span>
            </div>
          </div>
          {{/each}}
        </div>
      </div>

      <!-- Games Only -->
      <div id="activity-games" class="activity-content hidden">
        <div class="space-y-3 max-h-96 overflow-y-auto">
          {{#each recentGameSessions}}
          <div class="bg-green-950 rounded-lg p-4 border-l-4 border-green-600">
            <div class="flex items-start justify-between">
              <div class="flex items-start space-x-3">
                <div class="text-2xl">??</div>
                <div>
                  <div class="font-semibold text-white">{{this.User.name}} played {{formatGameName this.gameType}}</div>
                  <div class="text-sm text-green-400 mt-1">
                    {{#if this.score}}Score: {{this.score}} {{/if}}
                    {{#if this.duration}}Duration: {{formatDuration this.duration}} {{/if}}
                    Difficulty: {{this.difficulty}} {{#if this.completed}}? Completed{{else}}Incomplete{{/if}}
                  </div>
                </div>
              </div>
              <span class="text-xs text-gray-500 flex-shrink-0 ml-2">{{formatDate this.createdAt}}</span>
            </div>
          </div>
          {{else}}
          <div class="text-center text-gray-500 py-8"><div class="text-4xl mb-2">??</div><p>No game sessions yet</p></div>
          {{/each}}
        </div>
      </div>

      <!-- Journals Only -->
      <div id="activity-journals" class="activity-content hidden">
        <div class="space-y-3 max-h-96 overflow-y-auto">
          {{#each recentJournals}}
          <div class="bg-gray-800 rounded-lg p-4 border-l-4 border-green-700">
            <div class="flex items-start justify-between">
              <div class="flex items-start space-x-3">
                <div class="text-2xl">??</div>
                <div>
                  <div class="font-semibold text-white">{{this.User.name}} wrote a journal entry</div>
                  <div class="text-sm text-green-400 mt-1">"{{this.title}}" ? Mood: {{this.mood}}{{#if this.wordCount}} ? {{this.wordCount}} words{{/if}}</div>
                </div>
              </div>
              <span class="text-xs text-gray-500 flex-shrink-0 ml-2">{{formatDate this.createdAt}}</span>
            </div>
          </div>
          {{else}}
          <div class="text-center text-gray-500 py-8"><div class="text-4xl mb-2">??</div><p>No journal entries yet</p></div>
          {{/each}}
        </div>
      </div>

      <!-- Reading Only -->
      <div id="activity-reading" class="activity-content hidden">
        <div class="space-y-3 max-h-96 overflow-y-auto">
          {{#each recentReading}}
          <div class="bg-black rounded-lg p-4 border-l-4 border-green-500">
            <div class="flex items-start justify-between">
              <div class="flex items-start space-x-3">
                <div class="text-2xl">??</div>
                <div>
                  <div class="font-semibold text-white">{{this.User.name}} read "{{this.material.title}}"</div>
                  <div class="text-sm text-green-400 mt-1">{{this.material.fileType}}{{#if this.duration}} ? {{formatDuration this.duration}}{{/if}}{{#if this.completed}} ? ? Completed{{/if}}</div>
                </div>
              </div>
              <span class="text-xs text-gray-500 flex-shrink-0 ml-2">{{formatDate this.createdAt}}</span>
            </div>
          </div>
          {{else}}
          <div class="text-center text-gray-500 py-8"><div class="text-4xl mb-2">??</div><p>No reading sessions yet</p></div>
          {{/each}}
        </div>
      </div>

      <!-- Fitness Only -->
      <div id="activity-fitness" class="activity-content hidden">
        <div class="space-y-3 max-h-96 overflow-y-auto">
          {{#each recentFitness}}
          <div class="bg-green-950 rounded-lg p-4 border-l-4 border-green-400">
            <div class="flex items-start justify-between">
              <div class="flex items-start space-x-3">
                <div class="text-2xl">??</div>
                <div>
                  <div class="font-semibold text-white">{{this.User.name}}</div>
                  <div class="text-sm text-green-400 mt-1">{{this.description}}</div>
                  {{#if this.metadata.category}}
                  <span class="inline-block mt-1 text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full capitalize">{{this.metadata.category}}</span>
                  {{/if}}
                </div>
              </div>
              <span class="text-xs text-gray-500 flex-shrink-0 ml-2">{{formatDate this.createdAt}}</span>
            </div>
          </div>
          {{else}}
          <div class="text-center text-gray-500 py-8"><div class="text-4xl mb-2">??</div><p>No fitness activities yet</p></div>
          {{/each}}
        </div>
      </div>
    </div>

  </div>
  </main>
  </div>

  <script>
    // -- Sidebar state -------------------------------------------------------
    // Start hidden by default; user hovers left edge or clicks hamburger to show
    let sidebarPinned = false; // true = manually pinned open via hamburger
    let hideTimer = null;

    function hideSidebar() {
      const sidebar = document.getElementById('adminSidebar');
      const mainContent = document.getElementById('mainContent');
      const icon = document.getElementById('hamburgerIcon');
      if (!sidebar.classList.contains('-translate-x-full')) {
        sidebar.classList.add('-translate-x-full');
        mainContent.classList.add('sidebar-hidden');
        icon.classList.add('is-open');
      }
    }

    function showSidebar() {
      const sidebar = document.getElementById('adminSidebar');
      const mainContent = document.getElementById('mainContent');
      const icon = document.getElementById('hamburgerIcon');
      if (sidebar.classList.contains('-translate-x-full')) {
        sidebar.classList.remove('-translate-x-full');
        mainContent.classList.remove('sidebar-hidden');
        icon.classList.remove('is-open');
      }
    }

    // -- Mouse-edge hover: show when cursor near left edge ------------------
    document.addEventListener('mousemove', (e) => {
      if (sidebarPinned) return; // hamburger-pinned, don't auto-manage

      if (e.clientX <= 20) {
        // Cursor within 20px of left edge ? show sidebar
        clearTimeout(hideTimer);
        showSidebar();
      } else {
        const sidebar = document.getElementById('adminSidebar');
        const sidebarWidth = 256; // 16rem = 256px
        if (e.clientX > sidebarWidth + 20) {
          // Cursor moved well past the sidebar ? hide after short delay
          clearTimeout(hideTimer);
          hideTimer = setTimeout(hideSidebar, 300);
        } else {
          // Cursor still over sidebar ? cancel any pending hide
          clearTimeout(hideTimer);
        }
      }
    });

    // -- Manual toggle (hamburger button) -----------------------------------
    function toggleSidebar() {
      const sidebar = document.getElementById('adminSidebar');
      const mainContent = document.getElementById('mainContent');
      const icon = document.getElementById('hamburgerIcon');

      if (sidebar.classList.contains('-translate-x-full')) {
        showSidebar();
        sidebarPinned = true;  // pin it open
      } else {
        hideSidebar();
        sidebarPinned = false; // unpin so hover can manage it again
      }
    }

    // Hide sidebar on page load (collapsed by default)
    document.addEventListener('DOMContentLoaded', () => {
      hideSidebar();
    });

    // Smooth scroll to section and show/hide sections
    function scrollToSection(sectionId) {
      event.preventDefault();
      
      // For users, counselors, and materials - toggle their visibility
      if (sectionId === 'users') {
        const showBtn = document.getElementById('showUsersBtn');
        const section = document.getElementById('users');
        if (showBtn) showBtn.classList.add('hidden');
        if (section) section.classList.remove('hidden');
      } else if (sectionId === 'counselors') {
        const showBtn = document.getElementById('showCounselorsBtn');
        const section = document.getElementById('counselors');
        if (showBtn) showBtn.classList.add('hidden');
        if (section) section.classList.remove('hidden');
      } else if (sectionId === 'materials') {
        const showBtn = document.getElementById('showMaterialsBtn');
        const section = document.getElementById('materials');
        if (showBtn) showBtn.classList.add('hidden');
        if (section) section.classList.remove('hidden');
      }
      
      // Scroll to the section
      const element = document.getElementById(sectionId);
      if (element) {
        element.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Toggle entire user monitoring section
    function toggleUserMonitoring() {
      const section = document.getElementById('userMonitoringSection');
      const button = document.getElementById('toggleMonitoringBtn');
      
      if (section.classList.contains('hidden')) {
        section.classList.remove('hidden');
        button.textContent = 'Hide User Activities';
        button.classList.remove('bg-green-600', 'hover:bg-green-700');
        button.classList.add('bg-purple-600', 'hover:bg-purple-700');
      } else {
        section.classList.add('hidden');
        button.textContent = 'Show User Activities';
        button.classList.remove('bg-purple-600', 'hover:bg-purple-700');
        button.classList.add('bg-green-600', 'hover:bg-green-700');
      }
    }

    // Toggle entire counselor monitoring section
    function toggleCounselorMonitoring() {
      const section = document.getElementById('counselorMonitoringSection');
      const button = document.getElementById('toggleCounselorBtn');
      
      if (section.classList.contains('hidden')) {
        section.classList.remove('hidden');
        button.textContent = 'Hide Counselor Activities ?';
        button.classList.remove('bg-green-600', 'hover:bg-green-700');
        button.classList.add('bg-blue-600', 'hover:bg-blue-700');
      } else {
        section.classList.add('hidden');
        button.textContent = 'Show Counselor Activities ?';
        button.classList.remove('bg-blue-600', 'hover:bg-blue-700');
        button.classList.add('bg-green-600', 'hover:bg-green-700');
      }
    }

    // Toggle user activities
    function toggleUserActivities(userId) {
      const element = document.getElementById(userId);
      const button = event.target;
      
      if (element.classList.contains('hidden')) {
        element.classList.remove('hidden');
        button.textContent = 'Hide Activities ?';
      } else {
        element.classList.add('hidden');
        button.textContent = 'Show Detailed Activities ?';
      }
    }

    // Activity tab switching
    function showActivityTab(tabName) {
      // Hide all activity contents
      document.querySelectorAll('.activity-content').forEach(content => {
        content.classList.add('hidden');
      });
      
      // Remove active state from all tabs
      document.querySelectorAll('.activity-tab').forEach(tab => {
        tab.classList.remove('text-green-400', 'border-b-2', 'border-green-500');
        tab.classList.add('text-gray-400');
      });
      
      // Show selected content
      document.getElementById('activity-' + tabName).classList.remove('hidden');
      
      // Activate selected tab
      const activeTab = document.getElementById('tab-' + tabName);
      activeTab.classList.remove('text-gray-400');
      activeTab.classList.add('text-green-400', 'border-b-2', 'border-green-500');
    }

    // Counselor approval functions
    async function approveCounselor(userId) {
      if (!confirm('Approve this counselor account?')) return;
      
      try {
        const response = await fetch(`/admin/counselor/approve/${userId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        
        if (response.ok) {
          alert('? Counselor approved!');
          location.reload();
        } else {
          alert('? Error approving counselor');
        }
      } catch (error) {
        alert('? Failed to approve counselor');
      }
    }

    async function rejectCounselor(userId) {
      const reason = prompt('Reason for rejection (optional):');
      if (reason === null) return;
      
      try {
        const response = await fetch(`/admin/counselor/reject/${userId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason: reason || 'No reason provided' })
        });
        
        if (response.ok) {
          alert('? Counselor rejected');
          location.reload();
        } else {
          alert('? Error rejecting counselor');
        }
      } catch (error) {
        alert('? Failed to reject counselor');
      }
    }

    // Toggle section visibility (for Users and Counselors)
    function toggleSection(sectionId) {
      const section = document.getElementById(sectionId);
      const showBtn = document.getElementById('show' + sectionId.charAt(0).toUpperCase() + sectionId.slice(1) + 'Btn');
      
      if (section.classList.contains('hidden')) {
        section.classList.remove('hidden');
        if (showBtn) showBtn.classList.add('hidden');
      } else {
        section.classList.add('hidden');
        if (showBtn) showBtn.classList.remove('hidden');
      }
    }

    // Toggle System Status Modal
    function toggleSystemStatus() {
      const modal = document.getElementById('systemStatusModal');
      modal.classList.toggle('hidden');
    }

    // Close modal when clicking outside
    document.getElementById('systemStatusModal')?.addEventListener('click', function(e) {
      if (e.target === this) {
        toggleSystemStatus();
      }
    });

    // Toggle Notifications Dropdown
    function toggleNotifications() {
      const dropdown = document.getElementById('notificationDropdown');
      dropdown.classList.toggle('hidden');
    }

    // Close notifications when clicking outside
    document.addEventListener('click', function(e) {
      const dropdown = document.getElementById('notificationDropdown');
      const button = e.target.closest('button[onclick="toggleNotifications()"]');
      
      if (!dropdown.contains(e.target) && !button) {
        dropdown.classList.add('hidden');
      }
    });

    // Clear notifications
    function clearNotifications() {
      alert('All notifications marked as read!');
      document.getElementById('notificationDropdown').classList.add('hidden');
      // You can add AJAX call here to mark notifications as read in database
    }

  </script>

  <!-- Left-edge hover trigger strip -->
  <div id="sidebarEdgeTrigger"
       style="position:fixed;top:64px;left:0;width:6px;height:calc(100vh - 64px);z-index:50;cursor:e-resize;"
       onmouseenter="if(!sidebarPinned) showSidebar()">
  </div>

</body>
</html>

