<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .chat-bubble-sent {
      background: linear-gradient(135deg, #7c3aed, #6d28d9);
      border-radius: 18px 18px 4px 18px;
    }
    .chat-bubble-received {
      background: #f3f4f6;
      border-radius: 18px 18px 18px 4px;
    }
    #chatMessages { scroll-behavior: smooth; }
    .contact-card.active { background: #f5f3ff; border-color: #7c3aed; }
    .unread-dot { width:10px;height:10px;background:#7c3aed;border-radius:50%;flex-shrink:0; }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">

  <nav class="bg-white border-b border-gray-200 shadow-sm p-4 sticky top-0 z-30">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <a href="/admin/dashboard" class="text-gray-500 hover:text-purple-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </a>
        <h1 class="text-xl font-bold text-purple-700">💬 Messages</h1>
      </div>
      <div class="flex items-center space-x-3">
        <span class="text-gray-700 text-sm font-medium">{{user.name}}</span>
        <a href="/logout" class="text-gray-500 hover:text-gray-700 text-sm">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-4 h-[calc(100vh-72px)] flex gap-4">

    <!-- Left: Counselor List -->
    <div class="w-80 flex-shrink-0 bg-white rounded-xl shadow-sm border border-gray-200 flex flex-col">
      <div class="p-4 border-b border-gray-100">
        <h2 class="font-bold text-gray-800 mb-1">Counselors</h2>
        <p class="text-xs text-gray-400 mb-3">Messages from counselors</p>
        <input type="text" id="searchInput" placeholder="Search counselors..."
               oninput="filterContacts(this.value)"
               class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-purple-400">
      </div>
      <div id="contactList" class="flex-1 overflow-y-auto p-2 space-y-1">
        {{#each counselors}}
        <div class="contact-card border-2 border-transparent rounded-xl p-3 cursor-pointer hover:bg-purple-50 transition"
             data-userid="{{this.id}}"
             data-name="{{this.name}}"
             onclick="openChat({{this.id}}, '{{this.name}}')">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white font-bold flex-shrink-0">
              {{substring this.name 0 1}}
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-gray-800 text-sm truncate">{{this.name}}</div>
              <div class="text-xs text-emerald-600 font-medium">Counselor</div>
            </div>
            {{#if this.unreadCount}}
            <div class="unread-dot"></div>
            {{/if}}
          </div>
        </div>
        {{else}}
        <div class="text-center text-gray-400 py-8 text-sm px-4">
          <div class="text-4xl mb-2">👨‍💼</div>
          <p>No counselors yet</p>
        </div>
        {{/each}}
      </div>
    </div>

    <!-- Right: Chat Area -->
    <div class="flex-1 bg-white rounded-xl shadow-sm border border-gray-200 flex flex-col">
      <div class="p-4 border-b border-gray-100 flex items-center space-x-3">
        <div id="chatAvatar" class="w-10 h-10 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 items-center justify-center text-white font-bold hidden flex"></div>
        <div>
          <div id="chatName" class="font-bold text-gray-800">Select a counselor to start chatting</div>
          <div id="chatStatus" class="text-xs text-gray-400"></div>
        </div>
      </div>

      <div id="chatMessages" class="flex-1 overflow-y-auto p-4 space-y-3">
        <div id="emptyState" class="flex flex-col items-center justify-center h-full text-gray-400">
          <div class="text-6xl mb-4">💬</div>
          <p class="text-lg font-medium">No conversation selected</p>
          <p class="text-sm">Choose a counselor from the list</p>
        </div>
      </div>

      <div id="messageInputArea" class="p-4 border-t border-gray-100 hidden">
        <div class="flex items-end space-x-3">
          <textarea id="messageInput" placeholder="Type your message..." rows="1"
                    onkeydown="handleEnter(event)" oninput="autoResize(this)"
                    class="flex-1 px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-purple-400 resize-none max-h-32"></textarea>
          <button onclick="sendMessage()"
                  class="bg-purple-600 hover:bg-purple-700 text-white p-3 rounded-xl transition flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentCounselorId = null;
    let pollInterval = null;

    async function openChat(counselorId, counselorName) {
      currentCounselorId = counselorId;
      document.getElementById('chatName').textContent = counselorName;
      document.getElementById('chatStatus').textContent = 'Counselor';
      const avatar = document.getElementById('chatAvatar');
      avatar.textContent = counselorName.charAt(0).toUpperCase();
      avatar.classList.remove('hidden');
      avatar.classList.add('flex');
      document.getElementById('messageInputArea').classList.remove('hidden');
      document.getElementById('emptyState').classList.add('hidden');

      document.querySelectorAll('.contact-card').forEach(c => c.classList.remove('active'));
      const card = document.querySelector(`[data-userid="${counselorId}"]`);
      if (card) card.classList.add('active');

      await loadMessages();
      if (pollInterval) clearInterval(pollInterval);
      pollInterval = setInterval(loadMessages, 3000);
    }

    async function loadMessages() {
      if (!currentCounselorId) return;
      try {
        const res = await fetch(`/admin/messages/${currentCounselorId}/json`);
        const messages = await res.json();
        renderMessages(messages);
      } catch (e) { console.error(e); }
    }

    function renderMessages(messages) {
      const container = document.getElementById('chatMessages');
      if (!messages.length) {
        container.innerHTML = `<div class="flex flex-col items-center justify-center h-full text-gray-400"><div class="text-5xl mb-3">👋</div><p class="text-sm">No messages yet. Say hello!</p></div>`;
        return;
      }
      const adminId = {{user.id}};
      container.innerHTML = messages.map(msg => {
        const isSent = msg.senderId === adminId;
        const time = new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        return `<div class="flex ${isSent ? 'justify-end' : 'justify-start'}">
          <div class="max-w-xs lg:max-w-md">
            <div class="${isSent ? 'chat-bubble-sent text-white' : 'chat-bubble-received text-gray-800'} px-4 py-2 text-sm">${escapeHtml(msg.content)}</div>
            <div class="text-xs text-gray-400 mt-1 ${isSent ? 'text-right' : 'text-left'}">${time}</div>
          </div>
        </div>`;
      }).join('');
      container.scrollTop = container.scrollHeight;
    }

    async function sendMessage() {
      const input = document.getElementById('messageInput');
      const content = input.value.trim();
      if (!content || !currentCounselorId) return;
      input.value = ''; input.style.height = 'auto';
      try {
        await fetch(`/admin/messages/${currentCounselorId}/send`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content })
        });
        await loadMessages();
      } catch (e) { console.error(e); }
    }

    function handleEnter(e) {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
    }
    function autoResize(el) {
      el.style.height = 'auto';
      el.style.height = Math.min(el.scrollHeight, 128) + 'px';
    }
    function filterContacts(q) {
      q = q.toLowerCase();
      document.querySelectorAll('.contact-card').forEach(c => {
        c.style.display = c.dataset.name.toLowerCase().includes(q) ? '' : 'none';
      });
    }
    function escapeHtml(s) {
      return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
  </script>
</body>
</html>
