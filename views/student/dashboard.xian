{{> head}}
<div class="flex h-screen overflow-hidden">
  {{> sidebar-student activePage="Home"}}

  <div class="flex-1 overflow-y-auto bg-slate-100">
    <div class="nav-top">
      <div>
        <h1 class="text-base font-bold text-slate-800">UniGuid Student Home</h1>
        <p class="text-gray-600 text-xs">Good Moral Certificate Application Portal</p>
      </div>
    </div>

    <div class="px-6 py-5">
      {{> flash}}

      <!-- Welcome Banner -->
      <div class="card mb-5 flex items-center gap-4" style="background:linear-gradient(135deg,#e8f5ee,#f0fdf4);border-color:#86efac">
        <div class="w-14 h-14 rounded-full bg-green-800 flex items-center justify-center text-2xl shrink-0">🎓</div>
        <div>
          <h2 class="text-slate-800 font-bold text-lg">Welcome, {{user.firstName}}!</h2>
          <p class="text-teal-700 text-sm font-medium">Track your Good Moral Certificate requests below.</p>
          {{#if user.course}}<p class="text-gray-500 text-xs mt-0.5">{{user.course}} {{user.yearLevel}} — {{user.studentId}}</p>{{/if}}
        </div>
      </div>

      <!-- Stat Cards -->
      <div class="grid grid-cols-3 gap-4 mb-6">
        <div class="card flex items-center gap-4">
          <div class="w-11 h-11 rounded-xl bg-green-100 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <div>
            <p class="text-xl font-bold text-slate-800">{{applications.length}}</p>
            <p class="text-slate-700 text-sm font-semibold">Total Requests</p>
          </div>
        </div>
        <div class="card flex items-center gap-4">
          <div class="w-11 h-11 rounded-xl bg-yellow-100 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <p class="text-xl font-bold text-yellow-600">{{activeCount}}</p>
            <p class="text-slate-700 text-sm font-semibold">In Progress</p>
          </div>
        </div>
        <div class="card flex items-center gap-4">
          <div class="w-11 h-11 rounded-xl bg-green-100 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <p class="text-xl font-bold text-green-700">{{releasedCount}}</p>
            <p class="text-slate-700 text-sm font-semibold">Released</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</body></html>
