{{> head}}
<div class="flex h-screen overflow-hidden">
  {{> sidebar-student activePage="announcements"}}

  <div class="flex-1 overflow-y-auto bg-slate-100">
    <div class="nav-top">
      <div>
        <h1 class="text-base font-bold text-slate-800">📢 Announcements</h1>
        <p class="text-gray-600 text-xs">Latest news and updates from Guidance Office</p>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-5 py-6">
      {{> flash}}

      {{#if announcements.length}}
      <div class="space-y-4">
        {{#each announcements}}
        <div class="card">
          <div class="flex items-start justify-between mb-3">
            <div class="flex items-center gap-2">
              <span class="text-2xl">
                {{#if (eq this.type 'event')}}📅
                {{else if (eq this.type 'general')}}📣
                {{else if (eq this.type 'urgent')}}🚨
                {{else}}📢{{/if}}
              </span>
              <div>
                <h3 class="text-slate-800 font-bold text-base">{{this.title}}</h3>
                <p class="text-xs text-gray-500">Posted on {{formatDateTime this.createdAt}}</p>
              </div>
            </div>
            <span class="text-xs px-2 py-1 rounded-full shrink-0
              {{#if (eq this.type 'event')}}bg-blue-100 text-blue-700
              {{else if (eq this.type 'urgent')}}bg-red-100 text-red-700
              {{else if (eq this.type 'general')}}bg-green-100 text-green-700
              {{else}}bg-gray-100 text-gray-700{{/if}}">
              {{this.type}}
            </span>
          </div>

          <div class="bg-slate-50 rounded-lg p-4 mb-3">
            <p class="text-slate-700 text-sm leading-relaxed whitespace-pre-wrap">{{this.content}}</p>
          </div>

          {{#if this.eventDate}}
          <div class="flex items-center gap-2 text-sm text-gray-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span class="font-medium">Event Date:</span>
            <span>{{formatDate this.eventDate}}</span>
          </div>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="card text-center py-16">
        <div class="text-5xl mb-3">📢</div>
        <p class="text-gray-500">No announcements at this time.</p>
      </div>
      {{/if}}
    </div>
  </div>
</div>
</body></html>
