{{> head}}
<div class="flex h-screen overflow-hidden">
  {{> sidebar-student activePage="profile"}}

  <div class="flex-1 overflow-y-auto bg-slate-100">
    <div class="nav-top">
      <div>
        <h1 class="text-base font-bold text-slate-800">My Profile</h1>
        <p class="text-gray-600 text-xs">View and update your personal information</p>
      </div>
      <div class="flex items-center gap-3">
        {{#if user.profileImage}}
          <img src="{{user.profileImage}}" class="w-8 h-8 rounded-full object-cover border-2 border-green-500" alt="avatar">
        {{else}}
          <div class="w-8 h-8 rounded-full bg-green-700 flex items-center justify-center text-white text-sm font-bold">{{user.firstName.[0]}}</div>
        {{/if}}
        <span class="text-teal-700 text-sm font-medium">{{user.firstName}} {{user.lastName}}</span>
      </div>
    </div>

    <div class="px-6 py-5 max-w-3xl">
      {{> flash}}

      <form action="/student/profile" method="POST" enctype="multipart/form-data">

        <!-- Profile Photo Card -->
        <div class="card mb-5 flex items-center gap-6">
          <div class="relative shrink-0">
            {{#if profileUser.profileImage}}
              <img id="avatarPreview" src="{{profileUser.profileImage}}" alt="Profile Photo"
                   class="w-24 h-24 rounded-full object-cover border-4 border-green-200 shadow">
            {{else if profileUser.avatar}}
              <img id="avatarPreview" src="{{profileUser.avatar}}" alt="Profile Photo"
                   class="w-24 h-24 rounded-full object-cover border-4 border-green-200 shadow">
            {{else}}
              <div id="avatarPreview" class="w-24 h-24 rounded-full bg-green-700 flex items-center justify-center text-white text-3xl font-bold border-4 border-green-200 shadow">
                {{profileUser.firstName.[0]}}
              </div>
            {{/if}}
            <label for="profileImage"
                   class="absolute bottom-0 right-0 w-7 h-7 bg-green-600 rounded-full flex items-center justify-center cursor-pointer shadow hover:bg-green-700 transition-colors"
                   title="Change photo">
              <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </label>
            <input type="file" id="profileImage" name="profileImage" accept="image/*" class="hidden" onchange="previewAvatar(event)">
          </div>
          <div>
            <p class="text-slate-800 font-bold text-lg">{{profileUser.firstName}} {{profileUser.lastName}}</p>
            <p class="text-gray-500 text-sm">{{profileUser.email}}</p>
            <p class="text-teal-600 text-xs mt-1">Student — {{#if profileUser.course}}{{profileUser.course}}{{else}}No course set{{/if}}</p>
            <p class="text-gray-400 text-xs mt-0.5">Click the camera icon to change your photo (max 3MB)</p>
          </div>
        </div>

        <!-- Personal Info Card -->
        <div class="card mb-5">
          <h3 class="font-semibold text-teal-700 mb-4 text-sm">Personal Information</h3>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs text-gray-500 mb-1 font-medium">First Name</label>
              <input type="text" name="firstName" value="{{profileUser.firstName}}" required
                     class="input w-full" placeholder="First name">
            </div>
            <div>
              <label class="block text-xs text-gray-500 mb-1 font-medium">Last Name</label>
              <input type="text" name="lastName" value="{{profileUser.lastName}}" required
                     class="input w-full" placeholder="Last name">
            </div>
            <div>
              <label class="block text-xs text-gray-500 mb-1 font-medium">Contact Number</label>
              <input type="text" name="contactNo" value="{{profileUser.contactNo}}"
                     class="input w-full" placeholder="e.g. 09xx-xxx-xxxx">
            </div>
            <div>
              <label class="block text-xs text-gray-500 mb-1 font-medium">Student ID</label>
              <input type="text" name="studentId" value="{{profileUser.studentId}}"
                     class="input w-full" placeholder="e.g. 2021-XXXXX">
            </div>
            <div>
              <label class="block text-xs text-gray-500 mb-1 font-medium">Birthdate</label>
              <input type="date" name="birthdate" value="{{profileUser.birthdate}}"
                     class="input w-full">
            </div>
            <div>
              <label class="block text-xs text-gray-500 mb-1 font-medium">Emergency Contact</label>
              <input type="text" name="emergencyContact" value="{{profileUser.emergencyContact}}"
                     class="input w-full" placeholder="Emergency contact number">
            </div>
            <div class="col-span-2">
              <label class="block text-xs text-gray-500 mb-1 font-medium">Home Address</label>
              <textarea name="address" rows="2" class="input w-full resize-none"
                        placeholder="Complete home address">{{profileUser.address}}</textarea>
            </div>
          </div>
        </div>

        <!-- Guardian Info Card -->
        <div class="card mb-5">
          <h3 class="font-semibold text-teal-700 mb-4 text-sm">Guardian Information</h3>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs text-gray-500 mb-1 font-medium">Guardian Name</label>
              <input type="text" name="guardianName" value="{{profileUser.guardianName}}"
                     class="input w-full" placeholder="Parent or guardian name">
            </div>
            <div>
              <label class="block text-xs text-gray-500 mb-1 font-medium">Guardian Contact</label>
              <input type="text" name="guardianContact" value="{{profileUser.guardianContact}}"
                     class="input w-full" placeholder="Guardian contact number">
            </div>
          </div>
        </div>

        <!-- Academic Info Card -->
        <div class="card mb-5">
          <h3 class="font-semibold text-teal-700 mb-4 text-sm">Academic Information</h3>
          <div class="grid grid-cols-3 gap-4">
            <div class="col-span-1">
              <label class="block text-xs text-gray-500 mb-1 font-medium">Course / Program</label>
              <input type="text" name="course" value="{{profileUser.course}}"
                     class="input w-full" placeholder="e.g. BSIT">
            </div>
            <div>
              <label class="block text-xs text-gray-500 mb-1 font-medium">Year Level</label>
              <select name="yearLevel" class="input w-full">
                <option value="">— Select —</option>
                {{#each (list '1st Year' '2nd Year' '3rd Year' '4th Year' '5th Year' 'Graduate')}}
                <option value="{{this}}" {{#if (eq ../profileUser.yearLevel this)}}selected{{/if}}>{{this}}</option>
                {{/each}}
              </select>
            </div>
            <div>
              <label class="block text-xs text-gray-500 mb-1 font-medium">Section</label>
              <input type="text" name="section" value="{{profileUser.section}}"
                     class="input w-full" placeholder="e.g. A">
            </div>
            <div class="col-span-2">
              <label class="block text-xs text-gray-500 mb-1 font-medium">Previous School</label>
              <input type="text" name="previousSchool" value="{{profileUser.previousSchool}}"
                     class="input w-full" placeholder="Senior High or previous college">
            </div>
            <div>
              <label class="block text-xs text-gray-500 mb-1 font-medium">Scholarship</label>
              <input type="text" name="scholarshipInfo" value="{{profileUser.scholarshipInfo}}"
                     class="input w-full" placeholder="e.g. CHED, DOST">
            </div>
          </div>
        </div>

        <!-- Bio Card -->
        <div class="card mb-6">
          <h3 class="font-semibold text-teal-700 mb-4 text-sm">Short Bio / Notes</h3>
          <textarea name="bio" rows="3" class="input w-full resize-none"
                    placeholder="Optional — anything you'd like the guidance office to know about you.">{{profileUser.bio}}</textarea>
        </div>

        <!-- Email (read-only) -->
        <div class="card mb-6 bg-slate-50">
          <h3 class="font-semibold text-slate-500 mb-3 text-sm">Account</h3>
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-slate-200 flex items-center justify-center shrink-0">✉️</div>
            <div>
              <p class="text-xs text-gray-400">Email address (cannot be changed)</p>
              <p class="text-slate-700 text-sm font-medium">{{profileUser.email}}</p>
            </div>
          </div>
        </div>

        <button type="submit" class="btn-green">Save Changes</button>
      </form>
    </div>
  </div>
</div>

<script>
function previewAvatar(event) {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(e) {
    const preview = document.getElementById('avatarPreview');
    if (preview.tagName === 'IMG') {
      preview.src = e.target.result;
    } else {
      // replace the div initials placeholder with an img
      const img = document.createElement('img');
      img.id = 'avatarPreview';
      img.src = e.target.result;
      img.className = 'w-24 h-24 rounded-full object-cover border-4 border-green-200 shadow';
      img.alt = 'Profile Photo';
      preview.replaceWith(img);
    }
  };
  reader.readAsDataURL(file);
}
</script>
</body></html>
