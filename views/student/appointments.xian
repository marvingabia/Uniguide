{{> head}}
<div class="flex h-screen overflow-hidden">
  {{> sidebar-student activePage="appointments"}}
  <div class="flex-1 overflow-y-auto bg-slate-100">
    <div class="nav-top">
      <h1 class="text-base font-bold text-slate-800">📅 Request an Appointment</h1>
      <span class="text-teal-700 text-sm font-medium">{{user.firstName}} {{user.lastName}}</span>
    </div>
    <div class="max-w-2xl mx-auto px-5 py-6">
      {{> flash}}

      <!-- Automated Scheduling Info -->
      <div class="card mb-5" style="background:#0a1f0a;border-color:#166534">
        <p class="text-green-700 text-sm font-semibold mb-1">✨ Automated Scheduling</p>
        <p class="text-gray-400 text-xs leading-relaxed">
          Submit your appointment request with your preferred purpose. The Guidance Office will create available time slots and the system will automatically assign you a schedule. You'll receive a notification once your appointment is confirmed.
        </p>
        <p class="text-green-600 text-xs mt-2">
          💡 <strong>You can submit multiple requests</strong> for different purposes (e.g., Counseling + Good Moral Pickup). Each will be scheduled separately.
        </p>
      </div>

      <!-- Request Form -->
      <form action="/student/appointments" method="POST" class="card space-y-4">
        <div>
          <label class="label">Purpose of Appointment *</label>
          <select name="purpose" class="input" required onchange="toggleOtherField(this)">
            <option value="">Select purpose</option>
            <option value="Counseling">Counseling Session</option>
            <option value="Good Moral Pickup">Good Moral Certificate Pickup</option>
            <option value="Document Submission">Document Submission</option>
            <option value="Follow-up">Follow-up on Request</option>
            <option value="Academic Concern">Academic Concern</option>
            <option value="Personal Concern">Personal Concern</option>
            <option value="Other">Other (Please specify)</option>
          </select>
        </div>

        <div id="otherPurposeField" style="display:none;">
          <label class="label">Please specify purpose</label>
          <input type="text" name="otherPurpose" class="input" placeholder="Enter your purpose...">
        </div>
        
        <div>
          <label class="label">Additional Notes / Concerns</label>
          <textarea name="notes" class="input" rows="4" placeholder="Provide any additional information that will help us prepare for your appointment..."></textarea>
        </div>
        
        <button type="submit" class="btn-green w-full py-3">📋 Submit Appointment Request</button>
      </form>

      <!-- My Appointments -->
      {{#if myAppointments.length}}
      <div class="mt-6">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-slate-800 font-semibold text-sm">📋 My Appointment Requests</h3>
          <span class="text-gray-500 text-xs">{{myAppointments.length}} request(s)</span>
        </div>
        <div class="space-y-3">
          {{#each myAppointments}}
          <div class="card {{#if (eq status 'approved')}}border-green-600{{else if (eq status 'pending')}}border-yellow-500{{else if (eq status 'cancelled')}}border-red-500{{/if}}">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2 flex-wrap">
                  <span class="badge {{apptStatusClass status}}">{{status}}</span>
                  
                  <!-- Purpose Badge -->
                  <span class="px-2 py-1 rounded-full text-xs font-semibold
                    {{#if (eq purpose 'Counseling')}}bg-blue-100 text-blue-700
                    {{else if (eq purpose 'Good Moral Pickup')}}bg-green-100 text-green-700
                    {{else if (eq purpose 'Document Submission')}}bg-purple-100 text-purple-700
                    {{else}}bg-gray-100 text-gray-700{{/if}}">
                    {{purpose}}
                  </span>
                  
                  <span class="text-gray-400 text-xs">{{formatDateTime createdAt}}</span>
                </div>
                
                {{#if notes}}
                <p class="text-gray-600 text-xs mb-2"><strong>Notes:</strong> {{notes}}</p>
                {{/if}}
                
                {{#if (eq status 'approved')}}
                <div class="mt-2 p-3 rounded-lg bg-green-50 border border-green-200">
                  <p class="text-green-800 text-sm font-semibold">✅ Appointment Scheduled</p>
                  <p class="text-green-700 text-sm">📅 {{formatDate date}} at {{timeSlot}}</p>
                </div>
                {{else if (eq status 'pending')}}
                <div class="mt-2 p-3 rounded-lg bg-yellow-50 border border-yellow-200">
                  <p class="text-yellow-800 text-xs">⏳ Waiting for schedule assignment from Guidance Office</p>
                  <p class="text-yellow-700 text-xs mt-1">You can submit more requests for other purposes while waiting.</p>
                </div>
                {{else if (eq status 'done')}}
                <div class="mt-2 p-3 rounded-lg bg-gray-50 border border-gray-200">
                  <p class="text-gray-700 text-xs">✓ Completed on {{formatDate date}}</p>
                </div>
                {{else if (eq status 'cancelled')}}
                <div class="mt-2 p-3 rounded-lg bg-red-50 border border-red-200">
                  <p class="text-red-800 text-xs">❌ Cancelled{{#if cancelReason}}: {{cancelReason}}{{/if}}</p>
                </div>
                {{/if}}
              </div>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
      {{else}}
      <div class="mt-6 card text-center py-8">
        <div class="text-4xl mb-3">📅</div>
        <p class="text-gray-500 text-sm">No appointment requests yet.</p>
        <p class="text-gray-400 text-xs mt-1">Submit your first request using the form above.</p>
      </div>
      {{/if}}
    </div>
  </div>
</div>

<script>
function toggleOtherField(select) {
  const otherField = document.getElementById('otherPurposeField');
  if (select.value === 'Other') {
    otherField.style.display = 'block';
    otherField.querySelector('input').required = true;
  } else {
    otherField.style.display = 'none';
    otherField.querySelector('input').required = false;
  }
}
</script>
</body></html>
