<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clearance Form — UniGuide</title>
  <!-- html2pdf for download -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Times New Roman', Times, serif; background: #f1f5f9; color: #000; }

    /* ── Action bar (hidden on print/pdf) ── */
    .action-bar {
      max-width: 780px; margin: 0 auto; padding: 14px 16px;
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    }
    .btn-back  { color: #1b5e38; font-size: 13px; font-weight: 600; text-decoration: none; }
    .btn-dl    { background: #1b5e38; color: #fff; border: none; border-radius: 8px; padding: 9px 20px; font-size: 13px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px; }
    .btn-pay   { background: #2563eb; color: #fff; border-radius: 8px; padding: 9px 20px; font-size: 13px; font-weight: 700; text-decoration: none; display: flex; align-items: center; gap: 6px; }

    /* ── Print area ── */
    #pdf-content {
      background: #fff;
      max-width: 780px;
      margin: 0 auto 24px;
      padding: 28px 36px;
      border: 1px solid #ddd;
      font-family: 'Times New Roman', Times, serif;
      font-size: 11pt;
      line-height: 1.4;
    }

    /* ── MSU Header ── */
    .msu-header { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 4px; }
    .msu-logo   { width: 65px; height: 65px; object-fit: contain; flex-shrink: 0; }
    .msu-name   { flex: 1; }
    .msu-name h1 {
      font-family: 'Times New Roman', serif;
      font-size: 22pt; font-weight: 900;
      color: #1b5e38;   /* ← GREEN */
      margin-bottom: 1px; line-height: 1.1;
    }
    .msu-name p { font-size: 9pt; color: #444; }
    .msu-contact { font-size: 8.5pt; color: #444; text-align: right; min-width: 190px; line-height: 1.65; }

    .divider { border: none; border-top: 1.5px solid #1b5e38; margin: 8px 0; }

    .form-title {
      text-align: center;
      font-size: 12pt;
      font-weight: 700;
      font-family: 'Times New Roman', serif;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      border-top: 1.5px solid #000;
      border-bottom: 1.5px solid #000;
      padding: 5px 0;
      margin: 8px 0 12px;
    }

    /* ── Section titles ── */
    .sec { font-weight: 700; font-size: 11pt; margin: 10px 0 5px; font-family: 'Times New Roman', serif; }

    /* ── Info table ── */
    .info-tbl { width: 100%; border-collapse: collapse; font-size: 10.5pt; margin-bottom: 8px; }
    .info-tbl td { border: 1px solid #000; padding: 4px 8px; vertical-align: middle; }
    .info-tbl .lbl { width: 185px; color: #333; }
    .info-tbl .val { font-weight: 700; }

    /* ── Purpose ── */
    .purpose-row { display: flex; gap: 22px; flex-wrap: wrap; font-size: 10.5pt; margin: 3px 0 10px 4px; align-items: center; }
    .p-item { display: flex; align-items: center; gap: 4px; }
    .chk { width: 11px; height: 11px; border: 1px solid #000; display: inline-flex; align-items: center; justify-content: center; font-size: 9pt; flex-shrink: 0; }
    .chk.on { background: #000; color: #fff; }

    /* ── Verification table ── */
    .v-tbl { width: 100%; border-collapse: collapse; font-size: 9.5pt; margin: 6px 0; }
    .v-tbl th, .v-tbl td { border: 1px solid #000; padding: 5px 7px; vertical-align: top; }
    .v-tbl th { background: #f0f0f0; font-weight: 700; text-align: center; font-size: 9.5pt; }
    .v-tbl .c1 { width: 155px; }
    .v-tbl .c2 { width: 190px; }
    .v-tbl .c3 { width: 125px; }
    .v-tbl .c4 { width: 125px; }
    .v-tbl .c5 { width: 65px; }
    .v-tbl .blank { height: 38px; }

    /* ── Recommendation ── */
    .rec { font-size: 10.5pt; margin-top: 10px; }
    .rec-row { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
    .uline { border-bottom: 1px solid #000; min-width: 80px; display: inline-block; }

    /* ── Notes ── */
    .notes { font-size: 9.5pt; margin-top: 10px; border-top: 1px solid #bbb; padding-top: 8px; line-height: 1.65; }
    .notes ul { padding-left: 24px; }

    /* ── Form code ── */
    .fcode { text-align: right; font-size: 8.5pt; color: #888; margin-top: 6px; }

    /* ── Instructions card ── */
    .instructions {
      max-width: 780px; margin: 0 auto 24px;
      background: #fef9c3; border: 1px solid #fbbf24; border-radius: 10px;
      padding: 16px 20px; font-size: 13px; color: #78350f;
    }
    .instructions ol { padding-left: 20px; line-height: 2; margin-top: 8px; }

    @media print {
      .action-bar, .instructions { display: none !important; }
      body { background: #fff; }
      #pdf-content { border: none; margin: 0; padding: 20px; box-shadow: none; }
    }
  </style>
</head>
<body>

  <!-- ACTION BAR -->
  <div class="action-bar">
    <a href="/student/dashboard" class="btn-back">← Back to Home</a>
    <div style="flex:1"></div>
    <button class="btn-dl" onclick="downloadPDF()">⬇️ Download PDF</button>
    <a href="/student/application/{{app.id}}/payment" class="btn-pay">💳 Proceed to Payment</a>
  </div>

  <!-- FORM CONTENT -->
  <div id="pdf-content">

    <!-- MSU Header -->
    <div class="msu-header">
      <img src="/uploads/minsulogo.png" class="msu-logo" alt="MSU">
      <div class="msu-name">
        <h1>Mindoro State University</h1>
        <p>Victoria, Oriental Mindoro 5205 Philippines</p>
      </div>
      <div class="msu-contact">
        Email: universitypresident@minsu.edu.ph<br>
        Website: www.minsu.edu.ph<br>
        Mobile: +63 977 846 72 28
      </div>
    </div>

    <hr class="divider">

    <div class="form-title">Verification Checklist for Certificate of Good Moral Character</div>

    <!-- I. Student Information -->
    <div class="sec">I.&nbsp;&nbsp;Student Information</div>
    <table class="info-tbl">
      <tr>
        <td class="lbl">Name of Student/Client:</td>
        <td class="val" colspan="3">{{app.surname}}, {{app.givenName}}{{#if app.middleName}} {{app.middleName}}{{/if}}</td>
      </tr>
      <tr>
        <td class="lbl">Student Number (if necessary):</td>
        <td class="val" colspan="3">{{user.studentId}}</td>
      </tr>
      <tr>
        <td class="lbl">Program &amp; Year:</td>
        <td class="val" colspan="3">{{app.course}}{{#if app.yearLevel}} — {{app.yearLevel}}{{/if}}</td>
      </tr>
      <tr>
        <td class="lbl">Contact Number:</td>
        <td class="val">{{app.contactNumber}}</td>
        <td class="lbl" style="width:120px;">Date of Request:</td>
        <td class="val">{{dateToday}}</td>
      </tr>
    </table>

    <!-- II. Purpose of Request -->
    <div class="sec">II.&nbsp;&nbsp;Purpose of Request</div>
    <div class="purpose-row">
      <div class="p-item">
        <span class="chk {{#if (includes purposes 'Transfer')}}on{{/if}}">{{#if (includes purposes 'Transfer')}}✓{{/if}}</span>
        For Transfer
      </div>
      <div class="p-item">
        <span class="chk {{#if (includes purposes 'Employment')}}on{{/if}}">{{#if (includes purposes 'Employment')}}✓{{/if}}</span>
        For Employment
      </div>
      <div class="p-item">
        <span class="chk {{#if (includes purposes 'Scholarship')}}on{{/if}}">{{#if (includes purposes 'Scholarship')}}✓{{/if}}</span>
        For Scholarship
      </div>
      <div class="p-item">
        <span class="chk {{#if app.otherPurpose}}on{{else}}{{#if (or (includes purposes 'OJT') (includes purposes 'Board Examination') (includes purposes 'PNP/AFP Application') (includes purposes 'Passport Application'))}}on{{/if}}{{/if}}">✓</span>
        Others: <span style="border-bottom:1px solid #000;min-width:120px;padding:0 4px;display:inline-block;">
          {{app.otherPurpose}}{{#unless app.otherPurpose}}{{#if (includes purposes 'OJT')}}OJT{{/if}}{{#if (includes purposes 'Board Examination')}}Board Exam{{/if}}{{#if (includes purposes 'PNP/AFP Application')}}PNP/AFP{{/if}}{{#if (includes purposes 'Passport Application')}}Passport{{/if}}{{/unless}}
        </span>
      </div>
    </div>

    <!-- III. Verification Areas -->
    <div class="sec">III.&nbsp;&nbsp;Verification Areas</div>
    <table class="v-tbl">
      <thead>
        <tr>
          <th class="c1">Office/ Person Concerned</th>
          <th class="c2">Aspect to Verify</th>
          <th class="c3">Verified Remarks/<br>Findings</th>
          <th class="c4">Verified By<br>(Signature over Printed Name)</th>
          <th class="c5">Date</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="c1">Registrar's Office</td>
          <td class="c2">Academic performance (e.g., Passed/Failed subjects; remarks on academic record)</td>
          <td class="c3 blank"></td><td class="c4 blank"></td><td class="c5 blank"></td>
        </tr>
        <tr>
          <td class="c1">Subject Teacher</td>
          <td class="c2">Classroom attitude, punctuality, cooperation, and respectfulness</td>
          <td class="c3 blank"></td><td class="c4 blank"></td><td class="c5 blank"></td>
        </tr>
        <tr>
          <td class="c1">Dean/ Program Chair</td>
          <td class="c2">General behavior and academic conduct within the department</td>
          <td class="c3 blank"></td><td class="c4 blank"></td><td class="c5 blank"></td>
        </tr>
        <tr>
          <td class="c1">Director for Student Support &amp; Engagement</td>
          <td class="c2">University-level disciplinary record, including any major or minor offenses, sanctions, or pending disciplinary actions, in accordance with the Student Handbook</td>
          <td class="c3 blank"></td><td class="c4 blank"></td><td class="c5 blank"></td>
        </tr>
      </tbody>
    </table>

    <!-- IV. Recommendation -->
    <div class="sec">IV.&nbsp;&nbsp;Recommendation:</div>
    <div class="rec">
      <div class="rec-row"><span class="chk"></span> QUALIFIED for issuance of Certificate of Good Moral Character</div>
      <div class="rec-row"><span class="chk"></span> NOT QUALIFIED (State reason): <span class="uline" style="min-width:260px;"></span></div>
      <div style="margin-top:12px;">
        Verified and Checked by: <span class="uline" style="min-width:200px;"></span><br><br>
        Date: <span class="uline" style="min-width:140px;"></span>
        &nbsp;&nbsp;<em>(Guidance Counselor/ Staff)</em>
      </div>
    </div>

    <!-- V. Notes -->
    <div class="notes">
      <strong>V.&nbsp;&nbsp;Notes:</strong>
      <ul>
        <li>This checklist must be completed before the issuance of the Certificate of Good Moral Character.</li>
        <li>Any falsified or incomplete verification automatically invalidates the request.</li>
        <li>Attach the following supporting documents:
          <ul style="list-style:disc;padding-left:20px;">
            <li>Photocopy of the Student I.D. with signature</li>
            <li>Fully accomplished CGMC Request Form</li>
            <li>Official Receipt with DST</li>
          </ul>
        </li>
      </ul>
    </div>

    <div class="fcode">MSU-GUI-FR-02.02</div>

  </div>

  <!-- NEXT STEPS -->
  <div class="instructions">
    <strong>📋 Next Steps after downloading:</strong>
    <ol>
      <li><strong>Download/Print</strong> this form using the button above</li>
      <li>Have it verified and signed by all offices listed in the form</li>
      <li><strong>Proceed to the Cashier</strong> to pay <strong>₱{{app.totalAmount}}.00</strong> and get your Official Receipt</li>
      <li>Submit the completed form + Official Receipt to the <strong>Guidance Office</strong></li>
      <li>Claim your <strong>Good Moral Certificate</strong></li>
    </ol>
    <p style="margin-top:10px;font-size:12px;">— or if you prefer online payment, click <strong>Proceed to Payment</strong> above.</p>
  </div>

  <script>
  function downloadPDF() {
    const btn = document.querySelector('.btn-dl');
    const original = btn.innerHTML;
    btn.innerHTML = '⏳ Generating...';
    btn.disabled = true;

    const element = document.getElementById('pdf-content');
    const opt = {
      margin:       [8, 8, 8, 8],
      filename:     'MSU-Clearance-Form-{{app.surname}}-{{app.givenName}}.pdf',
      image:        { type: 'jpeg', quality: 0.98 },
      html2canvas:  { scale: 2, useCORS: true, logging: false },
      jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
    };

    html2pdf().set(opt).from(element).save().then(function() {
      btn.innerHTML = original;
      btn.disabled = false;
    });
  }
  </script>

</body>
</html>
