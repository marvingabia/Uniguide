{{> head}}
<div class="flex h-screen overflow-hidden">
  {{> sidebar-student activePage="dashboard"}}
  <div class="flex-1 overflow-y-auto bg-slate-100">
    <div class="nav-top">
      <div class="flex items-center gap-3">
        <a href="/student/dashboard" class="text-teal-700 text-sm font-medium">← Back</a>
        <h1 class="text-base font-bold text-slate-800">Application #{{app.id}}</h1>
      </div>
      <span class="text-teal-700 text-sm font-medium">{{user.firstName}} {{user.lastName}}</span>
    </div>

    <div class="max-w-3xl mx-auto px-5 py-5">
      {{> flash}}

      <!-- Status Banner -->
      <div class="card mb-4 flex items-center justify-between border-green-800">
        <div>
          <p class="text-gray-500 text-xs">Submitted {{formatDate app.createdAt}}</p>
          <h2 class="text-slate-800 font-bold text-lg">{{app.surname}}, {{app.givenName}} {{app.middleName}}</h2>
        </div>
        <span class="badge {{statusClass app.status}} text-sm px-4 py-1">{{statusLabel app.status}}</span>
      </div>

      <!-- Progress Steps -->
      <div class="card mb-4">
        <div class="flex items-center justify-between text-xs">
          <div class="flex flex-col items-center gap-1">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm step-done">1</div>
            <span class="text-gray-400">Submitted</span>
          </div>
          <div class="flex-1 h-0.5 bg-green-100 mx-2"></div>
          <div class="flex flex-col items-center gap-1">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm {{#if (ne app.status 'pending')}}step-done{{else}}step-pending{{/if}}">2</div>
            <span class="text-gray-400">Payment</span>
          </div>
          <div class="flex-1 h-0.5 bg-green-100 mx-2"></div>
          <div class="flex flex-col items-center gap-1">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm {{#if (or (eq app.status 'payment_verified') (eq app.status 'receipt_issued') (eq app.status 'approved') (eq app.status 'released'))}}step-done{{else}}step-pending{{/if}}">3</div>
            <span class="text-gray-400">Verified</span>
          </div>
          <div class="flex-1 h-0.5 bg-green-100 mx-2"></div>
          <div class="flex flex-col items-center gap-1">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm {{#if (or (eq app.status 'approved') (eq app.status 'released'))}}step-done{{else}}step-pending{{/if}}">4</div>
            <span class="text-gray-400">Approved</span>
          </div>
          <div class="flex-1 h-0.5 bg-green-100 mx-2"></div>
          <div class="flex flex-col items-center gap-1">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm {{#if (eq app.status 'released')}}step-done{{else}}step-pending{{/if}}">5</div>
            <span class="text-gray-400">Released</span>
          </div>
        </div>
      </div>

      {{#if (eq app.status 'rejected')}}
      <div class="card mb-4" style="background:#1f0505;border-color:#7f1d1d">
        <p class="text-red-300 font-semibold">❌ Application Rejected</p>
        {{#if app.remarks}}<p class="text-gray-300 text-sm mt-1">Reason: {{app.remarks}}</p>{{/if}}
      </div>
      {{/if}}

      <!-- Info -->
      <div class="card mb-4">
        <h3 class="text-green-700 font-semibold mb-3 text-xs uppercase tracking-wider">Your Information</h3>
        <div class="grid grid-cols-2 gap-4 text-sm">
          <div><span class="label">Course</span><span class="text-slate-700 font-semibold">{{app.course}}</span></div>
          <div><span class="label">Year Level</span><span class="text-slate-700 font-semibold">{{app.yearLevel}}</span></div>
          <div><span class="label">Enrollment</span><span class="text-slate-700 font-semibold">{{app.enrollmentStatus}}</span></div>
          <div><span class="label">Contact</span><span class="text-slate-700 font-semibold">{{app.contactNumber}}</span></div>
        </div>
        <div class="mt-3">
          <span class="label">Purpose/s</span>
          <div class="flex flex-wrap gap-2 mt-1">
            {{#each purposes}}<span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-xs font-semibold">{{this}}</span>{{/each}}
          </div>
        </div>
        
        <!-- Documents Requested -->
        <div class="mt-4">
          <span class="label">Documents Requested</span>
          <div class="bg-gray-50 rounded-lg p-3 mt-2 space-y-1 text-sm border border-gray-200">
            {{#if (gt app.qtyGoodMoral 0)}}
            <div class="flex justify-between">
              <span class="text-slate-700">Good Moral Certificate</span>
              <span class="text-green-700 font-semibold">{{app.qtyGoodMoral}} copies</span>
            </div>
            {{/if}}
            {{#if (gt app.qtyCTC 0)}}
            <div class="flex justify-between">
              <span class="text-slate-700">CTC / Authentication</span>
              <span class="text-green-700 font-semibold">{{app.qtyCTC}} copies</span>
            </div>
            {{/if}}
          </div>
        </div>
      </div>

      <!-- Payment Info -->
      {{#if (ne app.status 'pending')}}
      <div class="card mb-4">
        <h3 class="text-green-700 font-semibold mb-3 text-xs uppercase tracking-wider">Payment Details</h3>
        <div class="grid grid-cols-2 gap-4 text-sm">
          <div><span class="label">Method</span><span class="text-slate-700 font-semibold">{{app.paymentMethod}}</span></div>
          <div><span class="label">Reference No.</span><span class="text-slate-700 font-mono font-bold">{{app.referenceNumber}}</span></div>
          <div><span class="label">Payment Date</span><span class="text-slate-700 font-semibold">{{formatDate app.paymentDate}}</span></div>
          {{#if app.orNumber}}<div><span class="label">OR Number</span><span class="text-slate-700 font-mono font-bold">{{app.orNumber}}</span></div>{{/if}}
          {{#if app.totalAmount}}<div><span class="label">Total Amount</span><span class="text-green-700 font-bold text-base">{{currency app.totalAmount}}</span></div>{{/if}}
        </div>
        {{#if app.paymentScreenshot}}
        <div class="mt-3">
          <span class="label">Payment Screenshot</span>
          <a href="{{app.paymentScreenshot}}" target="_blank">
            <img src="{{app.paymentScreenshot}}" class="mt-2 max-h-44 rounded-lg border border-green-800">
          </a>
        </div>
        {{/if}}
        {{#if app.receiptFile}}
        <div class="mt-3">
          <a href="{{app.receiptFile}}" target="_blank" class="text-green-700 hover:underline text-sm">📄 View Official Receipt</a>
        </div>
        {{/if}}
      </div>
      {{/if}}

      <!-- Released Notice -->
      {{#if (eq app.status 'released')}}
      <div class="card text-center py-8" style="background:#0a1f0a;border-color:#166534">
        <div class="text-5xl mb-3">🎓</div>
        <p class="text-green-700 font-bold text-xl">Your certificate is ready!</p>
        <p class="text-gray-400 text-sm mt-2">Released on {{formatDate app.releasedAt}} by {{app.releasedBy}}</p>
        <p class="text-yellow-600 text-sm mt-2 font-semibold">Please proceed to the Guidance Office to claim your Good Moral Certificate. Bring your Official Receipt.</p>
      </div>
      {{/if}}

      <!-- Pay button -->
      {{#if (eq app.status 'pending')}}
      <a href="/student/application/{{app.id}}/payment" class="btn-green w-full py-3 text-base text-center block">
        💳 Proceed to Payment →
      </a>
      {{/if}}
    </div>
  </div>
</div>
</body></html>
