<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow Counselor</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">

  <!-- Navbar -->
  <nav class="bg-white border-b border-gray-200 shadow-sm p-4 sticky top-0 z-30">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <a href="/counselor/dashboard" class="text-gray-500 hover:text-emerald-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </a>
        <h1 class="text-xl font-bold text-emerald-600">🏃 Fitness Videos</h1>
      </div>
      <div class="flex items-center space-x-3">
        <span class="text-gray-700 text-sm">{{user.name}}</span>
        <a href="/logout" class="text-gray-500 hover:text-gray-700 text-sm">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6">

    <!-- Header -->
    <div class="bg-gradient-to-r from-emerald-500 to-teal-500 text-white rounded-xl p-6 mb-6">
      <h2 class="text-2xl font-bold mb-1">Fitness & Exercise Videos</h2>
      <p class="text-emerald-100 text-sm">Upload exercise videos for your students to follow</p>
    </div>

    <!-- Alerts -->
    <div id="alertBox" class="hidden mb-4"></div>
    {{#if error_msg}}
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">❌ {{error_msg}}</div>
    {{/if}}
    {{#if success_msg}}
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 text-sm">✅ {{success_msg}}</div>
    {{/if}}

    <!-- Upload Form -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
      <h3 class="text-lg font-bold text-gray-800 mb-4">📤 Upload New Video</h3>

      <form id="uploadForm" action="/counselor/fitness/upload" method="POST" enctype="multipart/form-data" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Video Title *</label>
            <input type="text" name="title" id="titleInput" required placeholder="e.g. Morning Stretching Routine"
                   class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-emerald-400">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Category *</label>
            <select name="category" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-emerald-400">
              <option value="stretching">🧘 Stretching</option>
              <option value="breathing">💨 Breathing</option>
              <option value="yoga">🧘‍♀️ Yoga</option>
              <option value="cardio">🏃 Cardio</option>
              <option value="meditation">🧠 Meditation</option>
              <option value="other">✨ Other</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <textarea name="description" rows="2" placeholder="Brief description of the exercise..."
                    class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-emerald-400 resize-none"></textarea>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Video File * (MP4, MOV, AVI — max 500MB / ~5 min)</label>
          <div class="border-2 border-dashed border-emerald-300 rounded-xl p-6 text-center bg-emerald-50">
            <div class="text-4xl mb-2">🎬</div>
            <p class="text-sm text-gray-500 mb-3">Select a video file from your device</p>
            <!-- Simple visible file input — no hidden, no JS intercept -->
            <input type="file" name="videoFile" id="videoFile"
                   class="block w-full text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-emerald-600 file:text-white hover:file:bg-emerald-700 cursor-pointer"
                   onchange="updateFileLabel(this)">
            <p id="fileLabel" class="text-xs text-gray-400 mt-2">MP4, MOV, AVI, WMV — max 500MB (up to ~5 minutes)</p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <button type="submit" id="uploadBtn"
                  class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2"
                  onclick="this.textContent='Uploading... please wait'; this.disabled=true; this.form.submit();">
            📤 Upload Video
          </button>
          <span class="text-xs text-gray-400">Videos will be visible to all students immediately</span>
        </div>
      </form>
    </div>

    <!-- Video List -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <div class="flex justify-between items-center mb-5">
        <h3 class="text-lg font-bold text-gray-800">🎬 Your Videos <span class="text-emerald-600">({{videos.length}})</span></h3>
      </div>

      {{#if videos.length}}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {{#each videos}}
        <div class="border border-gray-200 rounded-xl overflow-hidden hover:shadow-lg transition group">
          <!-- Video thumbnail with play overlay -->
          <div class="relative bg-black aspect-video cursor-pointer"
               onclick="playVideo('{{this.filePath}}', '{{this.title}}')">
            <video class="w-full h-full object-contain opacity-90" preload="metadata" muted playsinline>
              <source src="{{this.filePath}}" type="video/mp4">
            </video>
            <!-- Play button overlay -->
            <div class="absolute inset-0 flex items-center justify-center bg-black bg-opacity-20 group-hover:bg-opacity-40 transition">
              <div class="w-14 h-14 bg-white bg-opacity-95 rounded-full flex items-center justify-center shadow-xl group-hover:scale-110 transition">
                <svg class="w-6 h-6 text-emerald-600 ml-1" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
                </svg>
              </div>
            </div>
            <!-- Category badge -->
            <span class="absolute top-2 left-2 text-xs bg-emerald-600 text-white px-2 py-1 rounded-full capitalize font-medium">
              {{this.category}}
            </span>
          </div>

          <!-- Info -->
          <div class="p-4">
            <h4 class="font-bold text-gray-800 mb-1 truncate">{{this.title}}</h4>
            {{#if this.description}}
            <p class="text-xs text-gray-500 mb-3 line-clamp-2">{{this.description}}</p>
            {{/if}}
            <div class="flex items-center justify-between">
              <span class="text-xs text-gray-400">👁️ {{this.views}} views</span>
              <form action="/counselor/fitness/delete/{{this.id}}" method="POST"
                    onsubmit="return confirm('Delete this video?')">
                <button type="submit"
                        class="text-xs bg-red-50 text-red-500 hover:bg-red-100 px-3 py-1 rounded-lg transition">
                  🗑️ Delete
                </button>
              </form>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="text-center py-16 text-gray-400">
        <div class="text-7xl mb-4">🎬</div>
        <p class="text-xl font-medium text-gray-500">No videos uploaded yet</p>
        <p class="text-sm mt-1">Upload your first exercise video using the form above</p>
      </div>
      {{/if}}
    </div>
  </div>

  <!-- Video Player Modal -->
  <div id="videoModal" class="hidden fixed inset-0 bg-black bg-opacity-90 z-50 flex items-center justify-center p-4">
    <div class="bg-gray-900 rounded-2xl overflow-hidden w-full max-w-4xl shadow-2xl">
      <div class="flex justify-between items-center px-5 py-3 border-b border-gray-700">
        <span id="videoModalTitle" class="text-white font-semibold text-sm"></span>
        <button onclick="closeVideoModal()"
                class="text-gray-400 hover:text-white text-2xl leading-none transition">✕</button>
      </div>
      <video id="modalVideo" controls autoplay class="w-full max-h-[75vh] bg-black">
        <source id="modalVideoSrc" src="" type="video/mp4">
        Your browser does not support the video tag.
      </video>
    </div>
  </div>

  <script>
    // Show query-string error if any
    const urlParams = new URLSearchParams(window.location.search);
    const urlError = urlParams.get('error');
    if (urlError) {
      const box = document.getElementById('alertBox');
      box.innerHTML = `<div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">❌ ${urlError}</div>`;
      box.classList.remove('hidden');
    }

    function updateFileLabel(input) {
      const label = document.getElementById('fileLabel');
      if (input.files && input.files[0]) {
        const file = input.files[0];
        const size = (file.size / 1024 / 1024).toFixed(1);
        label.textContent = `✅ Selected: ${file.name} (${size} MB)`;
        label.classList.add('text-emerald-600', 'font-medium');
      }
    }

    function playVideo(filePath, title) {
      const src = document.getElementById('modalVideoSrc');
      const video = document.getElementById('modalVideo');
      src.src = filePath;
      video.load();
      video.play().catch(() => {});
      document.getElementById('videoModalTitle').textContent = title;
      document.getElementById('videoModal').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeVideoModal() {
      const video = document.getElementById('modalVideo');
      video.pause();
      video.currentTime = 0;
      document.getElementById('modalVideoSrc').src = '';
      document.getElementById('videoModal').classList.add('hidden');
      document.body.style.overflow = '';
    }

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeVideoModal();
    });
  </script>
</body>
</html>
