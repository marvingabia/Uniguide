<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow Counselor</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <nav class="bg-white border-b border-gray-200 shadow-sm p-4">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <h1 class="text-2xl font-bold text-emerald-600">🌱 Tellngrow Counselor</h1>
      </div>
      <div class="space-x-4 flex items-center">
        <a href="/counselor/profile" class="flex items-center space-x-2 hover:text-emerald-600 transition">
          <div class="w-8 h-8 rounded-full overflow-hidden border-2 border-emerald-200 bg-white flex items-center justify-center flex-shrink-0">
            {{#if user.profilePicture}}
              {{#if (eq (substring user.profilePicture 0 1) "/")}}
                <img src="{{user.profilePicture}}" alt="Profile" class="w-full h-full object-cover" />
              {{else}}
                <span class="text-xl">{{user.profilePicture}}</span>
              {{/if}}
            {{else}}
              <span class="text-xl text-gray-400">👨‍💼</span>
            {{/if}}
          </div>
          <span class="text-gray-700">{{user.name}}</span>
        </a>
        <a href="/logout" class="text-gray-600 hover:text-gray-800 font-medium">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6">
    <!-- Welcome Section -->
    <div class="bg-gradient-to-r from-emerald-500 to-teal-500 text-white rounded-lg p-6 mb-6">
      <h2 class="text-3xl font-bold mb-2">Welcome, {{user.name}}!</h2>
      <p class="text-emerald-100">Manage reading materials for your students</p>
    </div>

    <!-- Statistics -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-white border-2 border-gray-200 rounded-lg p-4">
        <div class="text-3xl mb-2">📚</div>
        <div class="text-2xl font-bold text-gray-900">{{stats.totalMaterials}}</div>
        <div class="text-sm text-gray-600">Total Materials</div>
      </div>

      <div class="bg-white border-2 border-gray-200 rounded-lg p-4">
        <div class="text-3xl mb-2">✅</div>
        <div class="text-2xl font-bold text-gray-900">{{stats.publishedMaterials}}</div>
        <div class="text-sm text-gray-600">Published</div>
      </div>

      <div class="bg-white border-2 border-gray-200 rounded-lg p-4">
        <div class="text-3xl mb-2">👁️</div>
        <div class="text-2xl font-bold text-gray-900">{{stats.totalViews}}</div>
        <div class="text-sm text-gray-600">Total Views</div>
      </div>

      <div class="bg-white border-2 border-gray-200 rounded-lg p-4">
        <div class="text-3xl mb-2">👥</div>
        <div class="text-2xl font-bold text-gray-900">{{stats.totalReaders}}</div>
        <div class="text-sm text-gray-600">Active Readers</div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white border-2 border-gray-200 rounded-lg p-6 mb-6">
      <h3 class="text-xl font-bold text-gray-900 mb-4">Quick Actions</h3>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <a href="/counselor/materials/new" class="bg-emerald-600 text-white p-4 rounded-lg hover:bg-emerald-700 transition text-center">
          <div class="text-3xl mb-2">➕</div>
          <div class="font-semibold text-sm">Add Material</div>
        </a>
        <a href="/counselor/materials" class="bg-teal-600 text-white p-4 rounded-lg hover:bg-teal-700 transition text-center">
          <div class="text-3xl mb-2">📋</div>
          <div class="font-semibold text-sm">Manage Materials</div>
        </a>
        <a href="/counselor/analytics" class="bg-cyan-600 text-white p-4 rounded-lg hover:bg-cyan-700 transition text-center">
          <div class="text-3xl mb-2">📊</div>
          <div class="font-semibold text-sm">View Analytics</div>
        </a>
        <a href="/counselor/messages" class="bg-indigo-600 text-white p-4 rounded-lg hover:bg-indigo-700 transition text-center relative">
          <div class="text-3xl mb-2">💬</div>
          <div class="font-semibold text-sm">Messages</div>
          {{#if stats.unreadMessages}}
          <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">{{stats.unreadMessages}}</span>
          {{/if}}
        </a>
        <a href="/counselor/fitness" class="bg-orange-500 text-white p-4 rounded-lg hover:bg-orange-600 transition text-center">
          <div class="text-3xl mb-2">🏃</div>
          <div class="font-semibold text-sm">Fitness Videos</div>
        </a>
      </div>
    </div>

    <!-- Recent Materials -->
    <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
      <h3 class="text-xl font-bold text-gray-900 mb-4">📚 Your Recent Materials</h3>
      <div class="space-y-3">
        {{#each materials}}
        <div class="border-2 border-gray-100 rounded-lg p-4 hover:border-emerald-300 transition">
          <div class="flex justify-between items-start">
            <div class="flex-1">
              <h4 class="font-bold text-gray-900 text-lg">{{this.title}}</h4>
              <p class="text-sm text-gray-600 mt-1">{{this.excerpt}}</p>
              <div class="flex gap-3 mt-2 text-xs text-gray-500">
                <span>📁 {{this.category}}</span>
                <span>👁️ {{this.views}} views</span>
                <span>⏱️ {{this.readingTime}} min read</span>
                <span>📅 {{formatDate this.createdAt}}</span>
              </div>
            </div>
            <div class="flex flex-col gap-2 ml-4">
              {{#if this.isPublished}}
              <span class="text-xs bg-green-100 text-green-800 px-2 py-1 rounded">Published</span>
              {{else}}
              <span class="text-xs bg-gray-100 text-gray-800 px-2 py-1 rounded">Draft</span>
              {{/if}}
              <button onclick="viewMaterial({{this.id}}, '{{this.fileType}}', '{{this.slug}}', '{{this.title}}')" class="text-xs bg-purple-600 text-white px-3 py-1 rounded hover:bg-purple-700 text-center">
                👁️ View
              </button>
              <a href="/counselor/materials/edit/{{this.id}}" class="text-xs bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700 text-center">
                ✏️ Edit
              </a>
            </div>
          </div>
        </div>
        {{else}}
        <div class="text-center text-gray-500 py-8">
          <div class="text-5xl mb-3">📚</div>
          <p>No materials yet. Create your first reading material!</p>
          <a href="/counselor/materials/new" class="inline-block mt-4 bg-emerald-600 text-white px-6 py-2 rounded-lg hover:bg-emerald-700">
            Create Material
          </a>
        </div>
        {{/each}}
      </div>
    </div>
  </div>

  <!-- Material Viewer Modal -->
  <div id="viewerModal" class="hidden fixed inset-0 bg-black bg-opacity-75 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg w-full h-full max-w-6xl max-h-[90vh] flex flex-col">
      <!-- Modal Header -->
      <div class="flex justify-between items-center p-4 border-b border-gray-200">
        <h3 id="modalTitle" class="text-xl font-bold text-gray-900">Preview Material</h3>
        <button onclick="closeViewer()" class="text-gray-500 hover:text-gray-700 text-2xl font-bold">
          ✕
        </button>
      </div>
      
      <!-- Modal Content -->
      <div class="flex-1 overflow-hidden">
        <iframe id="viewerFrame" class="w-full h-full border-0"></iframe>
      </div>
    </div>
  </div>

  <script>
    function viewMaterial(id, fileType, slug, title) {
      const modal = document.getElementById('viewerModal');
      const frame = document.getElementById('viewerFrame');
      const modalTitle = document.getElementById('modalTitle');
      
      modalTitle.textContent = title;
      
      if (fileType === 'article') {
        frame.src = '/reading/' + slug;
      } else {
        frame.src = '/reading/view/' + id;
      }
      
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    
    function closeViewer() {
      const modal = document.getElementById('viewerModal');
      const frame = document.getElementById('viewerFrame');
      
      modal.classList.add('hidden');
      frame.src = '';
      document.body.style.overflow = 'auto';
    }
    
    // Close modal on ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeViewer();
      }
    });
  </script>
</body>
</html>
