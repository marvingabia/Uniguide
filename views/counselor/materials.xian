<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow Counselor</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <nav class="bg-white border-b border-gray-200 shadow-sm p-4">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <a href="/counselor/dashboard" class="text-2xl font-bold text-emerald-600 hover:text-emerald-700">🌱 Tellngrow Counselor</a>
      </div>
      <div class="space-x-4 flex items-center">
        <a href="/counselor/dashboard" class="text-gray-600 hover:text-gray-800">Dashboard</a>
        <a href="/counselor/profile" class="flex items-center space-x-2 hover:text-emerald-600 transition">
          <div class="w-8 h-8 rounded-full overflow-hidden border-2 border-emerald-200 bg-white flex items-center justify-center flex-shrink-0">
            {{#if user.profilePicture}}
              {{#if (eq (substring user.profilePicture 0 1) "/")}}
                <img src="{{user.profilePicture}}" alt="Profile" class="w-full h-full object-cover" />
              {{else}}
                <span class="text-xl">{{user.profilePicture}}</span>
              {{/if}}
            {{else}}
              <span class="text-xl text-gray-400">👨‍💼</span>
            {{/if}}
          </div>
          <span class="text-gray-700">{{user.name}}</span>
        </a>
        <a href="/logout" class="text-gray-600 hover:text-gray-800 font-medium">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6">
    <div class="mb-6 flex justify-between items-center">
      <div>
        <h2 class="text-3xl font-bold text-gray-900">Manage Materials</h2>
        <p class="text-gray-600 mt-1">View and edit your reading materials</p>
      </div>
      <a href="/counselor/materials/new" class="bg-emerald-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-emerald-700 transition">
        ➕ Add New Material
      </a>
    </div>

    <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
      {{#if materials.length}}
      <div class="space-y-4">
        {{#each materials}}
        <div class="border-2 border-gray-100 rounded-lg p-4 hover:border-emerald-300 transition">
          <div class="flex justify-between items-start">
            <div class="flex-1">
              <h3 class="font-bold text-gray-900 text-lg">{{this.title}}</h3>
              <p class="text-sm text-gray-600 mt-1">{{this.excerpt}}</p>
              <div class="flex gap-3 mt-2 text-xs text-gray-500">
                <span>📁 {{this.category}}</span>
                <span>👁️ {{this.views}} views</span>
                <span>⏱️ {{this.readingTime}} min read</span>
                <span>📅 {{formatDate this.createdAt}}</span>
              </div>
            </div>
            <div class="flex flex-col gap-2 ml-4">
              {{#if this.isPublished}}
              <span class="text-xs bg-green-100 text-green-800 px-3 py-1 rounded font-semibold">✅ Published</span>
              {{else}}
              <span class="text-xs bg-gray-100 text-gray-800 px-3 py-1 rounded font-semibold">📝 Draft</span>
              {{/if}}
              <button onclick="viewMaterial({{this.id}}, '{{this.fileType}}', '{{this.slug}}', '{{this.title}}')" 
                      class="text-xs bg-purple-600 text-white px-3 py-1 rounded hover:bg-purple-700 text-center font-semibold">
                👁️ View
              </button>
              <a href="/counselor/materials/edit/{{this.id}}" 
                 class="text-xs bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700 text-center font-semibold">
                ✏️ Edit
              </a>
              {{#unless this.isPublished}}
              <button onclick="publishMaterial({{this.id}})" 
                      class="text-xs bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700 font-semibold">
                ✅ Publish
              </button>
              {{/unless}}
              <button onclick="deleteMaterial({{this.id}})" 
                      class="text-xs bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700 font-semibold">
                🗑️ Delete
              </button>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="text-center text-gray-500 py-12">
        <div class="text-6xl mb-4">📚</div>
        <h3 class="text-xl font-bold text-gray-700 mb-2">No Materials Yet</h3>
        <p class="text-gray-600 mb-6">Create your first reading material to get started</p>
        <a href="/counselor/materials/new" class="inline-block bg-emerald-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-emerald-700 transition">
          Create Material
        </a>
      </div>
      {{/if}}
    </div>
  </div>

  <!-- Material Viewer Modal -->
  <div id="viewerModal" class="hidden fixed inset-0 bg-black bg-opacity-75 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg w-full h-full max-w-6xl max-h-[90vh] flex flex-col">
      <!-- Modal Header -->
      <div class="flex justify-between items-center p-4 border-b border-gray-200">
        <h3 id="modalTitle" class="text-xl font-bold text-gray-900">Preview Material</h3>
        <button onclick="closeViewer()" class="text-gray-500 hover:text-gray-700 text-2xl font-bold">
          ✕
        </button>
      </div>
      
      <!-- Modal Content -->
      <div class="flex-1 overflow-hidden">
        <iframe id="viewerFrame" class="w-full h-full border-0"></iframe>
      </div>
    </div>
  </div>

  <script>
    function viewMaterial(id, fileType, slug, title) {
      const modal = document.getElementById('viewerModal');
      const frame = document.getElementById('viewerFrame');
      const modalTitle = document.getElementById('modalTitle');
      
      modalTitle.textContent = title;
      
      if (fileType === 'article') {
        frame.src = '/reading/' + slug;
      } else {
        frame.src = '/reading/view/' + id;
      }
      
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    
    function closeViewer() {
      const modal = document.getElementById('viewerModal');
      const frame = document.getElementById('viewerFrame');
      
      modal.classList.add('hidden');
      frame.src = '';
      document.body.style.overflow = 'auto';
    }
    
    // Close modal on ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeViewer();
      }
    });

    async function publishMaterial(id) {
      if (!confirm('Publish this material? Users will be able to see it.')) {
        return;
      }
      
      try {
        const response = await fetch(`/counselor/materials/publish/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        
        if (response.ok) {
          alert('✅ Material published successfully!');
          location.reload();
        } else {
          alert('❌ Error publishing material');
        }
      } catch (error) {
        console.error('Publish error:', error);
        alert('❌ Failed to publish material');
      }
    }

    async function deleteMaterial(id) {
      if (!confirm('Are you sure you want to delete this material? This action cannot be undone.')) {
        return;
      }
      
      try {
        const response = await fetch(`/counselor/materials/delete/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        
        if (response.ok) {
          alert('✅ Material deleted successfully!');
          location.reload();
        } else {
          alert('❌ Error deleting material');
        }
      } catch (error) {
        console.error('Delete error:', error);
        alert('❌ Failed to delete material');
      }
    }
  </script>
</body>
</html>
