<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow Counselor</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .chat-bubble-sent {
      background: linear-gradient(135deg, #10b981, #059669);
      border-radius: 18px 18px 4px 18px;
    }
    .chat-bubble-received {
      background: #f3f4f6;
      border-radius: 18px 18px 18px 4px;
    }
    #chatMessages {
      scroll-behavior: smooth;
    }
    .user-card.active {
      background: #ecfdf5;
      border-color: #10b981;
    }
    .unread-dot {
      width: 10px; height: 10px;
      background: #10b981;
      border-radius: 50%;
      flex-shrink: 0;
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">

  <!-- Navbar -->
  <nav class="bg-white border-b border-gray-200 shadow-sm p-4 sticky top-0 z-30">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <a href="/counselor/dashboard" class="text-gray-500 hover:text-emerald-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </a>
        <h1 class="text-xl font-bold text-emerald-600">💬 Messages</h1>
      </div>
      <div class="flex items-center space-x-3">
        <span class="text-gray-700 text-sm">{{user.name}}</span>
        <a href="/logout" class="text-gray-500 hover:text-gray-700 text-sm">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-4 h-[calc(100vh-72px)] flex gap-4">

    <!-- Left: Contact List -->
    <div class="w-80 flex-shrink-0 bg-white rounded-xl shadow-sm border border-gray-200 flex flex-col">
      <div class="p-4 border-b border-gray-100">
        <h2 class="font-bold text-gray-800 mb-3">Contacts</h2>
        <input type="text" id="searchStudents" placeholder="Search..."
               oninput="filterStudents(this.value)"
               class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-emerald-400">
      </div>
      <div id="studentList" class="flex-1 overflow-y-auto p-2 space-y-1">

        <!-- Admins section -->
        {{#if admins.length}}
        <div class="px-2 pt-2 pb-1">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Admin</span>
        </div>
        {{#each admins}}
        <div class="user-card border-2 border-transparent rounded-xl p-3 cursor-pointer hover:bg-purple-50 transition"
             data-userid="{{this.id}}"
             data-name="{{this.name}}"
             onclick="openChat({{this.id}}, '{{this.name}}', 'Admin')">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center text-white font-bold flex-shrink-0">
              {{substring this.name 0 1}}
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-gray-800 text-sm truncate">{{this.name}}</div>
              <div class="text-xs text-purple-500 font-medium">Admin</div>
            </div>
            {{#if this.unreadCount}}
            <div class="unread-dot"></div>
            {{/if}}
          </div>
        </div>
        {{/each}}
        <div class="border-t border-gray-100 my-2"></div>
        {{/if}}

        <!-- Students section -->
        <div class="px-2 pt-1 pb-1">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Students</span>
        </div>
        {{#each students}}
        <div class="user-card border-2 border-transparent rounded-xl p-3 cursor-pointer hover:bg-emerald-50 transition"
             data-userid="{{this.id}}"
             data-name="{{this.name}}"
             onclick="openChat({{this.id}}, '{{this.name}}', 'Student')">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white font-bold flex-shrink-0">
              {{substring this.name 0 1}}
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-gray-800 text-sm truncate">{{this.name}}</div>
              <div class="text-xs text-gray-500 truncate">{{this.email}}</div>
            </div>
            {{#if this.unreadCount}}
            <div class="unread-dot"></div>
            {{/if}}
          </div>
        </div>
        {{else}}
        <div class="text-center text-gray-400 py-8 text-sm">No students yet</div>
        {{/each}}
      </div>
    </div>

    <!-- Right: Chat Area -->
    <div class="flex-1 bg-white rounded-xl shadow-sm border border-gray-200 flex flex-col">

      <!-- Chat Header -->
      <div id="chatHeader" class="p-4 border-b border-gray-100 flex items-center space-x-3">
        <div id="chatAvatar" class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center text-gray-400 font-bold hidden">
        </div>
        <div>
          <div id="chatName" class="font-bold text-gray-800">Select a student to start chatting</div>
          <div id="chatStatus" class="text-xs text-gray-400"></div>
        </div>
      </div>

      <!-- Messages -->
      <div id="chatMessages" class="flex-1 overflow-y-auto p-4 space-y-3">
        <div id="emptyState" class="flex flex-col items-center justify-center h-full text-gray-400">
          <div class="text-6xl mb-4">💬</div>
          <p class="text-lg font-medium">No conversation selected</p>
          <p class="text-sm">Choose a student from the list to start messaging</p>
        </div>
      </div>

      <!-- Message Input -->
      <div id="messageInputArea" class="p-4 border-t border-gray-100 hidden">
        <div class="flex items-end space-x-3">
          <textarea id="messageInput"
                    placeholder="Type your message..."
                    rows="1"
                    onkeydown="handleEnter(event)"
                    oninput="autoResize(this)"
                    class="flex-1 px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-emerald-400 resize-none max-h-32"></textarea>
          <button onclick="sendMessage()"
                  class="bg-emerald-600 hover:bg-emerald-700 text-white p-3 rounded-xl transition flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentUserId = null;
    let currentUserName = '';
    let pollInterval = null;

    async function openChat(userId, userName, role) {
      currentUserId = userId;
      currentUserName = userName;

      document.getElementById('chatName').textContent = userName;
      document.getElementById('chatStatus').textContent = role || 'Student';
      const avatar = document.getElementById('chatAvatar');
      avatar.textContent = userName.charAt(0).toUpperCase();
      avatar.classList.remove('hidden');
      document.getElementById('messageInputArea').classList.remove('hidden');
      document.getElementById('emptyState').classList.add('hidden');

      // Highlight active student
      document.querySelectorAll('.user-card').forEach(c => c.classList.remove('active'));
      const card = document.querySelector(`[data-userid="${userId}"]`);
      if (card) card.classList.add('active');

      // Load messages
      await loadMessages();

      // Poll for new messages every 3 seconds
      if (pollInterval) clearInterval(pollInterval);
      pollInterval = setInterval(loadMessages, 3000);
    }

    async function loadMessages() {
      if (!currentUserId) return;
      try {
        const res = await fetch(`/counselor/messages/${currentUserId}/json`);
        const messages = await res.json();
        renderMessages(messages);
      } catch (e) {
        console.error('Load messages error:', e);
      }
    }

    function renderMessages(messages) {
      const container = document.getElementById('chatMessages');
      if (!messages.length) {
        container.innerHTML = `
          <div class="flex flex-col items-center justify-center h-full text-gray-400">
            <div class="text-5xl mb-3">👋</div>
            <p class="text-sm">No messages yet. Say hello!</p>
          </div>`;
        return;
      }

      const counselorId = {{user.id}};
      container.innerHTML = messages.map(msg => {
        const isSent = msg.senderId === counselorId;
        const time = new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        return `
          <div class="flex ${isSent ? 'justify-end' : 'justify-start'}">
            <div class="max-w-xs lg:max-w-md">
              <div class="${isSent ? 'chat-bubble-sent text-white' : 'chat-bubble-received text-gray-800'} px-4 py-2 text-sm">
                ${escapeHtml(msg.content)}
              </div>
              <div class="text-xs text-gray-400 mt-1 ${isSent ? 'text-right' : 'text-left'}">${time}</div>
            </div>
          </div>`;
      }).join('');

      container.scrollTop = container.scrollHeight;
    }

    async function sendMessage() {
      const input = document.getElementById('messageInput');
      const content = input.value.trim();
      if (!content || !currentUserId) return;

      input.value = '';
      input.style.height = 'auto';

      try {
        await fetch(`/counselor/messages/${currentUserId}/send`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content })
        });
        await loadMessages();
      } catch (e) {
        console.error('Send error:', e);
      }
    }

    function handleEnter(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    }

    function autoResize(el) {
      el.style.height = 'auto';
      el.style.height = Math.min(el.scrollHeight, 128) + 'px';
    }

    function filterStudents(query) {
      const q = query.toLowerCase();
      document.querySelectorAll('.user-card').forEach(card => {
        const name = card.dataset.name.toLowerCase();
        card.style.display = name.includes(q) ? '' : 'none';
      });
    }

    function escapeHtml(str) {
      return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
  </script>
</body>
</html>
