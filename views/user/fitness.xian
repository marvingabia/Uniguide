<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">

  <!-- Navbar -->
  <nav class="bg-white border-b border-gray-200 shadow-sm p-4 sticky top-0 z-30">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <a href="/user/dashboard" class="text-gray-500 hover:text-purple-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </a>
        <h1 class="text-xl font-bold text-purple-600">🏃 Fitness & Exercise</h1>
      </div>
      <div class="flex items-center space-x-3">
        <span class="text-gray-700 text-sm">{{user.name}}</span>
        <a href="/logout" class="text-gray-500 hover:text-gray-700 text-sm">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6">

    <!-- Header -->
    <div class="bg-gradient-to-r from-purple-500 to-indigo-500 text-white rounded-xl p-6 mb-6">
      <h2 class="text-2xl font-bold mb-1">Exercise Videos from Your Counselors</h2>
      <p class="text-purple-100 text-sm">Follow these exercises to improve your mental and physical wellness</p>
    </div>

    <!-- Category Filter -->
    <div class="flex flex-wrap gap-2 mb-6">
      <button onclick="filterCategory('all')" id="filter-all"
              class="category-btn px-4 py-2 rounded-full text-sm font-medium bg-purple-600 text-white transition">
        All
      </button>
      <button onclick="filterCategory('stretching')" id="filter-stretching"
              class="category-btn px-4 py-2 rounded-full text-sm font-medium bg-white text-gray-600 border border-gray-200 hover:border-purple-400 transition">
        🧘 Stretching
      </button>
      <button onclick="filterCategory('breathing')" id="filter-breathing"
              class="category-btn px-4 py-2 rounded-full text-sm font-medium bg-white text-gray-600 border border-gray-200 hover:border-purple-400 transition">
        💨 Breathing
      </button>
      <button onclick="filterCategory('yoga')" id="filter-yoga"
              class="category-btn px-4 py-2 rounded-full text-sm font-medium bg-white text-gray-600 border border-gray-200 hover:border-purple-400 transition">
        🧘‍♀️ Yoga
      </button>
      <button onclick="filterCategory('cardio')" id="filter-cardio"
              class="category-btn px-4 py-2 rounded-full text-sm font-medium bg-white text-gray-600 border border-gray-200 hover:border-purple-400 transition">
        🏃 Cardio
      </button>
      <button onclick="filterCategory('meditation')" id="filter-meditation"
              class="category-btn px-4 py-2 rounded-full text-sm font-medium bg-white text-gray-600 border border-gray-200 hover:border-purple-400 transition">
        🧠 Meditation
      </button>
    </div>

    <!-- Videos Grid -->
    {{#if videos.length}}
    <div id="videosGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {{#each videos}}
      <div class="video-card bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition"
           data-category="{{this.category}}">
        <!-- Thumbnail / Video -->
        <div class="bg-gray-900 aspect-video relative cursor-pointer"
             onclick="playVideo('{{this.filePath}}', '{{this.title}}', {{this.id}})">
          <video class="w-full h-full object-cover opacity-80" preload="metadata" muted>
            <source src="{{this.filePath}}" type="video/mp4">
          </video>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-14 h-14 bg-white bg-opacity-90 rounded-full flex items-center justify-center shadow-lg hover:scale-110 transition">
              <svg class="w-6 h-6 text-purple-600 ml-1" fill="currentColor" viewBox="0 0 20 20">
                <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
              </svg>
            </div>
          </div>
          <span class="absolute top-2 right-2 text-xs bg-black bg-opacity-60 text-white px-2 py-1 rounded-full capitalize">
            {{this.category}}
          </span>
        </div>
        <!-- Info -->
        <div class="p-4">
          <h4 class="font-bold text-gray-800 mb-1">{{this.title}}</h4>
          {{#if this.description}}
          <p class="text-sm text-gray-500 mb-2 line-clamp-2">{{this.description}}</p>
          {{/if}}
          <div class="flex items-center justify-between text-xs text-gray-400">
            <span>👨‍💼 {{this.counselor.name}}</span>
            <span>👁️ {{this.views}} views</span>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="text-center py-16 text-gray-400">
      <div class="text-7xl mb-4">🏃</div>
      <p class="text-xl font-medium">No fitness videos yet</p>
      <p class="text-sm mt-2">Your counselors haven't uploaded any exercise videos yet</p>
    </div>
    {{/if}}
  </div>

  <!-- Video Player Modal -->
  <div id="videoModal" class="hidden fixed inset-0 bg-black bg-opacity-90 z-50 flex items-center justify-center p-4">
    <div class="bg-black rounded-xl overflow-hidden w-full max-w-4xl">
      <div class="flex justify-between items-center p-3 bg-gray-900">
        <span id="videoModalTitle" class="text-white font-semibold"></span>
        <button onclick="closeVideoModal()" class="text-gray-400 hover:text-white text-xl">✕</button>
      </div>
      <video id="modalVideo" controls class="w-full max-h-[75vh]">
        <source id="modalVideoSrc" src="" type="video/mp4">
      </video>
    </div>
  </div>

  <script>
    function playVideo(path, title, videoId) {
      document.getElementById('modalVideoSrc').src = path;
      document.getElementById('modalVideo').load();
      document.getElementById('videoModalTitle').textContent = title;
      document.getElementById('videoModal').classList.remove('hidden');
      // Track view
      fetch(`/user/fitness/${videoId}/view`, { method: 'POST' }).catch(() => {});
    }

    function closeVideoModal() {
      const video = document.getElementById('modalVideo');
      video.pause();
      video.src = '';
      document.getElementById('videoModal').classList.add('hidden');
    }

    function filterCategory(cat) {
      // Update button styles
      document.querySelectorAll('.category-btn').forEach(btn => {
        btn.classList.remove('bg-purple-600', 'text-white');
        btn.classList.add('bg-white', 'text-gray-600', 'border', 'border-gray-200');
      });
      const active = document.getElementById(`filter-${cat}`);
      if (active) {
        active.classList.add('bg-purple-600', 'text-white');
        active.classList.remove('bg-white', 'text-gray-600', 'border', 'border-gray-200');
      }

      // Filter cards
      document.querySelectorAll('.video-card').forEach(card => {
        card.style.display = (cat === 'all' || card.dataset.category === cat) ? '' : 'none';
      });
    }

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeVideoModal();
    });
  </script>
</body>
</html>
