<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tellngrow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .sidebar {
      transform: translateX(-100%);
      transition: transform 0.3s ease-in-out;
    }
    .sidebar.open {
      transform: translateX(0);
    }
    .overlay {
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease-in-out;
    }
    .overlay.show {
      opacity: 1;
      pointer-events: auto;
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <!-- Overlay -->
  <div id="overlay" class="overlay fixed inset-0 bg-black bg-opacity-50 z-40" onclick="closeSidebar()"></div>

  <!-- Sidebar -->
  <div id="sidebar" class="sidebar fixed left-0 top-0 h-full w-64 bg-white shadow-2xl z-50">
    <div class="p-6">
      <!-- Close Button -->
      <button onclick="closeSidebar()" class="absolute top-4 right-4 text-gray-500 hover:text-gray-700">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Logo -->
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-purple-600">🌱 Tellngrow</h2>
        <p class="text-sm text-gray-500">Mental Wellness</p>
      </div>

      <!-- Menu Items -->
      <nav class="space-y-2">
        <a href="/user/dashboard" class="flex items-center space-x-3 p-3 rounded-lg bg-purple-50 text-purple-600 font-medium">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          <span>Dashboard</span>
        </a>

        <a href="/user/profile" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-purple-50 text-gray-700 hover:text-purple-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <span>My Profile</span>
        </a>

        <a href="/games" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-purple-50 text-gray-700 hover:text-purple-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Games</span>
        </a>

        <a href="/journal" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-purple-50 text-gray-700 hover:text-purple-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          <span>Journal</span>
        </a>

        <div class="border-t border-gray-200 my-4"></div>

        <a href="/logout" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-red-50 text-red-600 hover:text-red-700 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          <span>Logout</span>
        </a>
      </nav>
    </div>
  </div>

  <!-- Top Navigation -->
  <nav class="bg-white shadow-md p-4 border-b border-gray-200">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <!-- Hamburger Menu Button -->
        <button onclick="openSidebar()" class="text-gray-700 hover:text-gray-900 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <h1 class="text-2xl font-bold text-gray-900">🌱 Tellngrow</h1>
      </div>
      <div class="text-gray-700">
        <a href="/user/profile" class="flex items-center space-x-2 hover:text-gray-900">
          <div class="w-8 h-8 rounded-full overflow-hidden border-2 border-purple-200 bg-white flex items-center justify-center flex-shrink-0">
            {{#if user.profilePicture}}
              {{#if (eq (substring user.profilePicture 0 1) "/")}}
                <img src="{{user.profilePicture}}" alt="Profile" class="w-full h-full object-cover" />
              {{else}}
                <span class="text-xl">{{user.profilePicture}}</span>
              {{/if}}
            {{else}}
              <span class="text-xl text-gray-400">👤</span>
            {{/if}}
          </div>
          <span class="hidden md:inline">{{user.name}}</span>
        </a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-6">
    <!-- Welcome Section -->
    <div class="mb-8">
      <h2 class="text-3xl font-bold text-gray-800">Welcome back, {{user.name}}! 👋</h2>
      <p class="text-gray-600">Explore our reading materials for mental wellness</p>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <div class="bg-white border-2 border-gray-200 rounded-lg p-4 hover:shadow-md transition">
        <div class="text-3xl mb-2">🎮</div>
        <div class="text-xl font-bold text-gray-900">{{progress.totalPoints}}</div>
        <div class="text-xs text-gray-600">Total Points</div>
      </div>

      <div class="bg-white border-2 border-gray-200 rounded-lg p-4 hover:shadow-md transition">
        <div class="text-3xl mb-2">📊</div>
        <div class="text-xl font-bold text-gray-900">{{progress.level}}</div>
        <div class="text-xs text-gray-600">Current Level</div>
      </div>

      <div class="bg-white border-2 border-gray-200 rounded-lg p-4 hover:shadow-md transition">
        <div class="text-3xl mb-2">🔥</div>
        <div class="text-xl font-bold text-gray-900">{{progress.currentStreak}}</div>
        <div class="text-xs text-gray-600">Day Streak</div>
      </div>

      <div class="bg-white border-2 border-gray-200 rounded-lg p-4 hover:shadow-md transition">
        <div class="text-3xl mb-2">✨</div>
        <div class="text-xl font-bold text-gray-900">{{todayActivities}}</div>
        <div class="text-xs text-gray-600">Today's Activities</div>
      </div>
    </div>

    <!-- Reading Materials Section -->
    <div class="mb-6">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-2xl font-bold text-gray-900">📚 Reading Materials</h3>
      </div>
    </div>

    <!-- Quick Access Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
      <!-- Message Counselor -->
      <a href="/user/messages" class="bg-gradient-to-br from-indigo-500 to-purple-600 text-white rounded-xl p-6 hover:shadow-lg transition hover:scale-[1.02] flex items-center space-x-4">
        <div class="text-5xl">💬</div>
        <div>
          <h3 class="text-xl font-bold">Message Counselor</h3>
          <p class="text-indigo-100 text-sm mt-1">Send a message or share your concerns</p>
        </div>
      </a>
      <!-- Fitness Videos -->
      <a href="/user/fitness" class="bg-gradient-to-br from-orange-400 to-pink-500 text-white rounded-xl p-6 hover:shadow-lg transition hover:scale-[1.02] flex items-center space-x-4">
        <div class="text-5xl">🏃</div>
        <div>
          <h3 class="text-xl font-bold">Fitness & Exercise</h3>
          <p class="text-orange-100 text-sm mt-1">Watch exercise videos from your counselors</p>
        </div>
      </a>
    </div>

    <!-- Clean Library Card -->
    <div class="max-w-2xl mx-auto">
      <div class="bg-gradient-to-br from-purple-500 to-blue-500 rounded-2xl shadow-2xl overflow-hidden">
        <div class="p-12 text-center text-white">
          <!-- Book Icon -->
          <div class="mb-6">
            <span class="text-8xl">📚</span>
          </div>
          
          <!-- Title -->
          <h2 class="text-3xl font-bold mb-4">Mental Health Library</h2>
          <p class="text-lg mb-8 opacity-90">
            Access reading materials uploaded by counselors.<br>
            Choose from our collection of mental health resources.
          </p>
          
          <!-- Stats -->
          <div class="flex justify-center gap-8 mb-8">
            <div class="text-center">
              <div class="text-3xl font-bold">{{materials.length}}</div>
              <div class="text-sm opacity-75">Available Books</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold">📕 📘</div>
              <div class="text-sm opacity-75">PDF & DOCX</div>
            </div>
          </div>
          
          <!-- View Library Button -->
          <a href="/reading/library" 
             class="inline-block bg-white text-purple-600 px-8 py-4 rounded-xl font-bold text-lg hover:bg-gray-100 transition shadow-lg transform hover:scale-105">
            📖 Open Library
          </a>
        </div>
      </div>
      
      <!-- Info Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-8">
        <div class="bg-white rounded-lg shadow p-4 text-center">
          <div class="text-3xl mb-2">📕</div>
          <div class="font-semibold text-gray-800">PDF Documents</div>
          <div class="text-sm text-gray-600">Read in browser</div>
        </div>
        <div class="bg-white rounded-lg shadow p-4 text-center">
          <div class="text-3xl mb-2">📘</div>
          <div class="font-semibold text-gray-800">DOCX Files</div>
          <div class="text-sm text-gray-600">Online viewer</div>
        </div>
        <div class="bg-white rounded-lg shadow p-4 text-center">
          <div class="text-3xl mb-2">🔒</div>
          <div class="font-semibold text-gray-800">Read Only</div>
          <div class="text-sm text-gray-600">No downloads</div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function openSidebar() {
      document.getElementById('sidebar').classList.add('open');
      document.getElementById('overlay').classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      document.getElementById('sidebar').classList.remove('open');
      document.getElementById('overlay').classList.remove('show');
      document.body.style.overflow = 'auto';
    }

    // Close sidebar on ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeSidebar();
      }
    });
  </script>
</body>
</html>
